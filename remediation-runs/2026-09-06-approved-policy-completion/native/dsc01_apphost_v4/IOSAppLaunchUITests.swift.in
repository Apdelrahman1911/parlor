import XCTest

final class IOSAppLaunchUITests: XCTestCase {
    override func setUpWithError() throws { continueAfterFailure = false }

    @MainActor
    func testDSC01ActualSettingsLocalSessionsAndOSInvestigation() throws {
        let app = XCUIApplication()
        let token = UUID().uuidString
        let simulator = try XCTUnwrap(ProcessInfo.processInfo.environment["SIMULATOR_UDID"])
        app.launchArguments = [] // Never pin AppleLanguages/AppleLocale in argument domain.
        app.launchEnvironment = ["PARLOR_DSC01_RUN_TOKEN": token, "PARLOR_DSC01_EXPECTED_UDID": simulator,
                                 "PARLOR_DSC01_SCENARIO": "settings"]
        defer { app.terminate() }

        try launch(app, fixture: "fresh")
        let initial = try observe(app)
        let fallback = try string(try dictionary(initial, "now"), "preferredLanguage")
        XCTAssertEqual(try string(try dictionary(initial, "now"), "setting"), "system")
        XCTAssertEqual(try dictionary(initial, "now")["hasAppOverride"] as? Bool, false)
        let currentLanguage = fallback

        // Both supported explicit choices use actual Compose Settings actions.
        // Each restart must independently show the marker BEFORE original App.
        for explicit in ["ar"] {
            try openSettings(app, language: currentLanguage)
            try tap(app, label: explicit == "ar" ? "العربية" : "English")
            try assertSettingsStrings(app, language: explicit)
            let installed = try observeEventually(app) { snapshot in
                let value = try self.dictionary(snapshot, "now")
                return value["setting"] as? String == explicit && value["ownerInstalled"] as? String == explicit
            }
            try assertOwned(installed, explicit: explicit, previous: [])
            let priorBoot = try string(installed, "boot")
            app.terminate()
            XCTAssertTrue(app.wait(for: .notRunning, timeout: 15))
            try launch(app, fixture: "continue")
            let resumed = try observe(app)
            XCTAssertNotEqual(try string(resumed, "boot"), priorBoot, "Must be a new process, not remount")
            let beforeMain = try dictionary(resumed, "beforeMain")
            XCTAssertEqual(beforeMain["setting"] as? String, explicit)
            XCTAssertEqual(beforeMain["ownerInstalled"] as? String, explicit,
                           "Harness validity: persistent owner must survive termination BEFORE App initializes")
            XCTAssertEqual(beforeMain["ownerPresent"] as? Bool, true)
            XCTAssertEqual(beforeMain["appLanguages"] as? [String], [explicit])
            try assertOwned(resumed, explicit: explicit, previous: [])
            try openSettings(app, language: explicit)
            try tap(app, label: explicit == "ar" ? "لغة النظام" : "System language")
            try assertSettingsStrings(app, language: fallback)
            let system = try observeEventually(app) { snapshot in
                let value = try self.dictionary(snapshot, "now")
                return value["setting"] as? String == "system" && value["ownerPresent"] as? Bool == false
            }
            try assertSystem(system, expected: fallback, previous: [])
        }

        // This represents an OS-managed previous per-app value synthetically;
        // it is NOT execution of the actual iOS Settings application.
        app.terminate(); XCTAssertTrue(app.wait(for: .notRunning, timeout: 15))
        try launch(app, fixture: "previous-ar")
        let previous = try observe(app)
        try assertSystem(previous, expected: "ar", previous: ["ar-EG", "en"])
        try openSettings(app, language: "ar")
        try tap(app, label: "English")
        try assertSettingsStrings(app, language: "en")
        let english = try observeEventually(app) { snapshot in
            try self.dictionary(snapshot, "now")["ownerInstalled"] as? String == "en"
        }
        try assertOwned(english, explicit: "en", previous: ["ar-EG", "en"])
        let beforeRestart = try string(english, "boot")
        app.terminate(); XCTAssertTrue(app.wait(for: .notRunning, timeout: 15))
        try launch(app, fixture: "continue")
        let finalRestart = try observe(app)
        XCTAssertNotEqual(try string(finalRestart, "boot"), beforeRestart)
        let recovered = try dictionary(finalRestart, "beforeMain")
        XCTAssertEqual(recovered["ownerPresent"] as? Bool, true)
        XCTAssertEqual(recovered["ownerInstalled"] as? String, "en")
        XCTAssertEqual(recovered["ownerPrevious"] as? [String], ["ar-EG", "en"])
        try openSettings(app, language: "en")
        try tap(app, label: "System language")
        try assertSettingsStrings(app, language: "ar")
        let restored = try observeEventually(app) { snapshot in
            let value = try self.dictionary(snapshot, "now")
            return value["setting"] as? String == "system" && value["ownerPresent"] as? Bool == false
        }
        try assertSystem(restored, expected: "ar", previous: ["ar-EG", "en"])
        app.buttons["parlor-dsc01-complete"].tap()
        let complete = try observe(app)
        XCTAssertEqual(complete["completed"] as? Bool, true)

        // No app route exposes Settings during an active game. The following
        // two scenarios honestly use a synthetic invocation of the actual Koin
        // SettingsStore, while all game entry/setup interactions remain real UI.
        try verifyActualLocalGame(app, game: "whodunit")
        try verifyActualLocalGame(app, game: "mafia")
        try investigateActualOSPerAppLanguage(app)
    }

    @MainActor private func startScenario(_ app: XCUIApplication, name: String) throws {
        app.terminate()
        XCTAssertTrue(app.wait(for: .notRunning, timeout: 15))
        app.launchEnvironment["PARLOR_DSC01_SCENARIO"] = name
        try launch(app, fixture: "existing")
        let snapshot = try observe(app)
        XCTAssertEqual(snapshot["scenario"] as? String, name)
    }

    @MainActor private func syntheticLanguage(_ app: XCUIApplication, language: String) throws -> [String: Any] {
        let before = try observe(app)
        let ordinal = try XCTUnwrap(try dictionary(before, "composition")["commandOrdinal"] as? Int)
        app.buttons["parlor-dsc01-synthetic-" + language].tap()
        return try observeEventually(app) { snapshot in
            let composition = try self.dictionary(snapshot, "composition")
            return composition["commandOrdinal"] as? Int == ordinal + 1 &&
                   composition["commandLanguage"] as? String == language &&
                   composition["commandStatus"] as? String == "applied" &&
                   self.optionalDictionary(snapshot, "now")["setting"] as? String == language
        }
    }

    @MainActor private func verifyActualLocalGame(_ app: XCUIApplication, game: String) throws {
        XCTAssertTrue(["whodunit", "mafia"].contains(game))
        try startScenario(app, name: game)
        let originalSystem = try dictionary(try observe(app), "now")
        XCTAssertEqual(originalSystem["setting"] as? String, "system")
        XCTAssertEqual(originalSystem["ownerPresent"] as? Bool, false)
        let systemLanguage = try string(originalSystem, "preferredLanguage")
        let systemPreferences = try XCTUnwrap(originalSystem["appLanguages"] as? [String])
        _ = try syntheticLanguage(app, language: "en")
        try tapPublicSetupPrefix(app, prefix: game == "whodunit"
            ? "Open Whodunit and pick how you want to play." : "Open the Mafia game.")
        try tapPublicSetupPrefix(app, prefix: "Start a pass-and-play session on this device.")
        if game == "whodunit" {
            try tapPublicSetupPrefix(app, prefix: "Continue with ")
            try tapPublicSetupPrefix(app, prefix: "Choose Classic Vote mode and proceed to player setup.")
            try tap(app, label: "6")
        } else {
            try tapPublicSetupPrefix(app, prefix: "Set up a 5-player game")
        }
        try enterActualPlayerNames(app, count: game == "whodunit" ? 6 : 5)
        try tapPublicSetupPrefix(app, prefix: game == "whodunit"
            ? "Confirm player names and continue to the case intro." : "Continue to settings")
        if game == "mafia" {
            try tapPublicSetupPrefix(app, prefix: "Start the Mafia game with these settings")
        }
        let phase = game == "whodunit" ? "public-intro" : "role-assignment"
        _ = try observeEventually(app) { snapshot in
            let value = try self.dictionary(snapshot, "composition")
            return value["surface"] as? String == game + "-local" &&
                   value["publicPhase"] as? String == phase &&
                   value["gameDirection"] as? String == "ltr"
        }
        // Capture the actual PartyAwareSession controller, actual canonical
        // StateFlow and current committed object; never regenerate a config.
        app.buttons["parlor-dsc01-capture"].tap()
        let checkpoint = try observe(app)
        try assertContinuity(checkpoint, game: game, phase: phase, language: "en")
        let boot = try string(checkpoint, "boot")
        for language in ["ar", "en", "system"] {
            _ = try syntheticLanguage(app, language: language)
            let expectedLanguage = language == "system" ? systemLanguage : language
            let ready = try observeEventually(app) { snapshot in
                let resolved = try self.string(try self.dictionary(snapshot, "now"), "preferredLanguage")
                let composition = try self.dictionary(snapshot, "composition")
                return resolved == expectedLanguage &&
                    composition["gameDirection"] as? String ==
                    (expectedLanguage == "ar" ? "rtl" : "ltr")
            }
            if language == "system" {
                try assertSystem(ready, expected: systemLanguage, previous: systemPreferences)
            } else {
                try assertOwned(ready, explicit: language, previous: systemPreferences)
            }
            try assertContinuity(ready, game: game, phase: phase, language: expectedLanguage)
            XCTAssertEqual(try string(ready, "boot"), boot)

            let before = try dictionary(ready, "composition")
            let backgrounds = try XCTUnwrap(before["backgroundSinceCapture"] as? Int)
            let foregrounds = try XCTUnwrap(before["foregroundSinceCapture"] as? Int)
            // Actual system Home/activate calls: original Swift scenePhase
            // forwarding invokes original AppLifecycleCoordinator unchanged.
            XCUIDevice.shared.press(.home)
            XCTAssertTrue(app.wait(for: .runningBackground, timeout: 15))
            app.activate()
            XCTAssertTrue(app.wait(for: .runningForeground, timeout: 15))
            let resumed = try observeEventually(app) { snapshot in
                let value = try self.dictionary(snapshot, "composition")
                return (value["backgroundSinceCapture"] as? Int ?? -1) > backgrounds &&
                       (value["foregroundSinceCapture"] as? Int ?? -1) > foregrounds
            }
            XCTAssertEqual(try string(resumed, "boot"), boot, "Process recreation is not retained-session proof")
            try assertContinuity(resumed, game: game, phase: phase, language: expectedLanguage)
            if language == "system" {
                try assertSystem(resumed, expected: systemLanguage, previous: systemPreferences)
            } else {
                try assertOwned(resumed, explicit: language, previous: systemPreferences)
            }
        }
        app.buttons["parlor-dsc01-complete"].tap()
        XCTAssertEqual(try observe(app)["completed"] as? Bool, true)
    }

    private func assertContinuity(_ snapshot: [String: Any], game: String, phase: String, language: String) throws {
        let value = try dictionary(snapshot, "composition")
        XCTAssertEqual(value["surface"] as? String, game + "-local")
        XCTAssertEqual(value["publicPhase"] as? String, phase)
        XCTAssertEqual(value["gameDirection"] as? String, language == "ar" ? "rtl" : "ltr")
        XCTAssertEqual(value["disposalsSinceCapture"] as? Int, 0)
        for property in ["checkpointCaptured", "sameController", "sameCanonicalFlow",
                         "sameCanonicalReference", "sameCanonicalValue", "samePublicPhase"] {
            XCTAssertEqual(value[property] as? Bool, true, "Actual retained-session invariant: " + property)
        }
        XCTAssertEqual(snapshot["nativeDirection"] as? String, language == "ar" ? "force_rtl" : "force_ltr")
    }

    @MainActor private func enterActualPlayerNames(_ app: XCUIApplication, count: Int) throws {
        XCTAssertTrue([5, 6].contains(count))
        for index in 1...count {
            // Only a copy-only testTag is added to the original OutlinedTextField.
            // Its original sanitizer/IME/focus/callback/state are unchanged.
            let query = app.descendants(matching: .any).matching(identifier: "dsc01-player-\(index)")
            XCTAssertTrue(query.firstMatch.waitForExistence(timeout: 10))
            XCTAssertLessThan(query.count, 8)
            let actual = query.firstMatch
            let visible = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
                actual.exists && actual.isHittable
            }, object: nil)
            XCTAssertEqual(XCTWaiter.wait(for: [visible], timeout: 10), .completed)
            if index == 1 { actual.tap() }
            // After the initial tap, use the real existing IME Next flow rather
            // than a swipe followed by a possibly still-moving tap target.
            // typeText on this exact field requires its keyboard focus; never
            // type into the app generically or use a private focus predicate.
            actual.typeText("Audit Player \(index)")
            let inserted = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
                actual.value as? String == "Audit Player \(index)"
            }, object: nil)
            XCTAssertEqual(XCTWaiter.wait(for: [inserted], timeout: 10), .completed,
                           "The exact requested synthetic field must receive its exact name once")
            // Pinned CMP 1.10.3 treats a standalone newline as the configured
            // ImeAction. Original Next moves focus; original final Done clears
            // focus and hides the keyboard. No callback/backing-state bypass.
            actual.typeText("\n")
        }
        let hidden = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
            !app.keyboards.firstMatch.exists
        }, object: nil)
        XCTAssertEqual(XCTWaiter.wait(for: [hidden], timeout: 10), .completed,
                       "Original final Done must dismiss the real keyboard")
    }

    @MainActor private func tapPublicSetupPrefix(_ app: XCUIApplication, prefix: String) throws {
        // Prefixes are exact, source-whitelisted content descriptions from
        // PUBLIC setup only; CMP merges descriptions with visible descendants.
        // No broad hierarchy export, arbitrary text read, private phase, fallback
        // target or callback invocation is used to advance the actual app.
        let allowed = ["Open Whodunit and pick how you want to play.", "Open the Mafia game.",
            "Start a pass-and-play session on this device.", "Continue with ",
            "Choose Classic Vote mode and proceed to player setup.", "Set up a 5-player game",
            "Confirm player names and continue to the case intro.", "Continue to settings",
            "Start the Mafia game with these settings"]
        XCTAssertTrue(allowed.contains(prefix))
        let query = app.descendants(matching: .any).matching(NSPredicate(format: "label BEGINSWITH %@", prefix))
        _ = query.firstMatch.waitForExistence(timeout: 15)
        for _ in 0..<14 {
            XCTAssertLessThan(query.count, 16)
            if let target = query.allElementsBoundByIndex.first(where: { $0.isHittable }) {
                target.tap(); return
            }
            app.swipeUp(velocity: .slow)
        }
        XCTFail("Source-whitelisted actual setup control not reachable: " + prefix)
        throw NSError(domain: "DSC01PublicSetupSelector", code: 1)
    }

    @MainActor private func investigateActualOSPerAppLanguage(_ app: XCUIApplication) throws {
        try startScenario(app, name: "os")
        _ = try syntheticLanguage(app, language: "system")
        app.buttons["parlor-dsc01-open-os"].tap()
        let settings = XCUIApplication(bundleIdentifier: "com.apple.Preferences")
        defer { settings.terminate() }
        XCTAssertTrue(settings.wait(for: .runningForeground, timeout: 20),
                      "Supported UIApplication.openSettingsURLString must open actual Settings")
        // Actual shipped plist declares en/ar. A fresh OS may not expose the
        // language row until it has multiple preferred languages configured.
        // Do not rewrite global AppleLanguages or invent unsupported URLs.
        let languageRow = settings.descendants(matching: .any)
            .matching(NSPredicate(format: "label == %@", "Language"))
        if !languageRow.firstMatch.waitForExistence(timeout: 15) {
            recordOSSelectorDiagnostics(settings)
            app.activate(); XCTAssertTrue(app.wait(for: .runningForeground, timeout: 20))
            app.buttons["parlor-dsc01-os-no-row"].tap()
            app.buttons["parlor-dsc01-complete"].tap()
            XCTAssertEqual(try observe(app)["osDisposition"] as? String, "language-control-unavailable")
            return // Explicit BLOCKED gate, never marked OS-language PASS by the runner.
        }
        XCTAssertLessThan(languageRow.count, 16)
        try XCTUnwrap(languageRow.allElementsBoundByIndex.first(where: { $0.isHittable })).tap()
        let english = settings.descendants(matching: .any)
            .matching(NSPredicate(format: "label == %@", "English"))
        if !english.firstMatch.waitForExistence(timeout: 15) {
            recordOSSelectorDiagnostics(settings)
            app.activate(); XCTAssertTrue(app.wait(for: .runningForeground, timeout: 20))
            app.buttons["parlor-dsc01-os-no-selection"].tap()
            app.buttons["parlor-dsc01-complete"].tap()
            XCTAssertEqual(try observe(app)["osDisposition"] as? String, "selection-unavailable")
            return
        }
        XCTAssertLessThan(english.count, 16)
        try XCTUnwrap(english.allElementsBoundByIndex.first(where: { $0.isHittable })).tap()
        XCTAssertFalse(settings.alerts.firstMatch.exists, "Do not dismiss unknown OS alerts")
        app.launchEnvironment["PARLOR_DSC01_FIXTURE"] = "continue"
        app.activate(); XCTAssertTrue(app.wait(for: .runningForeground, timeout: 30))
        let afterOS = try observeEventually(app) { snapshot in
            let preferences = try self.dictionary(snapshot, "now")
            return preferences["setting"] as? String == "system" &&
                   preferences["ownerPresent"] as? Bool == false &&
                   preferences["preferredLanguage"] as? String == "en" &&
                   preferences["hasAppOverride"] as? Bool == true
        }
        let actualOSPreferences = try XCTUnwrap(try dictionary(afterOS, "now")["appLanguages"] as? [String])
        XCTAssertFalse(actualOSPreferences.isEmpty)
        try openSettings(app, language: "en")
        try tap(app, label: "العربية")
        try assertSettingsStrings(app, language: "ar")
        let explicit = try observeEventually(app) { snapshot in
            try self.dictionary(snapshot, "now")["ownerInstalled"] as? String == "ar"
        }
        try assertOwned(explicit, explicit: "ar", previous: actualOSPreferences)
        try tap(app, label: "لغة النظام")
        try assertSettingsStrings(app, language: "en")
        try assertSystem(try observe(app), expected: "en", previous: actualOSPreferences)
        // An OS language selection can intentionally restart a process. Its
        // ownership/restart proof is separate from same-process game retention.
        let beforeBoot = try string(try observe(app), "boot")
        app.terminate(); XCTAssertTrue(app.wait(for: .notRunning, timeout: 15))
        try launch(app, fixture: "continue")
        let restarted = try observe(app)
        XCTAssertNotEqual(try string(restarted, "boot"), beforeBoot)
        try assertSystem(restarted, expected: "en", previous: actualOSPreferences)
        app.buttons["parlor-dsc01-os-verified"].tap()
        app.buttons["parlor-dsc01-complete"].tap()
        XCTAssertEqual(try observe(app)["osDisposition"] as? String, "verified-english")
    }

    @MainActor private func recordOSSelectorDiagnostics(_ settings: XCUIApplication) {
        // Bounded known-public UI metadata only. Absence is a selector/platform
        // evidence gap, not proof that the OS feature is inapplicable.
        let labels = ["Parlor", "Language", "Preferred Language", "English", "Arabic", "العربية",
                      "Apps", "Settings", "Local Network"]
        let rows: [[String: Any]] = labels.map { label in
            let query = settings.descendants(matching: .any).matching(NSPredicate(format: "label == %@", label))
            let count = query.count
            let elements = count < 32 ? Array(query.allElementsBoundByIndex.prefix(4)) : []
            return ["knownLabel": label, "countCappedAt32": min(count, 32),
                    "hittableAmongAtMost4": elements.filter { $0.isHittable }.count]
        }
        if let data = try? JSONSerialization.data(withJSONObject: ["schemaVersion": 1, "observations": rows]),
           data.count <= 8192, let text = String(data: data, encoding: .utf8) {
            print("DSC01_OS_SELECTOR_DIAGNOSTICS " + text)
        }
    }

    private func optionalDictionary(_ value: [String: Any], _ key: String) -> [String: Any] {
        value[key] as? [String: Any] ?? [:]
    }

    @MainActor private func launch(_ app: XCUIApplication, fixture: String) throws {
        app.launchEnvironment["PARLOR_DSC01_FIXTURE"] = fixture
        app.launch()
        XCTAssertTrue(app.wait(for: .runningForeground, timeout: 30))
        XCTAssertTrue(app.staticTexts["parlor-home-brand"].waitForExistence(timeout: 30))
        XCTAssertTrue(app.buttons["parlor-dsc01-observe"].waitForExistence(timeout: 10))
        XCTAssertFalse(app.alerts.firstMatch.exists, "Do not dismiss unexpected alerts or call a failed launch passing")
    }

    @MainActor private func openSettings(_ app: XCUIApplication, language: String) throws {
        // CMP UI 1.10.3 UIKit combines this selectable parent description
        // with its uppercase Text child, using a comma-space separator.
        // Exact pinned-source proof is retained beside this versioned harness.
        try tap(app, label: language == "ar" ? "افتح الإعدادات., الإعدادات" : "Open settings., SETTINGS")
        try assertSettingsStrings(app, language: language)
    }

    @MainActor private func assertSettingsStrings(_ app: XCUIApplication, language: String) throws {
        let text = language == "ar" ? "اللغة" : "LANGUAGE"
        let query = app.descendants(matching: .any).matching(NSPredicate(format: "label == %@", text))
        XCTAssertTrue(query.firstMatch.waitForExistence(timeout: 15), "Actual localized Compose language section missing")
        XCTAssertTrue(app.descendants(matching: .any).matching(NSPredicate(format: "label == %@",
                      language == "ar" ? "لغة النظام" : "System language")).firstMatch.exists)
        let direct = try observeEventually(app) { snapshot in
            let composition = try self.dictionary(snapshot, "composition")
            return composition["settingsMounted"] as? Bool == true &&
                   composition["settingsDirection"] as? String == (language == "ar" ? "rtl" : "ltr")
        }
        XCTAssertEqual(try dictionary(direct, "composition")["settingsDirection"] as? String,
                       language == "ar" ? "rtl" : "ltr", "Read from actual Settings LocalLayoutDirection, not inferred from locale")
    }

    @MainActor private func tap(_ app: XCUIApplication, label: String) throws {
        let query = app.descendants(matching: .any).matching(NSPredicate(format: "label == %@", label))
        let exists = query.firstMatch.waitForExistence(timeout: 15)
        if !exists { recordSelectorDiagnostics(app, expected: label) }
        XCTAssertTrue(exists, "Missing exact actual-app label; this is a selector/evidence failure, not crash proof")
        let matches = query.allElementsBoundByIndex
        if matches.count >= 32 { recordSelectorDiagnostics(app, expected: label) }
        XCTAssertLessThan(matches.count, 32, "Selector unexpectedly broad")
        let hittable = matches.first(where: { $0.isHittable })
        if hittable == nil { recordSelectorDiagnostics(app, expected: label) }
        let element = try XCTUnwrap(hittable, "No hittable exact-label control")
        element.tap()
    }

    @MainActor private func recordSelectorDiagnostics(_ app: XCUIApplication, expected: String) {
        // Diagnostic queries are exact and source-whitelisted. They never pick a
        // fallback target, export a hierarchy, or read arbitrary labels/values.
        let labels = ["Open settings., SETTINGS", "افتح الإعدادات., الإعدادات",
                      "Open settings.", "افتح الإعدادات.", "SETTINGS", "الإعدادات",
                      "LANGUAGE", "اللغة", "System language", "لغة النظام", "English", "العربية"]
        let observations: [[String: Any]] = labels.map { known in
            let query = app.descendants(matching: .any).matching(NSPredicate(format: "label == %@", known))
            let count = query.count
            let inspected = count < 32 ? Array(query.allElementsBoundByIndex.prefix(4)) : []
            return ["knownLabel": known, "countCappedAt32": min(count, 32),
                    "inspectedAtMost4": inspected.count,
                    "hittableAmongInspected": inspected.filter { $0.isHittable }.count]
        }
        let report: [String: Any] = ["schemaVersion": 1,
            "expectedKnownLabel": labels.contains(expected) ? expected : "not-allowlisted",
            "observations": observations]
        if let data = try? JSONSerialization.data(withJSONObject: report, options: [.sortedKeys]),
           data.count <= 8192, let text = String(data: data, encoding: .utf8) {
            print("DSC01_SELECTOR_DIAGNOSTICS " + text)
        }
    }

    @MainActor private func observe(_ app: XCUIApplication) throws -> [String: Any] {
        let state = app.staticTexts["parlor-dsc01-state"]
        XCTAssertTrue(state.waitForExistence(timeout: 10))
        let previous = state.value as? String
        app.buttons["parlor-dsc01-observe"].tap()
        let changed = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
            state.value as? String != previous
        }, object: nil)
        XCTAssertEqual(XCTWaiter.wait(for: [changed], timeout: 10), .completed)
        let encoded = try XCTUnwrap((state.value as? String)?.data(using: .utf8))
        XCTAssertLessThanOrEqual(encoded.count, 8192)
        let snapshot = try XCTUnwrap(JSONSerialization.jsonObject(with: encoded) as? [String: Any])
        XCTAssertNil(snapshot["harnessError"])
        XCTAssertEqual(snapshot["controllerCreations"] as? Int, 1, "Original root controller must remain the only one in this process")
        return snapshot
    }

    @MainActor private func observeEventually(_ app: XCUIApplication,
                                              predicate: ([String: Any]) throws -> Bool) throws -> [String: Any] {
        // Bounded read-only observation refresh, never retries an app setting mutation.
        for _ in 0..<6 {
            let snapshot = try observe(app)
            if try predicate(snapshot) { return snapshot }
        }
        XCTFail("Actual settings/owner never reached required state after bounded observations")
        throw NSError(domain: "DSC01ObservationTimeout", code: 1)
    }

    private func assertOwned(_ snapshot: [String: Any], explicit: String, previous: [String]) throws {
        let value = try dictionary(snapshot, "now")
        XCTAssertEqual(value["setting"] as? String, explicit)
        XCTAssertEqual(value["appLanguages"] as? [String], [explicit])
        XCTAssertEqual(value["hasAppOverride"] as? Bool, true)
        XCTAssertEqual(value["ownerPresent"] as? Bool, true)
        XCTAssertEqual(value["ownerInstalled"] as? String, explicit)
        XCTAssertEqual(value["ownerPrevious"] as? [String], previous)
        XCTAssertEqual(value["ownerPreviousPresent"] as? Bool, !previous.isEmpty)
        XCTAssertEqual(value["preferredLanguage"] as? String, explicit)
        XCTAssertEqual(snapshot["nativeDirection"] as? String, explicit == "ar" ? "force_rtl" : "force_ltr")
    }

    private func assertSystem(_ snapshot: [String: Any], expected: String, previous: [String]) throws {
        let value = try dictionary(snapshot, "now")
        XCTAssertEqual(value["setting"] as? String, "system")
        XCTAssertEqual(value["hasAppOverride"] as? Bool, !previous.isEmpty)
        XCTAssertEqual(value["appLanguages"] as? [String], previous)
        XCTAssertEqual(value["ownerPresent"] as? Bool, false)
        XCTAssertEqual(value["ownerInstalled"] as? String, "none")
        XCTAssertEqual(value["preferredLanguage"] as? String, expected)
        XCTAssertEqual(snapshot["nativeDirection"] as? String, expected == "ar" ? "force_rtl" : "force_ltr")
    }

    private func dictionary(_ value: [String: Any], _ key: String) throws -> [String: Any] {
        try XCTUnwrap(value[key] as? [String: Any])
    }
    private func string(_ value: [String: Any], _ key: String) throws -> String {
        try XCTUnwrap(value[key] as? String)
    }
}
