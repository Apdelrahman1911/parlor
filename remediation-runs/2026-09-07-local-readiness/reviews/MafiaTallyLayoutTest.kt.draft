package com.parlor.games.mafia.ui.screens

import androidx.compose.foundation.layout.size
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalDensity
import androidx.compose.ui.platform.testTag
import androidx.compose.ui.semantics.SemanticsActions
import androidx.compose.ui.test.ExperimentalTestApi
import androidx.compose.ui.test.SemanticsMatcher
import androidx.compose.ui.test.assertIsDisplayed
import androidx.compose.ui.test.getUnclippedBoundsInRoot
import androidx.compose.ui.test.hasText
import androidx.compose.ui.test.onNodeWithTag
import androidx.compose.ui.test.onNodeWithText
import androidx.compose.ui.test.performScrollTo
import androidx.compose.ui.test.performSemanticsAction
import androidx.compose.ui.test.runComposeUiTest
import androidx.compose.ui.text.TextLayoutResult
import androidx.compose.ui.unit.Density
import androidx.compose.ui.unit.dp
import com.parlor.core.ids.PlayerId
import com.parlor.designsystem.localization.AppLanguage
import com.parlor.designsystem.localization.ProvideAppLanguage
import com.parlor.designsystem.theme.ParlorAccent
import com.parlor.designsystem.theme.ParlorAccentScope
import com.parlor.designsystem.theme.ParlorTheme
import com.parlor.designsystem.theme.ThemeMode
import com.parlor.games.mafia.ui.screens.night.MafiaKillVoteScreen
import com.parlor.games.mafia.ui.screens.night.PickableTarget
import com.parlor.games.mafia.ui.screens.vote.VoteAnnouncementScreen
import com.parlor.networking.room.RoomInputPolicy
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertFalse
import kotlin.test.assertTrue

/** Actual shipping tally composables; valid names, not a duplicate row fixture. */
@OptIn(ExperimentalTestApi::class)
class MafiaTallyLayoutTest {
    @Test
    fun compact_english_day_tally_keeps_each_count_visible(): Unit =
        verifyTally(AppLanguage.English, 1f, night = false)

    @Test
    fun compact_arabic_day_tally_keeps_each_count_visible(): Unit =
        verifyTally(AppLanguage.Arabic, 1f, night = false)

    @Test
    fun compact_large_text_english_day_tally_keeps_each_count_visible(): Unit =
        verifyTally(AppLanguage.English, 2f, night = false)

    @Test
    fun compact_large_text_arabic_day_tally_keeps_each_count_visible(): Unit =
        verifyTally(AppLanguage.Arabic, 2f, night = false)

    @Test
    fun compact_english_mafia_revote_tally_keeps_each_count_visible(): Unit =
        verifyTally(AppLanguage.English, 1f, night = true)

    @Test
    fun compact_arabic_mafia_revote_tally_keeps_each_count_visible(): Unit =
        verifyTally(AppLanguage.Arabic, 1f, night = true)

    @Test
    fun compact_large_text_english_mafia_revote_tally_keeps_each_count_visible(): Unit =
        verifyTally(AppLanguage.English, 2f, night = true)

    @Test
    fun compact_large_text_arabic_mafia_revote_tally_keeps_each_count_visible(): Unit =
        verifyTally(AppLanguage.Arabic, 2f, night = true)

    private fun verifyTally(language: AppLanguage, fontScale: Float, night: Boolean): Unit = runComposeUiTest {
        val arabic = language == AppLanguage.Arabic
        val longName = (if (arabic) "ش" else "W").repeat(RoomInputPolicy.MAX_DISPLAY_NAME_LENGTH)
        assertTrue(RoomInputPolicy.isValidDisplayName(longName))
        val first = PlayerId("tally-first")
        val second = PlayerId("tally-second")
        val names = linkedMapOf(
            first to longName,
            second to "Player B",
            PlayerId("tally-third") to "Player C",
            PlayerId("tally-fourth") to "Player D",
            PlayerId("tally-fifth") to "Player E",
            PlayerId("tally-sixth") to "Player F",
        )
        // Eight living seats can cast a public 3:2 day ballot with three
        // abstentions. Two Mafia can tie 1:1 among these six living Town targets.
        val tally = if (night) linkedMapOf(first to 1, second to 1) else linkedMapOf(first to 3, second to 2)
        val heading = when {
            night && arabic -> "نتيجة الجولة الأولى"
            night -> "Round 1 tally"
            arabic -> "الأصوات"
            else -> "Tally"
        }.uppercase()
        setContent {
            CompositionLocalProvider(LocalDensity provides Density(1f, fontScale)) {
                ProvideAppLanguage(language) {
                    ParlorTheme(themeMode = ThemeMode.Light, reducedMotion = true) {
                        ParlorAccentScope(ParlorAccent.Crimson) {
                            val frame = Modifier.size(320.dp, 640.dp).testTag(VIEWPORT)
                            if (night) {
                                MafiaKillVoteScreen(
                                    voterName = "Player G",
                                    targets = names.map { (id, name) -> PickableTarget(id, name) },
                                    coordinationRound = 2,
                                    previousRoundTally = tally,
                                    targetNameLookup = names::getValue,
                                    onSubmit = {},
                                    modifier = frame,
                                )
                            } else {
                                VoteAnnouncementScreen(
                                    day = 1,
                                    tally = tally,
                                    nameLookup = names::getValue,
                                    eliminatedName = longName,
                                    eliminatedRole = null,
                                    outcomeLine = "Public result",
                                    onAcknowledged = {},
                                    modifier = frame,
                                )
                            }
                        }
                    }
                }
            }
        }
        val listColumn = checkNotNull(onNodeWithText(heading, useUnmergedTree = true)
            .fetchSemanticsNode().layoutInfo.parentInfo)
        for ((id, expectedCount) in tally) {
            // The same name also appears in the night target picker and public
            // elimination headline. Select its exact row under the tally header.
            val name = onNode(
                hasText(names.getValue(id)) and SemanticsMatcher("name inside the actual tally list") {
                    it.layoutInfo.parentInfo?.parentInfo === listColumn
                },
                useUnmergedTree = true,
            )
            name.performScrollTo()
            val row = checkNotNull(name.fetchSemanticsNode().layoutInfo.parentInfo)
            val count = onNode(
                hasText(expectedCount.toString()) and SemanticsMatcher("count in the same tally entry") {
                    it.layoutInfo.parentInfo === row
                },
                useUnmergedTree = true,
            )
            val measured = count.fetchSemanticsNode().size
            val nameBounds = name.getUnclippedBoundsInRoot()
            assertTrue(
                measured.width > 0 && measured.height > 0,
                "$language fontScale=$fontScale night=$night: tally count $expectedCount measured=$measured " +
                    "name=$nameBounds count=${count.getUnclippedBoundsInRoot()}",
            )
            count.performScrollTo().assertIsDisplayed()
            val bounds = count.getUnclippedBoundsInRoot()
            val viewport = onNodeWithTag(VIEWPORT).getUnclippedBoundsInRoot()
            assertTrue(
                bounds.left >= viewport.left && bounds.right <= viewport.right &&
                    bounds.top >= viewport.top && bounds.bottom <= viewport.bottom,
                "Tally count remains outside the screen after scrolling: $bounds viewport=$viewport",
            )
            val layouts = mutableListOf<TextLayoutResult>()
            count.performSemanticsAction(SemanticsActions.GetTextLayoutResult) { it(layouts) }
            assertEquals(1, layouts.size)
            val layout = layouts.single()
            assertFalse(
                layout.hasVisualOverflow,
                "Tally count is clipped: size=${layout.size} paragraph=${layout.multiParagraph.width}x" +
                    "${layout.multiParagraph.height} constraints=${layout.layoutInput.constraints}",
            )
        }
    }

    private companion object {
        const val VIEWPORT = "mafia-tally-viewport"
    }
}
