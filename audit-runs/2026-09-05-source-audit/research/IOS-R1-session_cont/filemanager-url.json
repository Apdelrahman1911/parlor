hDomainMask","isActive":true,"type":"reference"},{"text":". You should specify only one domain for your search and you may not specify the ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/FileManager\/SearchPathDomainMask\/allDomainsMask","isActive":true,"type":"reference"},{"text":" constant for this parameter.","type":"text"}],"type":"paragraph"}],"name":"domain"},{"content":[{"inlineContent":[{"text":"The file URL used to determine the location of the returned URL. Only the volume of this parameter is used.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This parameter is ignored unless the ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":" parameter contains the value ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/FileManager\/SearchPathDirectory\/itemReplacementDirectory","isActive":true,"type":"reference"},{"text":" and the ","type":"text"},{"code":"domain","type":"codeVoice"},{"text":" parameter contains the value ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/FileManager\/SearchPathDomainMask\/userDomainMask","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"url"},{"content":[{"inlineContent":[{"text":"Whether to create the directory if it does not already exist.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When creating a temporary directory, this parameter is ignored and the directory is always created.","type":"text"}],"type":"paragraph"}],"name":"shouldCreate"}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/NSURL","isActive":true,"type":"reference"},{"text":" for the requested directory. When using Objective-C, if an error occurs, this method returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and assigns an appropriate error object to the ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" parameter.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"Discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"You typically use this method to locate one of the standard system directories, such as the ","type":"text"},{"code":"Documents","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Application Support","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Caches","type":"codeVoice"},{"text":" directories. After locating (or creating) the desired directory, this method returns the URL for that directory. If more than one appropriate directory exists in the specified domain, this method returns only the first one it finds.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"Passing a directory and domain pair that makes no sense (for example ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/FileManager\/SearchPathDirectory\/desktopDirectory","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/FileManager\/SearchPathDomainMask\/networkDomainMask","isActive":true,"type":"reference"},{"text":") raises an exception.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"inlineContent":[{"text":"You can use this method to create a new temporary directory. To do so, specify ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/FileManager\/SearchPathDirectory\/itemReplacementDirectory","isActive":true,"type":"reference"},{"text":" for the ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":" parameter, ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/FileManager\/SearchPathDomainMask\/userDomainMask","isActive":true,"type":"reference"},{"text":" for the ","type":"text"},{"code":"domain","type":"codeVoice"},{"text":" parameter, and a URL for the ","type":"text"},{"code":"url","type":"codeVoice"},{"text":" parameter which determines the volume of the returned URL.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, the following code results in a new temporary directory with a path in the form of ","type":"text"},{"code":"\/private\/var\/folders\/d0\/h37cw8ns3h1bfr_2gnwq2yyc0000gn\/T\/TemporaryItems\/Untitled\/","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"tabs":[{"content":[{"code":["let desktop = URL(fileURLWithPath: \"\/Users\/jappleseed\/Desktop\/\")","","do {","    let temporaryDirectory = try FileManager.default.url(","        for: .itemReplacementDirectory,","        in: .userDomainMask,","        appropriateFor: desktop,","        create: true","    )","    ","    print(temporaryDirectory)","} catch {","    \/\/ Handle the error.","}"],"syntax":"swift","type":"codeListing"}],"title":"Swift"},{"content":[{"code":["NSURL *desktopURL = [NSURL fileURLWithPath:@\"\/Users\/jappleseed\/Desktop\/\"","                               isDirectory:YES];","NSError *error = nil;","","NSURL *temporaryDirectoryURL = [[NSFileManager defaultManager] URLForDirectory:NSItemReplacementDirectory","                                                                      inDomain:NSUserDomainMask","                                                             appropriateForURL:desktopURL","                                                                        create:YES","                                                                         error:&error];","NSLog(@\"%@\", temporaryDirectoryURL);","","if (error) {","    \/\/ Handle the error.","}"],"syntax":"objc","type":"codeListing"}],"title":"Objective-C"}],"type":"tabNavigator"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"If you use this method to create a temporary directory, you should not rely on the existence of that temporary directory after the app is exited. It is recommended that you remove any temporary directories that are created after they’re no longer needed.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"In Swift, this method returns a nonoptional result and is marked with the ","type":"text"},{"code":"throws","type":"codeVoice"},{"text":" keyword to indicate that it throws an error in cases of failure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You call this method in a ","type":"text"},{"code":"try","type":"codeVoice"},{"text":" expression and handle any errors in the ","type":"text"},{"code":"catch","type":"codeVoice"},{"text":" clauses of a ","type":"text"},{"code":"do","type":"codeVoice"},{"text":" statement, as described in ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/ErrorHandling.html","isActive":true,"type":"reference"},{"text":" in ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swift-book\/","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"code":"About Imported Cocoa Error Parameters","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Handling Errors in Swift","style":"note","type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Locating-system-directories","generated":true,"identifiers":["doc:\/\/com.apple.foundation\/documentation\/Foundation\/FileManager\/urls(for:in:)","doc:\/\/com.apple.foundation\/documentation\/Foundation\/NSSearchPathForDirectoriesInDomains(_:_:_:)","doc:\/\/com.apple.foundation\/documentation\/Foundation\/NSOpenStepRootDirectory()"],"title":"Locati