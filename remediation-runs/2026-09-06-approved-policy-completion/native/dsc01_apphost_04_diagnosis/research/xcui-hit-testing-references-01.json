              },
              {
                "identifier": "doc://com.apple.documentation/documentation/Swift/false",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " if the element doesn’t exist, is offscreen, or is covered by another element.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "content": [
              {
                "inlineContent": [
                  {
                    "text": "",
                    "type": "text"
                  },
                  {
                    "text": " ",
                    "type": "text"
                  },
                  {
                    "identifier": "doc://com.apple.xcuiautomation/documentation/XCUIAutomation/XCUIElement/isHittable",
                    "isActive": true,
                    "type": "reference"
                  },
                  {
                    "text": " only returns ",
                    "type": "text"
                  },
                  {
                    "identifier": "doc://com.apple.documentation/documentation/Swift/true",
                    "isActive": true,
                    "type": "reference"
                  },
                  {
                    "text": " if the element is already visible and hittable onscreen. It returns ",
                    "type": "text"
                  },
                  {
                    "identifier": "doc://com.apple.documentation/documentation/Swift/false",
                    "isActive": true,
                    "type": "reference"
                  },
                  {
                    "text": " for an offscreen element in a scrollable view, even if the element can be scrolled into a hittable position by calling ",
                    "type": "text"
