+class L08HostLanguageAcknowledgementTests(unittest.TestCase):
+    """Source and synthetic strict-parser controls only; no Simulator or scheduling proof."""
+
+    def test_exact_host_acknowledgement_delta_keeps_original_parser_and_one_command_sample(self):
+        candidate = (HERE / 'L08HostLaunch.swift.in').read_text()
+        original = (CANONICAL / 'L08HostLaunch.swift.in').read_text()
+        assert_host_language_ack_contract(candidate, original)
+        self.assertEqual(candidate.count('MainViewControllerKt.L08HostCommand(action: action)'), 1)
+        self.assertEqual(candidate.count('self.sample()'), 1)
+        self.assertEqual(candidate.count('DispatchQueue.main.asyncAfter('), 1)
+        self.assertNotIn('UserDefaults', candidate)
+        self.assertNotIn('Thread.sleep', candidate)
+        self.assertEqual(section((HERE / 'l08_receipts.py').read_text(),
+                                 'def verify_host(', 'def preserve_l08_evidence('),
+                         section((CANONICAL / 'l08_receipts.py').read_text(),
+                                 'def verify_host(', 'def preserve_l08_evidence('))
+        with self.assertRaisesRegex(RuntimeError, '^Ambiguous source section$'):
+            assert_host_language_ack_contract(original, original)
+
+    def test_acknowledgement_contract_rejects_ownership_timeout_lifetime_and_row_substitutions(self):
+        candidate = (HERE / 'L08HostLaunch.swift.in').read_text()
+        original = (CANONICAL / 'L08HostLaunch.swift.in').read_text()
+        assert_host_language_ack_contract(candidate, original)
+        mutations = (
+            ('!original.ownerPresent, original.ownerInstalled == "none",', 'true,'),
+            ('current.ownerPresent && current.ownerInstalled == language', 'current.ownerInstalled == language'),
+            ('current.ownerInstalled == language', 'current.ownerInstalled == "none"'),
+            ('current.appLanguages == [language]', 'current.appLanguages.isEmpty'),
+            ('current.ownerPreviousPresent == original.hasAppOverride', 'true'),
+            ('current.ownerPrevious == original.appLanguages', 'current.ownerPrevious.isEmpty'),
+            ('return current == original', 'return current.setting == "system"'),
+            ('if action == "language-system" {', 'UserDefaults.standard.set(["en"], forKey: "AppleLanguages"); if action == "language-system" {'),
+            ('boot == expectedBoot && l08HostIndex == index', 'l08HostIndex == index'),
+            ('boot == expectedBoot && l08HostIndex == index', 'boot == expectedBoot'),
+            ('l08HostDisplay == "running" && report?.completed == false', 'l08HostDisplay == "running"'),
+            ('remaining > 0, ProcessInfo.processInfo.systemUptime <= deadline', 'remaining > 0'),
+            ('remaining: remaining - 1', 'remaining: remaining'),
+            ('remaining: 200, publish: publish', 'remaining: 201, publish: publish'),
+            ('deadline: .now() + .milliseconds(25)', 'deadline: .now()'),
+            ('guard !["running", "invalid-context", "duplicate-callback", "bounded-receipt-failed"]',
+             'guard !["running"]'),
+            ('guard !callback.received else', 'guard true else'),
+            ('observation["status"] as? String == "PASS"', 'observation["status"] as? String != "PASS"'),
+            ('self.sample()', 'self.sample(); self.sample()'),
+            ('last.ordinal == beforeOrdinal + 1', 'last.ordinal >= beforeOrdinal'),
+            ('last.boot == expectedBoot', 'last.boot == self.boot'),
+            ('l08HostLanguageAcknowledged(action, last.preferences, original)',
+             'l08HostLanguageAcknowledged(action, try self.preferences(), original)'),
+            ('try publish() // Preserve a failed Kotlin result immediately, without an ownership wait.', 'return'),
+            ('options: [.withoutOverwriting]', 'options: [.atomic]'),
+            ('self?.awaitL08HostLanguage(action, index: index, expectedBoot: expectedBoot,',
+             'self?.nextL08HostCommand(); self?.awaitL08HostLanguage(action, index: index, expectedBoot: expectedBoot,'),
+        )
+        for before, after in mutations:
+            with self.subTest(mutation=before):
+                self.assertEqual(candidate.count(before), 1)
+                altered = candidate.replace(before, after, 1)
+                self.assertNotEqual(altered, candidate)
+                with self.assertRaises(RuntimeError):
+                    assert_host_language_ack_contract(altered, original)
+
+    @mock.patch.object(host_receipts, 'bind_loaded_images')
