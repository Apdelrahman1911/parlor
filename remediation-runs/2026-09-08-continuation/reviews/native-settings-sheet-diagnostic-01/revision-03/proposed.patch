+    extra = [p for p in HERE.iterdir() if p.is_file() and p.suffix in {'.py', '.in', '.md'}]
+    extra += [ROOT / p for p in ('.github/workflows/production-verification.yml', 'scripts/ci/native_continuation.py')]
+    for path in extra:
