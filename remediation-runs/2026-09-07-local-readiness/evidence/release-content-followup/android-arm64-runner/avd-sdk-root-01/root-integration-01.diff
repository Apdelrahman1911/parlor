+def sdk_metadata(sdk):
+    """Read-only metadata observation; do not scan unrelated profiles/data."""
+    rows = []
+    for relative in (Path(".knownPackages"), IMAGE_RELATIVE / "package.xml",
+                     IMAGE_RELATIVE / "source.properties"):
+        path = sdk / relative
+        if not path.exists() and not path.is_symlink():
+            rows.append({"path": relative.as_posix(), "present": False})
+            continue
+        info = path.lstat()
+        if (path.is_symlink() or not stat.S_ISREG(info.st_mode) or
+                info.st_size > 1024 * 1024):
+            raise RuntimeError("Unexpected SDK metadata file")
+        rows.append({"path": relative.as_posix(), "present": True, "sha256": sha256(path),
+                     "identity": [info.st_dev, info.st_ino, info.st_size,
+                                  info.st_mtime_ns, info.st_ctime_ns]})
+    return rows
+
