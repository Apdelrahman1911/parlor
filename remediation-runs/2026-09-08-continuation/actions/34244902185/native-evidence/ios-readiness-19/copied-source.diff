+    @MainActor private func l08GameSample(_ app: XCUIApplication, identifier: String) -> DSC01MafiaStartSample {
+        let query = app.descendants(matching: .any).matching(identifier: identifier)
+        let count = query.count
+        let target = count == 1 ? query.firstMatch : nil
+        let overlays = app.descendants(matching: .any).matching(identifier: "parlor-dsc01-overlay")
+        return DSC01MafiaStartSample(targetCount: count, target: target?.frame,
+            hittable: target?.isHittable ?? false, enabled: target?.isEnabled ?? false, viewport: app.frame,
+            overlayCount: overlays.count, overlay: overlays.count == 1 ? overlays.firstMatch.frame : nil,
+            foreground: app.state == .runningForeground, alertPresent: app.alerts.firstMatch.exists,
+            keyboardPresent: app.keyboards.firstMatch.exists)
+    }
+
+    @MainActor private func l08ReadyGameControl(_ app: XCUIApplication, identifier: String) throws -> XCUIElement {
+        XCTAssertTrue(["l08-mafia-repeat", "l08-mafia-start"].contains(identifier))
+        for attempt in 1...14 {
+            var samples: [DSC01MafiaStartSample] = []
+            for index in 1...6 {
+                if index > 1 { try catalogSamplingInterval() }
+                samples.append(l08GameSample(app, identifier: identifier))
+            }
+            guard samples.allSatisfy(\.isExpectedEnvironment), let first = samples.first else {
+                throw NSError(domain: "L08PublicGameEnvironment", code: 1)
+            }
+            let stable = samples.allSatisfy { $0.geometryNear(first) }
+            if stable && samples.allSatisfy({ $0.plan != nil }) {
+                let query = app.descendants(matching: .any).matching(identifier: identifier)
+                XCTAssertEqual(query.count, 1)
+                return query.firstMatch
+            }
+            if stable && samples.allSatisfy({ $0.targetCount == 1 && !$0.enabled }) {
+                throw NSError(domain: "L08OriginalSetupDisabled", code: 1)
+            }
+            if attempt < 14 && (stable || samples.allSatisfy({ !$0.hittable })) {
+                app.swipeUp(velocity: .slow)
+            }
+        }
+        throw NSError(domain: "L08PublicGameTargetUnavailable", code: 1)
+    }
+
+    @MainActor private func l08ActivateGameControlOnce(_ app: XCUIApplication, identifier: String) throws {
+        let target = try l08ReadyGameControl(app, identifier: identifier)
+        let first = l08GameSample(app, identifier: identifier)
+        try catalogSamplingInterval()
+        let second = l08GameSample(app, identifier: identifier)
+        guard second.geometryNear(first), let plan = second.plan else {
+            throw NSError(domain: "L08PublicGameTargetMoved", code: 1)
+        }
+        let coordinate = target.coordinate(withNormalizedOffset: plan.normalizedOffset)
+        let point = coordinate.screenPoint
+        guard point.x.isFinite, point.y.isFinite, abs(point.x - plan.point.x) <= 0.5,
+              abs(point.y - plan.point.y) <= 0.5 else { throw NSError(domain: "L08PublicGamePointMoved", code: 1) }
+        coordinate.tap() // One measured activation, outside every readiness loop.
+    }
+}
