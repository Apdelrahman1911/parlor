+// Appended to the copied XCTest source only. These names identify the unchanged
+// observation predicates; no preference values or private game state are logged.
+private enum DSC01ObservationPredicate: String {
+    case settingsExplicitOwner, settingsSystemRelease
+    case previousEnglishOwner, previousSystemRestore, syntheticStoreApplied
+    case localInitialPublicPhase, localLanguageDirection, foregroundCounters
+    case afterOSSystemArabic, afterOSExplicitEnglish
+    case gamesSettingsUnmounted, actualSettingsDirection
+    case mafiaSetupPublic, mafiaStartSuccessor
