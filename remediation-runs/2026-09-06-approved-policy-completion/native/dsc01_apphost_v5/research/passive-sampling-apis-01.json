                },
                {
                  "kind": "text",
                  "text": " "
                },
                {
                  "kind": "attribute",
                  "text": "@preconcurrency"
                },
                {
                  "kind": "text",
                  "text": " "
                },
                {
                  "kind": "attribute",
                  "text": "@frozen"
                },
                {
                  "kind": "text",
                  "text": " "
                },
                {
                  "kind": "keyword",
