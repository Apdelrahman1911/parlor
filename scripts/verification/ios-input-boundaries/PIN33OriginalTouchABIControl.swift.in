    @objc(canPreventGestureRecognizer:) dynamic func canPrevent(_ other: AnyObject) -> Bool { true }
    @objc(shouldRequireFailureOfGestureRecognizer:) dynamic func shouldRequireFailureOf(_ other: AnyObject) -> Bool { false }
}
class PIN33Inherited: PIN33Parent { }
var admitted = true
