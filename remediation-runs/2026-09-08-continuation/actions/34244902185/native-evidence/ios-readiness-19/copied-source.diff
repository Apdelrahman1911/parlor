+    @discardableResult
+    private func appendObservation(phase: String, publish: Bool = true,
+                                   samplingWindow: Int = 0, samplingIndex: Int = 0,
+                                   samplingElapsedMilliseconds: Int = 0,
+                                   samplingContext: String = "none") throws -> DSC01Observation {
+        guard var value = report, value.observations.count < 256, beforeMain != nil else { throw fixtureError() }
+        let now = try preferences()
+        // The native oracle is EXACTLY the controller observed at the actual
+        // LocalUIViewController read, never Main's return value or a type guess.
+        // Before App starts, no Kotlin bridge call or premature view load occurs.
+        let child = phase == "before_main" ? nil : MainViewControllerKt.DSC01ActualUIKitController()
+        let direction = dsc01Direction(child?.viewIfLoaded)
+        let native = phase == "before_main" ? DSC01NativeObservation.unavailable : nativeObservation(child)
+        // This direct read is deliberately unavailable before original Main/App
+        // initialization; invoking the Kotlin bridge there would invalidate the
+        // persisted-ownership startup witness.
+        let composition = phase == "before_main" ? "{}" : MainViewControllerKt.DSC01ActualCompositionObservation()
+        guard composition.utf8.count <= 4096 else { throw fixtureError() }
+        let observation = DSC01Observation(
+            ordinal: value.observations.count + 1, phase: phase, fixture: fixture,
+            boot: boot, preferences: now, nativeDirection: direction, native: native,
+            controllerCreations: controllerCreations,
+            composition: composition, osDisposition: osDisposition, samplingWindow: samplingWindow,
+            samplingIndex: samplingIndex, samplingElapsedMilliseconds: samplingElapsedMilliseconds,
+            samplingContext: samplingContext
+        )
+        value.observations.append(observation)
+        let encoded = try JSONEncoder().encode(value)
+        guard encoded.count <= 262144 else { throw fixtureError() }
+        try encoded.write(to: resultURL, options: .atomic)
+        report = value
+        if publish { try publishObservation(observation) }
+        return observation
+    }
