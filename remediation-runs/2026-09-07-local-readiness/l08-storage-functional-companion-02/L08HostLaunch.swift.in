// Appended to the same owned Debug simulator ContentView as the original probe.
private let l08HostPlan = ["prepare", "capture", "language-en", "cycle-1", "resume-1", "language-ar",
    "cycle-2", "resume-2", "remount", "language-system", "cycle-3", "resume-3", "active-ack", "leave"]

extension DSC01Probe {
    var isL08HostScenario: Bool { scenario == "l08-host" }

    func nextL08HostCommand() {
        precondition(Thread.isMainThread && isL08HostScenario)
        let env = ProcessInfo.processInfo.environment
        guard let number = Int(env["PARLOR_L08_HOST_BOOT"] ?? ""), (1...3).contains(number),
              l08HostIndex < l08HostPlan.count, l08HostDisplay != "running" else {
            l08HostDisplay = "invalid-context"; return
        }
        let action = l08HostPlan[l08HostIndex]
        l08HostDisplay = "running"
        MainViewControllerKt.L08HostCommand(action: action) { [weak self] json in
            DispatchQueue.main.async {
                guard let self else { return }
                do {
                    let raw = Data(json.utf8)
                    guard raw.count <= 8192,
                          let observation = try JSONSerialization.jsonObject(with: raw) as? [String: Any] else {
                        throw self.fixtureError()
                    }
                    // Sample actual UIKit/Compose/preferences before binding the
                    // operation to a particular durable observation sequence.
                    let beforeOrdinal = self.report?.observations.last?.ordinal ?? 0
                    self.sample()
                    guard let report = self.report, let last = report.observations.last,
                          last.ordinal == beforeOrdinal + 1,
                          last.boot == self.boot, last.phase == "sample" else { throw self.fixtureError() }
                    let images = try nativeReadinessLoadedImages()
                    let record: [String: Any] = ["schema_version": 1, "scenario": "l08-host",
                        "signing_mode": nativeReadinessSigningMode, "run_token": env["PARLOR_DSC01_RUN_TOKEN"] ?? "",
                        "process_boot": self.boot, "boot_ordinal": number, "action": action,
                        "loaded_app_images": images.app, "loaded_compose_framework": images.framework,
                        "loader_environment": try nativeReadinessLoaderEnvironment(), "observation_sequence": last.ordinal,
                        "observation": observation]
                    let encoded = try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys])
                    guard encoded.count <= 24576 else { throw self.fixtureError() }
                    let url = FileManager.default.temporaryDirectory.appendingPathComponent(
                        "parlor-l08-host-\(number)-\(action).json")
                    guard !FileManager.default.fileExists(atPath: url.path) else { throw self.fixtureError() }
                    try encoded.write(to: url, options: [.withoutOverwriting])
                    self.l08HostIndex += 1
                    self.l08HostDisplay = String(decoding: encoded, as: UTF8.self)
                } catch {
                    self.l08HostDisplay = "bounded-receipt-failed"
                }
            }
        }
    }
}

private struct L08HostControls: View {
    @ObservedObject var probe: DSC01Probe
    var body: some View {
        HStack {
            Button("Next host fixture step") { probe.nextL08HostCommand() }
                .accessibilityIdentifier("l08-host-next")
            Text("L08 host result").accessibilityIdentifier("l08-host-result").accessibilityValue(probe.l08HostDisplay)
        }
    }
}
