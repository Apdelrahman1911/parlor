+                lane.require = Mock(side_effect=receipt)
+                with self.assertRaises(RuntimeError):
+                    lane.verify_notice_packages(Path('/built'), Path('/installed'))
+                self.assertNotEqual('PASS', lane.receipt['notice_package_status'])
