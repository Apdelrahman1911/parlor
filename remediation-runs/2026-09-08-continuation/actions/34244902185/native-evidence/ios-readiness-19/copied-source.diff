+    private func nativeObservation(_ child: UIViewController?) -> DSC01NativeObservation {
+        // Every captured identity is weak and write-once. This instrumentation
+        // cannot keep a removed controller alive or rebase after replacement.
+        if let child, !capturedCompose { firstCompose = child; capturedCompose = true }
+        let outerView = controller?.viewIfLoaded
+        let composeView = child?.viewIfLoaded
+        if let outerView, let composeView, !capturedViews {
+            firstOuterView = outerView; firstComposeView = composeView; capturedViews = true
+        }
+        let window = outerView?.window
+        if let window, composeView?.window === window, !capturedWindow {
+            firstWindow = window; capturedWindow = true
+        }
+        var geometry: DSC01Geometry?
+        if let outerView, let composeView, let window, composeView.window === window {
+            let orientation: String
+            switch window.windowScene?.interfaceOrientation {
+            case .portrait: orientation = "portrait"
+            case .landscapeLeft, .landscapeRight: orientation = "landscape"
+            default: orientation = "other"
+            }
+            // Read-only public UIKit geometry. No layoutIfNeeded, forced view
+            // loading, lifecycle callback, semantic setter or direction repair.
+            geometry = DSC01Geometry(windowBounds: dsc01Rectangle(window.bounds),
+                outerBounds: dsc01Rectangle(outerView.bounds), composeBounds: dsc01Rectangle(composeView.bounds),
+                outerInWindow: dsc01Rectangle(outerView.convert(outerView.bounds, to: window)),
+                composeInWindow: dsc01Rectangle(composeView.convert(composeView.bounds, to: window)),
+                composeFrameInOuter: dsc01Rectangle(composeView.frame),
+                windowSafeArea: dsc01Insets(window.safeAreaInsets),
+                outerSafeArea: dsc01Insets(outerView.safeAreaInsets),
+                composeSafeArea: dsc01Insets(composeView.safeAreaInsets), orientation: orientation)
+        }
+        return DSC01NativeObservation(
+            sameOuterController: controller != nil && controller === firstOuter,
+            sameComposeController: child != nil && child === firstCompose,
+            sameOuterView: outerView != nil && outerView === firstOuterView,
+            sameComposeView: composeView != nil && composeView === firstComposeView,
+            childParentIsOuter: child != nil && controller != nil && child?.parent === controller,
+            singleComposeChild: controller?.children.count == 1 && controller?.children.first === child,
+            directSubview: outerView != nil && composeView != nil && composeView?.superview === outerView,
+            sameWindow: window != nil && composeView?.window === window && window === firstWindow,
+            attachments: Int(MainViewControllerKt.DSC01UIKitAttachmentCount()),
+            disposals: Int(MainViewControllerKt.DSC01UIKitDisposalCount()),
+            outerDirection: dsc01Direction(outerView), geometry: geometry)
+    }
+
+    private func publishObservation(_ observation: DSC01Observation) throws {
+        guard let value = report, let beforeMain else { throw fixtureError() }
+        let window: [[String: Any]] = try samplingRows.map { sample -> [String: Any] in
+            ["sequence": sample.ordinal, "boot": sample.boot,
+             "controllerCreations": sample.controllerCreations, "nativeDirection": sample.nativeDirection,
+             "native": sample.native.compact,
+             "now": try JSONSerialization.jsonObject(with: JSONEncoder().encode(sample.preferences)),
+             "composition": try JSONSerialization.jsonObject(with: Data(sample.composition.utf8)),
+             "index": sample.samplingIndex, "elapsedMilliseconds": sample.samplingElapsedMilliseconds]
+        }
+        // Fixed-schema public synthetic settings ONLY: no stores, game state,
+        // seeds, role maps, credentials, diagnostics, or accessibility secrets.
+        let payload: [String: Any] = [
+            "sequence": value.observations.count, "boot": boot, "completed": value.completed,
+            "beforeMain": try JSONSerialization.jsonObject(with: JSONEncoder().encode(beforeMain)),
+            "now": try JSONSerialization.jsonObject(with: JSONEncoder().encode(observation.preferences)),
+            "nativeDirection": observation.nativeDirection, "controllerCreations": controllerCreations,
+            "native": observation.native.compact,
+            "composition": try JSONSerialization.jsonObject(with: Data(observation.composition.utf8)),
+            "scenario": scenario, "osDisposition": osDisposition,
+            "sampling": ["ordinal": samplingOrdinal, "status": samplingStatus,
+                         "context": samplingContext, "samples": window],
+        ]
+        let displayData = try JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys])
+        guard displayData.count <= 8192 else { throw fixtureError() }
+        display = String(decoding: displayData, as: UTF8.self)
+    }
+
+    private func preferences() throws -> DSC01Preferences {
+        let domain = UserDefaults.standard.persistentDomain(forName: appID) ?? [:]
+        let rawSetting = domain["language_override"]
+        let setting = rawSetting as? String ?? "system"
+        guard rawSetting == nil || ["en", "ar"].contains(setting) else { throw fixtureError() }
+        let languages = try safeLanguages(domain["AppleLanguages"])
+        let owner = domain[ownerKey] as? [String: Any]
+        guard domain[ownerKey] == nil || owner != nil else { throw fixtureError() }
+        var installed = "none"
+        var previous: [String] = []
+        if let owner {
+            guard Set(owner.keys).isSubset(of: ["version", "installed", "previous"]),
+                  owner["version"] as? String == "1", let tag = owner["installed"] as? String,
+                  ["en", "ar"].contains(tag) else { throw fixtureError() }
+            installed = tag; previous = try safeLanguages(owner["previous"])
+        }
+        let preferred = Locale.preferredLanguages.first?.lowercased() ?? "en"
+        let resolved = preferred == "ar" || preferred.hasPrefix("ar-") || preferred.hasPrefix("ar_") ? "ar" : "en"
+        return DSC01Preferences(setting: setting, appLanguages: languages, hasAppOverride: domain["AppleLanguages"] != nil,
+                                ownerPresent: owner != nil, ownerInstalled: installed,
+                                ownerPreviousPresent: owner?["previous"] != nil, ownerPrevious: previous,
+                                preferredLanguage: resolved)
+    }
+
+    private func safeLanguages(_ value: Any?) throws -> [String] {
+        guard let value else { return [] }
+        guard let items = value as? [String], !items.isEmpty, items.count <= 8,
+              items.allSatisfy({ $0.utf8.count <= 35 && $0.range(of: "^(en|ar)(-[A-Za-z0-9]{2,8})*$", options: .regularExpression) != nil }) else {
+            throw fixtureError()
+        }
+        return items
+    }
+
+    private func fixtureError() -> NSError { NSError(domain: "DSC01SyntheticHarness", code: 1) }
+}
