#if DEBUG && targetEnvironment(simulator)
import XCTest
import Foundation

/// COPY ONLY. Two read-only equivalent queries AFTER the original failed
/// waiter and native capture. Never a tap, input repair, retry or new waiter.
private enum PIN29EquivalentQuery {
    @MainActor
    static func capture(_ original: XCUIElement, equivalent: XCUIElement,
                        app: XCUIApplication, kind: Int, expected: String? = nil) {
        guard (1...3).contains(kind),
              let token = app.launchEnvironment["PARLOR_PIN02_TOKEN"],
              UUID(uuidString: token)?.uuidString == token else { return }
        let rows = [read(original, expected: expected), read(equivalent, expected: expected)]
        let report: [String: Any] = ["schema": 1, "token": token, "kind": kind,
            "originalWaiterFailed": true, "order": "retained-then-equivalent", "rows": rows]
        guard let raw = try? JSONSerialization.data(withJSONObject: report, options: [.sortedKeys]),
              raw.count <= 16384 else { return }
        let attachment = XCTAttachment(data: raw, uniformTypeIdentifier: "public.json")
        attachment.name = "PIN29 failure-only equivalent public query"
        attachment.lifetime = .keepAlways
        XCTContext.runActivity(named: "Failure-only equivalent query (not a correction)") {
            $0.add(attachment)
        }
    }

    @MainActor
    private static func read(_ control: XCUIElement, expected: String?) -> [String: Any] {
        let started = ProcessInfo.processInfo.systemUptime * 1000
        var row: [String: Any] = ["startedMs": started, "snapshotPresent": false,
            "enabled": NSNull(), "frame": [], "geometryValid": false,
            "stringValue": NSNull(), "empty": NSNull(), "exact": NSNull(), "errorCode": NSNull()]
        do {
            let snapshot = try control.snapshot() // One native snapshot per reference.
            let frame = snapshot.frame
            let geometry = [Double(frame.origin.x), Double(frame.origin.y),
                            Double(frame.size.width), Double(frame.size.height)]
            let valid = geometry.allSatisfy { $0.isFinite && abs($0) <= 100000 }
                && frame.size.width >= 0 && frame.size.height >= 0
            row["snapshotPresent"] = true
            row["enabled"] = snapshot.isEnabled
            row["geometryValid"] = valid
            row["frame"] = valid ? geometry : []
            if let expected {
                // Public synthetic Name only. Never retain characters or lengths.
                let value = snapshot.value as? String
                row["stringValue"] = value != nil
                row["empty"] = value?.isEmpty == true
                row["exact"] = value == expected
            }
        } catch {
            row["errorCode"] = (error as NSError).code // No description/content.
        }
        row["finishedMs"] = ProcessInfo.processInfo.systemUptime * 1000
        return row
    }
}
#endif
