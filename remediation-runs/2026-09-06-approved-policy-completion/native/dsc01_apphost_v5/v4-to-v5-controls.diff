+    @MainActor private func collectPassiveWindow(_ app: XCUIApplication) throws -> [[String: Any]] {
+        let previous = try dictionary(try readDisplayedObservation(app), "sampling")
+        let ordinal = try XCTUnwrap(previous["ordinal"] as? Int)
+        app.buttons["parlor-dsc01-window"].tap()
