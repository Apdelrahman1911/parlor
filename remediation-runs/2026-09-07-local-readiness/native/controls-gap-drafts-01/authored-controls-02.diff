+private func nativeReadinessRelative(_ path: String, root: String) throws -> String? {
+    guard path.hasPrefix(root + "/") else { return nil }
+    let relative = String(path.dropFirst(root.count + 1))
+    guard !relative.isEmpty, relative.utf8.count <= 512,
+          !relative.split(separator: "/", omittingEmptySubsequences: false).contains(where: {
+              $0.isEmpty || $0 == "." || $0 == ".."
+          }), !relative.unicodeScalars.contains(where: { $0.value < 32 || $0.value == 127 || $0.value == 92 }) else {
+        throw nativeReadinessImageError(1)
+    }
+    return relative
+}
