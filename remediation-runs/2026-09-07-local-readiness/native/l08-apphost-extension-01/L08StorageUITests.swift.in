// Explicit new scenarios; not upgrades to prior eight-launch health claims.
extension IOSAppLaunchUITests {
    @MainActor private func verifyL08RealStoreResume(_ app: XCUIApplication) throws {
        var boots = Set<String>()
        for ordinal in 1...13 {
            app.launchEnvironment["PARLOR_L08_STORAGE_BOOT"] = String(ordinal)
            try startScenario(app, name: "l08-storage")
            let initial = try observe(app)
            let boot = try string(initial, "boot")
            XCTAssertTrue(boots.insert(boot).inserted, "Every checkpoint recovery must be a different process")
            try assertNative(initial)
            var actions: [String] = []
            if [1, 3, 5, 7].contains(ordinal) {
                _ = try l08StorageAction(app, action: "save", ordinal: ordinal, boot: boot)
                actions = ["save"]
            } else if [2, 4, 6, 8, 10].contains(ordinal) {
                let aliases = [2: "wc", 4: "we", 6: "mon", 8: "moff", 10: "legacy"]
                let load = ordinal == 10 ? "legacy-load" : "load"
                _ = try l08StorageAction(app, action: load, ordinal: ordinal, boot: boot)
                try l08TapExactPublicControl(app, identifier: "l08-home-" + aliases[ordinal]!)
                _ = try l08StorageAction(app, action: "continue", ordinal: ordinal, boot: boot)
                actions = [load, "continue"]
            } else if ordinal == 9 {
                _ = try l08StorageAction(app, action: "legacy-seed", ordinal: ordinal, boot: boot)
                actions = ["legacy-seed"]
            } else if [11, 12].contains(ordinal) {
                let check = ordinal == 11 ? "legacy-neighbor" : "dual-preserved"
                let alias = ordinal == 11 ? "damaged" : "dual"
                _ = try l08StorageAction(app, action: check, ordinal: ordinal, boot: boot)
                try l08TapExactPublicControl(app, identifier: "l08-home-" + alias)
                try l08WaitRecovery(app, shows: 1)
                try l08TapExactPublicControl(app, identifier: "l08-recovery-retry")
                try l08WaitRecovery(app, shows: 2)
                try l08TapExactPublicControl(app, identifier: "l08-recovery-discard")
                _ = try l08StorageAction(app, action: "discard-observed", ordinal: ordinal, boot: boot)
                actions = [check, "discard-observed"]
            } else {
                _ = try l08StorageAction(app, action: "final-absence", ordinal: ordinal, boot: boot)
                actions = ["final-absence"]
            }
            let row: [String: Any] = ["schema_version": 1, "boot_ordinal": ordinal, "process_boot": boot,
                "actions": actions, "foreground": app.state == .runningForeground,
                "alert_present": app.alerts.firstMatch.exists,
                "run_token": app.launchEnvironment["PARLOR_DSC01_RUN_TOKEN"] ?? ""]
            let encoded = try JSONSerialization.data(withJSONObject: row, options: [.sortedKeys])
            XCTAssertLessThanOrEqual(encoded.count, 2048)
            print("PARLOR_L08_STORAGE_BOOT " + String(decoding: encoded, as: UTF8.self))
        }
        app.buttons["parlor-dsc01-complete"].tap()
        XCTAssertEqual(try observe(app)["completed"] as? Bool, true)
        app.launchEnvironment.removeValue(forKey: "PARLOR_L08_STORAGE_BOOT")
    }

    @MainActor private func l08StorageAction(_ app: XCUIApplication, action: String,
                                            ordinal: Int, boot: String) throws -> [String: Any] {
        try l08TapExactPublicControl(app, identifier: "l08-action-" + action)
        let state = app.staticTexts["l08-storage-result"]
        XCTAssertTrue(state.waitForExistence(timeout: 10))
        let done = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
            guard let text = state.value as? String, !["pending", "running"].contains(text) else { return false }
            guard let bytes = text.data(using: .utf8), bytes.count <= 16384,
                  let value = (try? JSONSerialization.jsonObject(with: bytes)) as? [String: Any] else { return true }
            return value["action"] as? String == action
        }, object: nil)
        XCTAssertEqual(XCTWaiter.wait(for: [done], timeout: 75), .completed)
        let bytes = try XCTUnwrap((state.value as? String)?.data(using: .utf8))
        XCTAssertLessThanOrEqual(bytes.count, 16384)
        let value = try XCTUnwrap(JSONSerialization.jsonObject(with: bytes) as? [String: Any])
        XCTAssertEqual(value["process_boot"] as? String, boot)
        XCTAssertEqual(value["boot_ordinal"] as? Int, ordinal)
        XCTAssertEqual(value["action"] as? String, action)
        XCTAssertEqual(value["run_token"] as? String, app.launchEnvironment["PARLOR_DSC01_RUN_TOKEN"])
        let result = try dictionary(value, "observation")
        XCTAssertEqual(result["status"] as? String, "PASS")
        XCTAssertEqual(result["physical_or_store_evidence"] as? Bool, false)
        XCTAssertEqual(app.state, .runningForeground)
        XCTAssertFalse(app.alerts.firstMatch.exists)
        return value
    }

    @MainActor private func l08TapExactPublicControl(_ app: XCUIApplication, identifier: String) throws {
        XCTAssertTrue(identifier.hasPrefix("l08-"))
        let query = app.descendants(matching: .any).matching(identifier: identifier)
        XCTAssertTrue(query.firstMatch.waitForExistence(timeout: 15))
        XCTAssertEqual(query.count, 1)
        let target = query.firstMatch
        let ready = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
            target.exists && target.isEnabled && target.isHittable
        }, object: nil)
        XCTAssertEqual(XCTWaiter.wait(for: [ready], timeout: 15), .completed)
        target.tap() // No alternate selector, coordinate fallback, or repeat activation.
    }

    @MainActor private func l08WaitRecovery(_ app: XCUIApplication, shows: Int) throws {
        // Observe completion of the actual asynchronous resume coordinator, not
        // merely that an old Retry/Discard button survived recomposition.
        for _ in 0..<24 {
            try l08TapExactPublicControl(app, identifier: "l08-ui-observe")
            let node = app.staticTexts["l08-ui-result"]
            let data = try XCTUnwrap((node.value as? String)?.data(using: .utf8))
            XCTAssertLessThanOrEqual(data.count, 1024)
            let value = try XCTUnwrap(JSONSerialization.jsonObject(with: data) as? [String: Any])
            if value["recovery_shows"] as? Int == shows { return }
            let interval = XCTestExpectation(description: "L08 bounded recovery observation")
            DispatchQueue.main.asyncAfter(deadline: .now() + 0.2) { interval.fulfill() }
            XCTAssertEqual(XCTWaiter.wait(for: [interval], timeout: 2), .completed)
        }
        XCTFail("Original resume coordinator did not retain the expected failed-recovery route")
        throw NSError(domain: "L08RecoveryObservation", code: 1)
    }
}
