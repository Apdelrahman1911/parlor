// Synthetic host-Foundation controls only. No dyld/runtime-app or device claim.
// Python prepends the EXACT production-copy helpers and loader observer.
private let fixtureRoot = __PARLOR_PATH_FIXTURE_ROOT__
private let nativeReadinessTaskRoot = fixtureRoot + "/allocation"

private let productRoot = nativeReadinessTaskRoot + "/copy/composeApp/build"
private let appRoot = fixtureRoot + "/installed/Parlor.app"
private let productRelative = "xcode-frameworks/Debug/iphonesimulator26.5/ComposeApp.framework/ComposeApp"
private let productImage = productRoot + "/" + productRelative
private let appRelative = "Frameworks/ComposeApp.framework/ComposeApp"
private let appImage = appRoot + "/" + appRelative
private var passed = [String]()
private var currentCase = "context"
private var fingerprintCalls = 0

private func check(_ condition: Bool) throws {
    guard condition else { throw NSError(domain: "NativePathControl", code: 1) }
}

private func runCase(_ name: String, _ action: () throws -> Void) throws {
    currentCase = name
    try check(!passed.contains(name))
    try action()
    passed.append(name)
}

private func ownedError(_ expected: Int, _ action: () throws -> Void) throws {
    do {
        try action()
    } catch {
        let value = error as NSError
        try check(value.domain == "NativeReadinessOwnedImage" && value.code == expected)
        return
    }
    throw NSError(domain: "NativePathControl", code: 2)
}

private func canonical(_ raw: String) throws -> String {
    guard let path = try nativeReadinessCanonicalDyldPath(raw) else {
        throw NSError(domain: "NativePathControl", code: 3)
    }
    return path
}

private func inspect(_ raw: String) throws -> (origin: String, path: String, bytes: Int, sha256: String) {
    try nativeReadinessInspectFramework(canonical(raw), appRoot: appRoot, productRoot: productRoot) { url in
        fingerprintCalls += 1
        // The test callback deliberately never opens content. It proves the
        // actual helper's ownership decision occurs BEFORE invoking a reader.
        try check(url.path.hasPrefix(productRoot + "/") || url.path == appImage)
        return (7, "synthetic-no-content-read")
    }
}

private func withoutPrivate(_ path: String) throws -> String {
    try check(path.hasPrefix("/private/var/"))
    return String(path.dropFirst("/private".count))
}

do {
    try check(CommandLine.arguments.count == 1)
    try check(fixtureRoot.hasPrefix("/private/var/"))
    try check(try nativeReadinessCanonicalOwnedRoot(fixtureRoot) == fixtureRoot)

    try runCase("legacy-foundation-alias-witness-and-canonical-repair") {
        let foundation = URL(fileURLWithPath: productImage).resolvingSymlinksInPath().path
        try check(foundation == withoutPrivate(productImage))
        try check(try nativeReadinessRelative(foundation, root: productRoot) == nil)
        try check(try canonical(foundation) == productImage)
        let actual = try inspect(foundation)
        try check(actual.origin == "owned-copy-build" && actual.path == productRelative)
    }
    try runCase("canonical-and-alias-product-identities") {
        for raw in [productImage, try withoutPrivate(productImage)] {
            let prior = fingerprintCalls
            let actual = try inspect(raw)
            try check(actual.origin == "owned-copy-build" && actual.path == productRelative)
            try check(actual.bytes == 7 && actual.sha256 == "synthetic-no-content-read")
            try check(fingerprintCalls == prior + 1)
        }
    }
    try runCase("installed-app-identity") {
        for raw in [appImage, try withoutPrivate(appImage)] {
            let actual = try inspect(raw)
            try check(actual.origin == "installed-app-bundle" && actual.path == appRelative)
        }
    }
    try runCase("kgp-built-products-link-stays-owned-copy-build") {
        let raw = nativeReadinessTaskRoot + "/DerivedData/Build/Products/Debug-iphonesimulator/ComposeApp.framework/ComposeApp"
        try check(try canonical(raw) == productImage)
        let actual = try inspect(raw)
        try check(actual.origin == "owned-copy-build" && actual.path == productRelative)
    }
    try runCase("literal-roots-must-remain-canonical") {
        try check(try nativeReadinessCanonicalOwnedRoot(nativeReadinessTaskRoot) == nativeReadinessTaskRoot)
        try check(try nativeReadinessCanonicalOwnedRoot(productRoot) == productRoot)
        try ownedError(23) { _ = try nativeReadinessCanonicalOwnedRoot(withoutPrivate(productRoot)) }
        try ownedError(23) { _ = try nativeReadinessCanonicalOwnedRoot(fixtureRoot + "/relocated-root") }
        try ownedError(23) { _ = try nativeReadinessCanonicalOwnedRoot(fixtureRoot + "/missing-root") }
    }
    try runCase("sibling-prefix-rejected-before-fingerprint") {
        let prior = fingerprintCalls
        try ownedError(13) { _ = try inspect(productRoot + "-sibling/ComposeApp.framework/ComposeApp") }
        try check(fingerprintCalls == prior)
    }
    try runCase("symlink-escape-rejected-before-fingerprint") {
        let prior = fingerprintCalls
        try ownedError(13) { _ = try inspect(productRoot + "/escape/ComposeApp.framework/ComposeApp") }
        try check(fingerprintCalls == prior)
    }
    try runCase("parent-traversal-rejected-before-fingerprint") {
        let prior = fingerprintCalls
        try ownedError(13) { _ = try inspect(productRoot + "/../build-sibling/ComposeApp.framework/ComposeApp") }
        try check(fingerprintCalls == prior)
    }
    try runCase("unknown-origin-rejected-before-fingerprint") {
        let prior = fingerprintCalls
        try ownedError(13) { _ = try inspect(fixtureRoot + "/unknown/ComposeApp.framework/ComposeApp") }
        try check(fingerprintCalls == prior)
    }
    try runCase("other-owned-output-is-not-a-framework-origin") {
        let prior = fingerprintCalls
        try ownedError(24) { _ = try inspect(productRoot + "/other/ComposeApp.framework/ComposeApp") }
        try check(fingerprintCalls == prior)
    }
    try runCase("wrong-app-relative-framework-rejected") {
        let prior = fingerprintCalls
        try ownedError(12) { _ = try inspect(appRoot + "/Other/ComposeApp.framework/ComposeApp") }
        try check(fingerprintCalls == prior)
    }
    try runCase("absent-noncandidate-skipped-but-absent-compose-fatal") {
        try check(try nativeReadinessCanonicalDyldPath(fixtureRoot + "/missing-system.dylib") == nil)
        try ownedError(21) { _ = try nativeReadinessCanonicalDyldPath(fixtureRoot + "/missing/ComposeApp") }
    }
    try runCase("bounded-input-and-canonical-target-validation") {
        for raw in ["", "relative", "/invalid\0suffix", "/invalid\npath", "/invalid\\path", "/" + String(repeating: "x", count: 4096)] {
            try ownedError(20) { _ = try nativeReadinessCanonicalPath(raw) }
        }
        try ownedError(22) { _ = try nativeReadinessCanonicalPath(fixtureRoot + "/unsafe-target-link") }
    }
    try runCase("relative-component-and-size-guards-retained") {
        for tail in ["", "../x", "./x", "x//y", "x\\y", "x\ny", String(repeating: "x", count: 513)] {
            try ownedError(1) { _ = try nativeReadinessRelative(productRoot + "/" + tail, root: productRoot) }
        }
        try check(try nativeReadinessRelative(productRoot + "-sibling/x", root: productRoot) == nil)
    }
    try runCase("allowed-relative-shapes-stay-strict") {
        for relative in [productRelative, "bin/iosSimulatorArm64/debugFramework/composeApp.framework/ComposeApp",
                         "xcode-frameworks/Debug/iphonesimulator26/ComposeApp.framework/ComposeApp"] {
            try check(nativeReadinessOwnedFrameworkRelative(relative))
        }
        for relative in ["bin/iosArm64/debugFramework/ComposeApp.framework/ComposeApp",
                         "bin/iosSimulatorArm64/releaseFramework/ComposeApp.framework/ComposeApp",
                         "xcode-frameworks/Release/iphonesimulator26.5/ComposeApp.framework/ComposeApp",
                         "xcode-frameworks/Debug/iphonesimulator/ComposeApp.framework/ComposeApp",
                         "xcode-frameworks/Debug/iphonesimulator26x5/ComposeApp.framework/ComposeApp",
                         "xcode-frameworks/Debug/iphonesimulator26.5/Other.framework/ComposeApp",
                         "xcode-frameworks/Debug/iphonesimulator26.5/ComposeApp.framework/Other",
                         "../" + productRelative, "/" + productRelative] {
            try check(!nativeReadinessOwnedFrameworkRelative(relative))
        }
    }
    try runCase("loader-paths-canonicalized-with-unavailable-and-unknown-redacted") {
        let relative = "copy/composeApp/build/xcode-frameworks/Debug/iphonesimulator26.5"
        let directory = nativeReadinessTaskRoot + "/" + relative
        let value = try nativeReadinessLoaderEnvironment([
            "DYLD_FRAMEWORK_PATH": try withoutPrivate(directory) + ":" + fixtureRoot + "/unknown",
            "DYLD_LIBRARY_PATH": fixtureRoot + "/missing-loader-directory:relative",
            "DYLD_FALLBACK_FRAMEWORK_PATH": ""])
        guard let frameworks = value["DYLD_FRAMEWORK_PATH"] as? [String: Any],
              let libraries = value["DYLD_LIBRARY_PATH"] as? [String: Any],
              let fallback = value["DYLD_FALLBACK_FRAMEWORK_PATH"] as? [String: Any],
              let absent = value["DYLD_FALLBACK_LIBRARY_PATH"] as? [String: Any] else {
            throw NSError(domain: "NativePathControl", code: 4)
        }
        try check(frameworks["task_owned_paths"] as? [String] == [relative])
        try check(frameworks["redacted_entry_count"] as? Int == 1 && frameworks["present"] as? Bool == true)
        try check(libraries["task_owned_paths"] as? [String] == [] && libraries["redacted_entry_count"] as? Int == 2)
        try check(fallback["present"] as? Bool == true && fallback["redacted_entry_count"] as? Int == 1)
        try check(absent["present"] as? Bool == false && absent["redacted_entry_count"] as? Int == 0)
    }
    try runCase("loader-count-entry-and-total-bounds-retained") {
        try ownedError(15) { _ = try nativeReadinessLoaderEnvironment(["DYLD_LIBRARY_PATH": String(repeating: "x", count: 16385)]) }
        try ownedError(16) { _ = try nativeReadinessLoaderEnvironment(["DYLD_LIBRARY_PATH": Array(repeating: "x", count: 33).joined(separator: ":")]) }
        try ownedError(17) { _ = try nativeReadinessLoaderEnvironment(["DYLD_LIBRARY_PATH": String(repeating: "x", count: 4097)]) }
    }
    try runCase("eligible-fingerprint-errors-remain-fatal") {
        var attempted = false
        do {
            _ = try nativeReadinessInspectFramework(productImage, appRoot: appRoot, productRoot: productRoot) { _ in
                attempted = true
                throw NSError(domain: "SyntheticFingerprintFailure", code: 79)
            }
            throw NSError(domain: "NativePathControl", code: 5)
        } catch {
            let failure = error as NSError
            try check(attempted && failure.domain == "SyntheticFingerprintFailure" && failure.code == 79)
        }
    }
    let record: [String: Any] = ["schema_version": 1, "status": "PASS", "cases": passed,
        "host_foundation_only": true, "physical_or_app_runtime_evidence": false,
        "unknown_origin_fingerprint_calls": 0]
    let bytes = try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys])
    try check(bytes.count <= 8192)
    print(String(decoding: bytes, as: UTF8.self))
} catch {
    // Never serialize the NSError description, a supplied path, or userInfo.
    let failure = error as NSError
    let domain = failure.domain == "NativeReadinessOwnedImage" ? 1 : failure.domain == "NativePathControl" ? 2 : 0
    let record: [String: Any] = ["schema_version": 1, "status": "FAIL", "case": currentCase,
        "error_domain_id": domain, "error_code": domain == 0 ? 0 : failure.code]
    if let bytes = try? JSONSerialization.data(withJSONObject: record, options: [.sortedKeys]) {
        print(String(decoding: bytes, as: UTF8.self))
    }
    exit(1)
}
