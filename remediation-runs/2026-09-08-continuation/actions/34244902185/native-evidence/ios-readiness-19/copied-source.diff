+        retained()
+    }
+
+    fun runtimeClosed() { check(checkNotNull(capturedRuntime).scope.coroutineContext[Job]?.isCompleted == true) }
+    fun release() { baseline = null; canonical = null; controller = null; capturedRuntime = null }
