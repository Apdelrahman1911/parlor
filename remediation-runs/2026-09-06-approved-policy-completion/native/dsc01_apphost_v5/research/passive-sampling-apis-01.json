                      "type": "text"
                    },
                    {
                      "identifier": "doc://com.apple.dispatch/documentation/Dispatch/DispatchTime/distantFuture",
                      "isActive": true,
                      "type": "reference"
                    },
                    {
                      "text": "; doing so is undefined.",
                      "type": "text"
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "name": "deadline"
            },
            {
              "content": [
                {
                  "inlineContent": [
                    {
                      "text": "The quality-of-service class to use when executing the block. This parameter determines the priority with which the block is scheduled and executed. For a list of possible values, see ",
                      "type": "text"
                    },
                    {
                      "identifier": "doc://com.apple.dispatch/documentation/Dispatch/DispatchQoS",
                      "isActive": true,
                      "type": "reference"
                    },
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "name": "qos"
            },
            {
              "content": [
                {
                  "inlineContent": [
                    {
                      "text": "Additional attributes to apply when executing the block. For a list of possible values, see ",
                      "type": "text"
                    },
