              {
                "identifier": "doc://com.apple.xcuiautomation/documentation/XCUIAutomation/XCUIElement/isHittable",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " returns ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.documentation/documentation/Swift/true",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " if the element exists and can be clicked, tapped, or pressed at its current location. It returns ",
