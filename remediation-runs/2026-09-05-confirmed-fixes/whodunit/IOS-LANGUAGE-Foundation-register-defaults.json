    {
      "text": "Specifies the set of default settings and values to use as a fallback in cases",
      "type": "text"
    },
    {
      "text": " ",
      "type": "text"
    },
    {
      "text": "where the app domain doesn\u2019t have them.",
      "type": "text"
    }
  ],
