          "type": "heading"
        },
        {
          "inlineContent": [
            {
              "text": "If your container view controller derives its status bar style from one of its child view controllers, implement this method and return that child view controller. If you return ",
              "type": "text"
            },
            {
              "code": "nil",
              "type": "codeVoice"
            },
            {
              "text": " or do not override this method, the status bar style for ",
              "type": "text"
            },
            {
              "code": "self",
              "type": "codeVoice"
            },
            {
              "text": " is used. If the return value from this method changes, call the ",
              "type": "text"
            },
            {
              "identifier": "doc://com.apple.uikit/documentation/UIKit/UIViewController/setNeedsStatusBarAppearanceUpdate()",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": " method.",
              "type": "text"
            }
          ],
          "type": "paragraph"
