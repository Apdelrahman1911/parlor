+        val identity = case.envelope.contentIdentity()
+        return offer.caseId == case.envelope.caseId && offer.modeId == WhodunitIds.ClassicVoteModeId.raw &&
+            offer.caseVersion == identity.version && offer.caseDigest == identity.digest
+    }
+
+    fun started(): Boolean {
+        val value = runtime ?: return false
+        val state = checkNotNull(value.session.canonicalState).value
+        return value.startGate.value == HostStartGateState.Started && state.phase == WhodunitPhase.PublicIntro &&
+            owned.room.selfPlayerId in state.public.introAcknowledged
+    }
+
+    fun capture() {
+        check(!captured && started())
+        val value = checkNotNull(runtime)
+        val state = checkNotNull(value.session.canonicalState).value
+        check(state.players.size == 6 && state.privatePerPlayer.size == 6 && state.public.timer == null)
+        capturedRuntime = value
+        controller = value.session
+        canonical = value.session.canonicalState
+        baseline = state
+        captured = true
+        retained()
+    }
+
+    fun retained() {
+        val value = checkNotNull(capturedRuntime)
+        val initial = checkNotNull(baseline)
+        check(runtime === value && value.session === controller && value.session.canonicalState === canonical)
+        val current = checkNotNull(value.session.canonicalState).value
+        check(current === initial && current == initial)
