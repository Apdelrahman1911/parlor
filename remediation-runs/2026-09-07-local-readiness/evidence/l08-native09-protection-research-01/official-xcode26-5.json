{"abstract":[{"text":"Update your apps to use new features, and test your apps against API changes.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes\/xcode-26_5-release-notes"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"role":"article","roleHeading":"Article","title":"Xcode 26.5 Release Notes"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Xcode 26.5 includes Swift 6.3 and SDKs for iOS 26.5, iPadOS 26.5, tvOS 26.5, watchOS 26.5, macOS 26.5, and visionOS 26.5.","type":"text"},{"text":" ","type":"text"},{"text":"Xcode 26.5 supports on-device debugging in iOS 15 and later, tvOS 15 and later, watchOS 8 and later, and visionOS.","type":"text"},{"text":" ","type":"text"},{"text":"Xcode 26.5 requires a Mac running macOS Tahoe 26.2 or later.","type":"text"}],"type":"paragraph"},{"anchor":"General","level":3,"text":"General","type":"heading"},{"anchor":"Known-Issues","level":4,"text":"Known Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"When streaming stdout and stderr from multiple processes at the same time (eg: in parallel testing scenarios), the results may be significantly delayed.  (165098287)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Background-Assets","level":3,"text":"Background Assets","type":"heading"},{"anchor":"Known-Issues","level":4,"text":"Known Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"The system may incorrectly determine an app’s eligibility for development overrides in simulator environments.  (173742496)","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Workaround:","type":"text"}],"type":"strong"},{"text":" Test your app on a physical device.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Coding-Intelligence","level":3,"text":"Coding Intelligence","type":"heading"},{"anchor":"New-Features","level":4,"text":"New Features","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Messages can now be queued in the coding assistant.  (174563016)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Agents can now ask clarifying questions to provide more accurate results.  (175182375)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: An issue causing malformed data in RunSomeTests MCP tool call  (170415923)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Fixed: Users interacting with Claude Code might receive an error message about their OAuth token being expired.  (175464325)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Instruments","level":3,"text":"Instruments","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: Typing in the filter field at the bottom of the Symbols window would create a token for every character  (172423349)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Fixed an issue where profiling using Metal System Trace with GPU Counters capture could cause memory footprint of Instruments to increase to tens of gigabytes.  (173195251)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Localization","level":3,"text":"Localization","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: Generated code for String Catalog symbol generation will no longer produce a compiler error for Packages that default to MainActor isolation.  (173302714) (FB22329375)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Security","level":3,"text":"Security","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: Mac (Designed for iPad) apps with pointer authentication are now compatible with macOS Tahoe 26.5 and newer. Add ","type":"text"},{"code":"LSMinimumSystemVersion","type":"codeVoice"},{"text":" with value ","type":"text"},{"code":"26.5","type":"codeVoice"},{"text":" to your app’s Info.plist to ensure the app only runs on Tahoe 26.5 and newer.  (171174887)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Simulator","level":3,"text":"Simulator","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: Pasteboard Synchronization within Simulator.app is currently not functioning.  (173403967) (FB22340739)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"StoreKit-Testing-in-Xcode","level":3,"text":"StoreKit Testing in Xcode","type":"heading"},{"anchor":"New-Features","level":4,"text":"New Features","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"New billing plan APIs can be tested using ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/xcode\/setting-up-storekit-testing-in-xcode","isActive":true,"type":"reference"},{"text":". Configure a monthly with 12-month commitment billing plan for your auto-renewable subscriptions in the StoreKit Configuration, and simulate subscribing to the billing plan through the Transaction Manager in Xcode.  (168522699)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Swift","level":3,"text":"Swift","type":"heading"},{"anchor":"Known-Issues","level":4,"text":"Known Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"When a closure with explicit captures is passed as an argument to a ","type":"text"},{"code":"nonisolated(nonsending)","type":"codeVoice"},{"text":" parameter or","type":"text"},{"text":" ","type":"text"},{"text":"converted to a ","type":"text"},{"code":"nonisolated(nonsending)","type":"codeVoice"},{"text":" type, its isolation was inferred from the parent context instead of","type":"text"},{"text":" ","type":"text"},{"text":"being directly set to ","type":"text"},{"code":"nonisolated(nonsending)","type":"codeVoice"},{"text":". The difference in isolation wasn’t observable by callers","type":"text"},{"text":" ","type":"text"},{"text":"until Swift 6.3.2, which introduced a bug fix for an actor hop optimization that previously didn’t work when","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"nonisolated(nonsending)","type":"codeVoice"},{"text":" function value came from a parameter position.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In particular, this affects projects that have enabled the ","type":"text"},{"code":"NonisolatedNonsendingByDefault","type":"codeVoice"},{"text":" feature (via ","type":"text"},{"code":"ApproachableConcurrency","type":"codeVoice"},{"text":" or directly).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example:","type":"text"}],"type":"paragraph"},{"code":[" @MainActor"," func compute(_ fn: nonisolated(nonsending) @Sendable () async -> Void) async {","   await fn()"," }"," "," func performComputation() async {","   let x: Int = 42","   await compute { [x] in \/\/ closure isolation is inferred to be @concurrent","     print(x)","   }"," }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"In this example, the Swift compiler would no longer hop back to ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" after ","type":"text"},{"code":"await fn()","type":"codeVoice"},{"text":" returns because ","type":"text"},{"code":"fn","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"nonisolated(nonsending)","type":"codeVoice"},{"text":" and should have executed on ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" already, but because the closure isolation","type":"text"},{"text":" ","type":"text"},{"text":"was incorrectly inferred to be ","type":"text"},{"code":"@concurrent","type":"codeVoice"},{"text":", any ","type":"text"},{"inlineContent":[{"text":"synchronous","type":"text"}],"type":"emphasis"},{"text":" calls that follow ","type":"text"},{"code":"fn","type":"codeVoice"},{"text":" one are going to be executed","type":"text"},{"text":" ","type":"text"},{"text":"in a ","type":"text"},{"code":"@concurrent","type":"codeVoice"},{"text":" isolation context instead of the ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" one.  (176582055)","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Workaround:","type":"text"}],"type":"strong"},{"text":" There are multiple ways to work around this issue.","type":"text"}],"type":"paragraph"},{"code":["  1. Remove explicit captures when values could be captured implicitly.","","  The example from Description becomes:\t"],"syntax":null,"type":"codeListing"},{"code":[" func performComputation() async {","   let x: Int = ...","   await compute {","     print(x)","   }"," }"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"text":"Convert a closure into a local function that is explicitly ","type":"text"},{"code":"nonisolated(nonsending)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The example from Description becomes:","type":"text"}],"type":"paragraph"}]}],"start":2,"type":"orderedList"},{"code":[" func performComputation() async {","   let x: Int = ..."," ","   @Sendable nonisolated(nonsending) func performAction() async {","     print(x)","   }"," ","   await compute(performAction)"," }"],"syntax":"swift","type":"codeListing"}]}],"type":"unorderedList"},{"anchor":"Testing","level":3,"text":"Testing","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: Tests fail to run on iOS 15 simulators  (173337319) (FB22333623)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Xcode-26","generated":true,"identifiers":["doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes\/xcode-26_6-release-notes","doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes\/xcode-26_4_1-release-notes","doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes\/xcode-26_4-release-notes","doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes\/xcode-26_3-release-notes","doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes\/xcode-26_2-release-notes","doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes\/xcode-26_1-release-notes","doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes\/xcode-26_0_1-release-notes","doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes\/xcode-26-release-notes"],"title":"Xcode 26"}],"references":{"doc://com.apple.Xcode-Release-Notes/documentation/Xcode-Release-Notes":{"abstract":[{"text":"Learn about changes to Xcode.","type":"text"}],"identifier":"doc:\/\/com.apple.Xcode-Release-Notes\/documentation\/Xcode-Release-Notes","kind":"article","role":"collection","title":"Xcode 