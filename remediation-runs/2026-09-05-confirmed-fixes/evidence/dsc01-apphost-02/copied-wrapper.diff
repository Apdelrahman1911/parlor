+// Appended ONLY to the source-bound temporary Debug simulator ContentView copy.
+// It neither imports a fake SettingsStore nor replaces MainViewController/App.
+#if DEBUG && targetEnvironment(simulator)
+private struct DSC01Preferences: Codable, Equatable {
+    let setting: String
+    let appLanguages: [String]
+    let hasAppOverride: Bool
+    let ownerPresent: Bool
+    let ownerInstalled: String
+    let ownerPreviousPresent: Bool
+    let ownerPrevious: [String]
+    let preferredLanguage: String
+}
+
+private struct DSC01Observation: Codable {
+    let ordinal: Int
+    let phase: String
+    let fixture: String
+    let boot: String
+    let preferences: DSC01Preferences
+    let nativeDirection: String
+    let controllerCreations: Int
+}
+
+private struct DSC01Report: Codable {
+    let schemaVersion: Int
+    let runToken: String
+    var completed: Bool
+    var observations: [DSC01Observation]
+}
+
+// Internal to copied Swift target so iOSApp.init can prepare BEFORE any Koin or
+// Compose initialization (including scenePhase callbacks). Never shipped.
+final class DSC01Probe: ObservableObject {
+    static let shared = DSC01Probe()
+    @Published private(set) var display = "{}"
+    private let boot = UUID().uuidString
+    private var report: DSC01Report?
+    private var beforeMain: DSC01Preferences?
+    private var fixture = ""
+    private var prepared = false
+    private var controllerCreations = 0
+    private weak var controller: UIViewController?
+    private let appID = "com.parlor.app.debug"
+    private let ownerKey = "com.parlor.languageOverrideOwner.v1"
+    private var resultURL: URL {
+        FileManager.default.temporaryDirectory.appendingPathComponent("parlor-dsc01-result.json")
+    }
+
+    func prepare() {
+        precondition(Thread.isMainThread && !prepared, "DSC01 fixture initialization repeated/off-main")
+        let environment = ProcessInfo.processInfo.environment
+        guard Bundle.main.bundleIdentifier == appID,
+              let simulator = environment["SIMULATOR_UDID"], UUID(uuidString: simulator) != nil,
+              simulator == environment["PARLOR_DSC01_EXPECTED_UDID"],
+              let token = environment["PARLOR_DSC01_RUN_TOKEN"], UUID(uuidString: token) != nil,
+              let selected = environment["PARLOR_DSC01_FIXTURE"],
+              ["fresh", "continue", "previous-ar"].contains(selected),
+              !ProcessInfo.processInfo.arguments.contains("-AppleLanguages"),
+              !ProcessInfo.processInfo.arguments.contains("-AppleLocale") else {
+            fatalError("DSC01 requires explicitly owned unsigned Debug simulator context")
+        }
+        fixture = selected
+        do {
+            if selected == "fresh" {
+                guard !FileManager.default.fileExists(atPath: resultURL.path) else { throw fixtureError() }
+                let original = try preferences()
+                guard original.setting == "system", !original.hasAppOverride, !original.ownerPresent else {
+                    throw fixtureError()
+                }
+                report = DSC01Report(schemaVersion: 1, runToken: token, completed: false, observations: [])
+            } else {
+                let size = try FileManager.default.attributesOfItem(atPath: resultURL.path)[.size] as? NSNumber
+                guard let size, size.intValue <= 262144 else { throw fixtureError() }
+                let recovered = try JSONDecoder().decode(DSC01Report.self, from: Data(contentsOf: resultURL))
+                guard recovered.schemaVersion == 1, recovered.runToken == token,
+                      !recovered.completed, recovered.observations.count < 256 else { throw fixtureError() }
+                report = recovered
+                if selected == "previous-ar" {
+                    let beforeSeed = try preferences()
+                    guard beforeSeed.setting == "system", !beforeSeed.hasAppOverride,
+                          !beforeSeed.ownerPresent else { throw fixtureError() }
+                    // Synthetic previous OS-managed preference representation ONLY,
+                    // inside this owned app sandbox. No global prefs or plist edits.
+                    UserDefaults.standard.set(["ar-EG", "en"], forKey: "AppleLanguages")
+                }
+            }
+            beforeMain = try preferences()
+            prepared = true
+            try appendObservation(phase: "before_main")
+        } catch {
+            fatalError("DSC01 synthetic fixture preparation failed; not application defect attribution")
+        }
+    }
+
+    func attach(_ actualController: UIViewController) {
+        precondition(Thread.isMainThread && prepared, "DSC01 observer was not prepared")
+        controllerCreations += 1
+        controller = actualController
+    }
+
+    func sample() {
+        precondition(Thread.isMainThread && prepared)
+        do { try appendObservation(phase: "sample") }
+        catch { display = "{\"harnessError\":\"bounded_observation_failed\"}" }
+    }
+
+    func complete() {
+        precondition(Thread.isMainThread && prepared)
+        do {
+            guard var value = report else { throw fixtureError() }
+            value.completed = true; report = value
+            try appendObservation(phase: "complete")
+        } catch { display = "{\"harnessError\":\"completion_receipt_failed\"}" }
+    }
+
+    private func appendObservation(phase: String) throws {
+        guard var value = report, value.observations.count < 256, let beforeMain else { throw fixtureError() }
+        let now = try preferences()
+        let direction: String
+        if let root = controller?.view {
+            switch root.semanticContentAttribute {
+            case .forceLeftToRight: direction = "force_ltr"
+            case .forceRightToLeft: direction = "force_rtl"
+            case .unspecified: direction = "unspecified"
+            default: direction = "other"
+            }
+        } else { direction = "unavailable" }
+        value.observations.append(DSC01Observation(
+            ordinal: value.observations.count + 1, phase: phase, fixture: fixture,
+            boot: boot, preferences: now, nativeDirection: direction, controllerCreations: controllerCreations
+        ))
+        let encoded = try JSONEncoder().encode(value)
+        guard encoded.count <= 262144 else { throw fixtureError() }
+        try encoded.write(to: resultURL, options: .atomic)
+        report = value
+        // Fixed-schema public synthetic settings ONLY: no stores, game state,
+        // seeds, role maps, credentials, diagnostics, or accessibility secrets.
+        let payload: [String: Any] = [
+            "sequence": value.observations.count, "boot": boot, "completed": value.completed,
+            "beforeMain": try JSONSerialization.jsonObject(with: JSONEncoder().encode(beforeMain)),
+            "now": try JSONSerialization.jsonObject(with: JSONEncoder().encode(now)),
+            "nativeDirection": direction, "controllerCreations": controllerCreations,
+        ]
+        let displayData = try JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys])
+        guard displayData.count <= 4096 else { throw fixtureError() }
+        display = String(decoding: displayData, as: UTF8.self)
+    }
+
+    private func preferences() throws -> DSC01Preferences {
+        let domain = UserDefaults.standard.persistentDomain(forName: appID) ?? [:]
+        let rawSetting = domain["language_override"]
+        let setting = rawSetting as? String ?? "system"
+        guard rawSetting == nil || ["en", "ar"].contains(setting) else { throw fixtureError() }
+        let languages = try safeLanguages(domain["AppleLanguages"])
+        let owner = domain[ownerKey] as? [String: Any]
+        guard domain[ownerKey] == nil || owner != nil else { throw fixtureError() }
+        var installed = "none"
+        var previous: [String] = []
+        if let owner {
+            guard Set(owner.keys).isSubset(of: ["version", "installed", "previous"]),
+                  owner["version"] as? String == "1", let tag = owner["installed"] as? String,
+                  ["en", "ar"].contains(tag) else { throw fixtureError() }
+            installed = tag; previous = try safeLanguages(owner["previous"])
+        }
+        let preferred = Locale.preferredLanguages.first?.lowercased() ?? "en"
+        let resolved = preferred == "ar" || preferred.hasPrefix("ar-") || preferred.hasPrefix("ar_") ? "ar" : "en"
+        return DSC01Preferences(setting: setting, appLanguages: languages, hasAppOverride: domain["AppleLanguages"] != nil,
+                                ownerPresent: owner != nil, ownerInstalled: installed,
+                                ownerPreviousPresent: owner?["previous"] != nil, ownerPrevious: previous,
+                                preferredLanguage: resolved)
+    }
+
+    private func safeLanguages(_ value: Any?) throws -> [String] {
+        guard let value else { return [] }
+        guard let items = value as? [String], [["en"], ["ar"], ["ar-EG", "en"]].contains(items) else {
+            throw fixtureError()
+        }
+        return items
+    }
+
+    private func fixtureError() -> NSError { NSError(domain: "DSC01SyntheticHarness", code: 1) }
+}
+
+private struct DSC01Overlay: View {
+    @ObservedObject private var probe = DSC01Probe.shared
+    var body: some View {
+        HStack(spacing: 8) {
+            Button("Observe") { probe.sample() }.accessibilityIdentifier("parlor-dsc01-observe")
+            Text("DS-C01 observer").accessibilityIdentifier("parlor-dsc01-state").accessibilityValue(probe.display)
+            Button("Complete") { probe.complete() }.accessibilityIdentifier("parlor-dsc01-complete")
+        }
+        .font(.caption2).padding(6).background(Color.black).foregroundColor(.white)
+    }
+}
+#else
+#error("DSC01 temporary observer may compile ONLY as Debug iOS simulator")
+#endif
