              "isActive": true,
              "type": "reference"
            },
            {
              "text": " method of the returned view controller. If the method returns ",
              "type": "text"
            },
            {
              "code": "nil",
              "type": "codeVoice"
            },
            {
              "text": ", the system calls the ",
              "type": "text"
            },
            {
