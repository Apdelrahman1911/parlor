      "title": "ObservedObject",
      "abstract": [
        {
          "text": "A property wrapper type that subscribes to an observable object and",
          "type": "text"
        },
        {
          "text": " ",
          "type": "text"
        },
        {
          "text": "invalidates a view whenever the observable object changes.",
          "type": "text"
        }
      ],
      "platforms": [
        {
          "beta": false,
          "deprecated": false,
          "introducedAt": "13.0",
