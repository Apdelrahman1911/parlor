/ios-readiness/test_foundation_toolchain_binding.py\": \"df030e500c035fc65ede190a8c11b795f7b4a40e2933a86a4b8529b4bdac4c13\",\n    \"scripts/verification/ios-readiness/test_native_command_failures.py\": \"7ea11e97a11cc07ba85d09c1366fe4198b95b8ee59414979fa7801122be981be\",\n    \"scripts/verification/ios-readiness/toolchain_profiles.py\": \"8adacaf4c59ed823aa088ecb70ad5c6c1e3f76e7ca3520d8abf0563341591313\",\n}\n\n\ndef require(value, reason):\n    if not value: raise RuntimeError(reason)\n\n\ndef read(path, limit=4 * 1024 * 1024):\n    require(path.is_absolute() and path.resolve(strict=True) == path, 'redirected input/evidence')\n    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), 'rb') as stream:\n        st = os.fstat(stream.fileno())\n        require(stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid() and st.st_size <= limit, 'invalid/bounded input/evidence')\n        raw = stream.read(limit + 1)\n        require(len(raw) == st.st_size and len(raw) <= limit, 'input changed during read')\n    return raw\n\n\ndef write_new(path, value):\n    with path.open('x') as stream:\n        json.dump(value, stream, indent=2)\n        stream.write('\\n')\n\n\ndestination = ROOT / 'remediation-runs/2026-09-07-local-readiness/evidence' / CYCLE\ntemporary = Path(os.environ['TMPDIR'])\nrequire(sys.platform == 'linux' and sys.dont_write_bytecode and sys.argv == ['-c'], 'fixed Linux -B invocation required')\nrequire(temporary.is_absolute() and temporary == destination / 'scratch/tmp', 'exact coordinated lane required')\nfor path in (temporary, temporary.parent, destination):\n    st = path.lstat()\n    require(path.resolve(strict=True) == path and stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid(), 'lane custody required')\npacket, receipt = json.loads(read(PACKET)), json.loads(read(destination / 'receipt.json'))\nrequire(packet['schema_version'] == 1 and packet['outer_cycle'] == CYCLE and receipt.get('cycle') == CYCLE and\n        receipt.get('status') == 'RUNNING' and packet['command'] == receipt.get('command') == sys.orig_argv,\n        'whole reviewed invocation must appear in the running outer receipt')\nrequire(hashlib.sha256(read(ROOT / HELPER)).hexdigest() == BOUND_PINS[HELPER], 'reviewed helper bytes differ')\nspec = importlib.util.spec_from_file_location('reviewed_continuation_control_helpers', ROOT / HELPER)\nhelpers = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(helpers)\nrequire(helpers.ROOT == ROOT, 'helper source root differs')\n# Only manifest/run_command are reused. Never main(), owned_destination(), native/build entry points or a selector.\n\n\ndef manifest():\n    inherited = helpers.manifest()\n    entries = {row['path']: row['sha256'] for row in inherited}\n    require(len(entries) == len(inherited), 'duplicate inherited inputs')\n    for relative in (*EXTRA_INPUTS, str(PACKET.relative_to(ROOT))):\n        path = Path(relative)\n        require(not path.is_absolute() and '..' not in path.parts and str(path) == relative, 'nonexact extra input')\n        digest = hashlib.sha256(read(ROOT / path)).hexdigest()\n        require(relative not in entries or entries[relative] == digest, 'input changed during manifest')\n        entries[relative] = digest\n    return [dict(path=path, sha256=entries[path]) for path in sorted(entries)]\n\n\ndef external_cleanup(name, rows, before):\n    selected = next((row for row in rows if row['name'] == name), None)\n    if selected is None: return dict(status='NOT_RUN')\n    text = read(destination / selected['log'], 16 * 1024 * 1024).decode('utf-8')\n    def marker(key):\n        prefix = 'PARLOR_APP_FOUNDATION_CONTROL_' + key + ' '\n        values = [json.loads(line[len(prefix):]) for line in text.splitlines() if line.startswith(prefix)]\n        require(len(values) == 1, name + ': exactly one ' + key + ' marker required')\n        return values[0]\n    allocation, cleanup = marker('ALLOCATION'), marker('CLEANUP')\n    require(set(allocation) == {'path', 'device', 'inode', 'uid'}, 'allocation shape')\n    parent = Path(allocation['path'])\n    custody = {key: allocation[key] for key in ('device', 'inode', 'uid')}\n    require(parent.is_absolute() and parent.parent == Path('/tmp').resolve(strict=True) and\n            re.fullmatch(r'parlor-app-foundation-controls-[A-Za-z0-9_-]{1,64}', parent.name) and\n            all(type(value) is int for value in custody.values()) and custody['uid'] == os.getuid() and\n            custody['inode'] > 0 and custody['device'] >= 0, 'external allocation custody/path differs')\n    require(cleanup.get('status') == 'PASS' and cleanup.get('parent') == str(parent) and\n            cleanup.get('parent_removed') is True and cleanup.get('custody') == custody and\n            type(cleanup.get('workers_started')) is int and cleanup['workers_started'] == 0, 'external cleanup not proven')\n    try: parent.lstat()\n    except FileNotFoundError: absent = True\n    else: absent = False\n    require(absent, 'external scratch remains; inspect custody, never prefix-delete')\n    result = dict(status='PASS', allocation=allocation, cleanup=cleanup, parent_absent=True)\n    if name == 'composition' and selected['status'] == 'PASS':\n        observed = marker('RESULTS')\n        count = next(count for label, _, count in COMMANDS if label == name)\n        require(type(observed.get('tests_run')) is int and observed['tests_run'] == count and\n                isinstance(observed.get('discovered'), list) and len(observed['discovered']) == count and\n                all(isinstance(item, str) for item in observed['discovered']) and len(set(observed['discovered'])) == count and\n                all(type(observed.get(key)) is int and observed[key] == 0 for key in ('failures', 'errors')) and\n                observed.get('skipped') == [] and observed.get('native_execution') is False,\n                'composition fixed unskipped results differ')\n        hashes = {row['path']: row['sha256'] for row in before}\n        inputs = ['remediation-runs/2026-09-07-local-readiness/native/' + suffix for suffix in\n                  ('l08-app-foundation-draft-01/test_app_foundation.py', 'l08-app-foundation-composition-01/test_composition.py')]\n        require(observed.get('input_tests') == [dict(path=str(ROOT / path), sha256=hashes[path]) for path in inputs],\n                'composition result/input bytes differ')\n        result['results'] = observed\n    return result\n\n\ndef interrupted(number, _frame):\n    if helpers.FINALIZING or helpers.STOPPING_CHILD: helpers.DEFERRED_SIGNALS.append(number)\n    elif helpers.LAUNCHING: helpers.PENDING_SIGNALS.append(number)\n    else: raise KeyboardInterrupt('signal ' + str(number))\n\n\nsignal.signal(signal.SIGINT, interrupted)\nsignal.signal(signal.SIGTERM, interrupted)\nrows, errors, summaries, external = [], [], {}, {}\nbefore = after = None\npins_match = False\n\n\ndef attempt(stage, operation):\n    try: return operation()\n    except BaseException as error:\n        errors.append(dict(stage=stage, type=type(error).__name__, message=str(error)[:800]))\n        return None\n\n\ntry:\n    before = manifest()\n    write_new(destination / 'native-repair-inputs-before.json', before)\n    hashes = {row['path']: row['sha256'] for row in before}\n    mismatches = [path for path, sha in BOUND_PINS.items() if hashes.get(path) != sha]\n    require(not mismatches, 'frozen expected input bytes differ: ' + ', '.join(mismatches))\n    pins_match = True\n    for name, arguments, _ in COMMANDS:\n        helpers.run_command(destination, name, arguments, rows)\nexcept BaseException as error:\n    errors.append(dict(stage='execution', type=type(error).__name__, message=str(error)[:800]))\nfinally:\n    helpers.FINALIZING = True\n    for row in rows:\n        if row['name'] in ('composition', 'foundation-profile') and row['status'] == 'ERROR':\n            row['external_cleanup_requires_independent_inspection'] = True\n    # All command exits, including nonzero/