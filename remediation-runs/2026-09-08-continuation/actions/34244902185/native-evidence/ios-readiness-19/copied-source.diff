+// Copy-only XCTest proof of exact OS-observed representation, never a writer.
+// Selecting the primary language need not create an app-domain AppleLanguages
+// key. Preserve the actual before-App (presence, array), not an invented value.
+private struct DSC01OSPreferenceValue: Equatable {
+    let present: Bool
+    let languages: [String]
+}
+
+private struct DSC01OSPreferenceBaseline {
+    let value: DSC01OSPreferenceValue
+    let beforeChoiceSequence: Int
+    let beforeChoiceBoot: String
+    let sequence: Int
+    let boot: String
+}
+
+private func dsc01OSPreferenceValue(_ fields: [String: Any]) -> DSC01OSPreferenceValue? {
+    guard let present = fields["hasAppOverride"] as? Bool,
+          let languages = fields["appLanguages"] as? [String], languages.count <= 8,
+          present == !languages.isEmpty,
+          languages.allSatisfy({ $0.utf8.count <= 35 &&
+              $0.range(of: "^(en|ar)(-[A-Za-z0-9]{2,8})*$", options: .regularExpression) != nil }) else { return nil }
+    return DSC01OSPreferenceValue(present: present, languages: languages)
+}
+
+private func dsc01OSUnownedArabic(_ fields: [String: Any]) -> DSC01OSPreferenceValue? {
+    guard fields["setting"] as? String == "system", fields["preferredLanguage"] as? String == "ar",
+          fields["ownerPresent"] as? Bool == false, fields["ownerInstalled"] as? String == "none",
+          fields["ownerPreviousPresent"] as? Bool == false, fields["ownerPrevious"] as? [String] == [],
+          let value = dsc01OSPreferenceValue(fields),
+          !value.present || value.languages.first == "ar" || value.languages.first?.hasPrefix("ar-") == true else { return nil }
+    return value
+}
+
+private func dsc01OSOwnedEnglishMatches(_ fields: [String: Any], _ value: DSC01OSPreferenceValue) -> Bool {
+    fields["setting"] as? String == "en" && fields["preferredLanguage"] as? String == "en" &&
+        fields["hasAppOverride"] as? Bool == true && fields["appLanguages"] as? [String] == ["en"] &&
+        fields["ownerPresent"] as? Bool == true && fields["ownerInstalled"] as? String == "en" &&
+        fields["ownerPreviousPresent"] as? Bool == value.present && fields["ownerPrevious"] as? [String] == value.languages
+}
