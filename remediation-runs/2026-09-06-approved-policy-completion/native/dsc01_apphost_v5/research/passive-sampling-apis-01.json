              "content": [
                {
                  "inlineContent": [
                    {
                      "text": "The time at which to schedule the block for execution. Specifying the current time is less efficient than calling the ",
                      "type": "text"
                    },
                    {
                      "identifier": "doc://com.apple.dispatch/documentation/Dispatch/DispatchQueue/async(execute:)",
                      "isActive": true,
                      "type": "reference"
                    },
