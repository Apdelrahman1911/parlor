      "lines": [
        "int",
        "proc_pidregionpathinfo(proc_t p, uint64_t arg, user_addr_t buffer, __unused uint32_t  buffersize, int32_t *retval)",
        "{",
        "\tstruct proc_regionwithpathinfo preginfo;",
        "\tint ret, error = 0;",
        "\tuintptr_t vnodeaddr = 0;",
        "\tuint32_t vnodeid = 0;",
        "\tvnode_t vp;",
        "\tint count;",
        "",
        "\tbzero(&preginfo, sizeof(struct proc_regionwithpathinfo));",
        "",
        "\tret = fill_procregioninfo(proc_task(p), arg, (struct proc_regioninfo_internal *)&preginfo.prp_prinfo, (uintptr_t *)&vnodeaddr, (uint32_t *)&vnodeid);",
        "\tif (ret == 0) {",
        "\t\treturn EINVAL;",
        "\t}",
        "\tif (vnodeaddr) {",
        "\t\tvp = (vnode_t)vnodeaddr;",
        "\t\tif ((vnode_getwithvid(vp, vnodeid)) == 0) {",
        "\t\t\t/* FILL THE VNODEINFO */",
        "\t\t\terror = fill_vnodeinfo(vp, &preginfo.prp_vip.vip_vi, FALSE);",
        "\t\t\tcount = MAXPATHLEN;",
        "\t\t\tvn_getpath(vp, &preginfo.prp_vip.vip_path[0], &count);",
        "\t\t\t/* Always make sure it is null terminated */",
        "\t\t\tpreginfo.prp_vip.vip_path[MAXPATHLEN - 1] = 0;",
        "\t\t\tvnode_put(vp);",
        "\t\t}",
        "\t}",
        "\terror = copyout(&preginfo, buffer, sizeof(struct proc_regionwithpathinfo));",
        "\tif (error == 0) {",
        "\t\t*retval = sizeof(struct proc_regionwithpathinfo);",
        "\t}",
        "\treturn error;",
        "}"
      ]
    },
    {
      "from": 1230,
      "to": 1267,
      "lines": [
        "int",
        "proc_pidregionpath(proc_t p, uint64_t arg, user_addr_t buffer, __unused uint32_t buffersize, int32_t *retval)",
        "{",
        "\tstruct proc_regionpath path = {};",
        "\tint ret, error = 0;",
        "\tuintptr_t vnodeaddr = 0;",
        "\tuint32_t vnodeid = 0;",
        "\tvnode_t vp;",
        "\tbool is_map_shared;",
        "",
        "\tret = task_find_region_details(proc_task(p), (vm_map_offset_t) arg,",
        "\t    FIND_REGION_DETAILS_OPTIONS_NONE,",
        "\t    (uintptr_t *)&vnodeaddr, (uint32_t *)&vnodeid, &is_map_shared,",
        "\t    &path.prpo_addr, &path.prpo_regionlength);",
        "\tif (ret == 0) {",
        "\t\treturn EINVAL;",
        "\t}",
        "\tif (!vnodeaddr) {",
        "\t\treturn EINVAL;",
        "\t}",
        "",
        "\tvp = (vnode_t)vnodeaddr;",
        "\tif ((vnode_getwithvid(vp, vnodeid)) == 0) {",
        "\t\tint count = MAXPATHLEN;",
        "\t\tvn_getpath(vp, &path.prpo_path[0], &count);",
        "\t\t/* Always make sure it is null terminated */",
        "\t\tpath.prpo_path[MAXPATHLEN - 1] = 0;",
        "\t\tvnode_put(vp);",
        "\t} else {",
        "\t\treturn EINVAL;",
        "\t}",
        "",
        "\terror = copyout(&path, buffer, sizeof(struct proc_regionpath));",
        "\tif (error == 0) {",
        "\t\t*retval = sizeof(struct proc_regionpath);",
        "\t}",
        "\treturn error;",
        "}"
      ]
    },
    {
      "from": 2014,
      "to": 2054,
      "lines": [
        "/********************************** proc_pidinfo ********************************/",
        "",
        "",
        "int",
        "proc_pidinfo(int pid, uint32_t flags, uint64_t ext_id, int flavor, uint64_t arg, user_addr_t buffer, uint32_t  buffersize, int32_t * retval)",
        "{",
        "\tstruct proc * p = PROC_NULL;",
        "\tint error = ENOTSUP;",
        "\tint gotref = 0;",
        "\tint findzomb = 0;",
        "\tint shortversion = 0;",
        "\tuint32_t size;",
        "\tint zombie = 0;",
        "\tbool thuniqueid = false;",
        "\tint uniqidversion = 0;",
        "\tbool check_same_user;",
        "\tpid_t current_pid = proc_pid(current_proc());",
        "",
        "\t/**",
        "\t * Before we move forward, we should check if an unpermitted operation is",
        "\t * attempted on the kernel task.",
        "\t */",
        "\tif (pid == 0) {",
        "\t\tswitch (flavor) {",
        "\t\tcase PROC_PIDWORKQUEUEINFO:",
        "\t\t\t/* kernel does not have workq info */",
        "\t\t\treturn EINVAL;",
        "\t\tcase PROC_PIDREGIONPATH:",
        "\t\tcase PROC_PIDREGIONINFO:",
        "\t\tcase PROC_PIDREGIONPATHINFO:",
        "\t\tcase PROC_PIDREGIONPATHINFO2:",
        "\t\tcase PROC_PIDREGIONPATHINFO3:",
        "\t\t\t/* This operation is not permitted on the kernel */",
        "\t\t\tif (current_pid != pid) {",
        "\t\t\t\tPROC_UNPERMITTED_PIDINFO_FLAVOR();",
        "\t\t\t\treturn EPERM;",
        "\t\t\t}",
        "\t\t\tbreak;",
        "\t\t}",
        "\t}",
        ""
      ]
    },
    {
      "from": 2083,
      "to": 2088,
      "lines": [
        "\tcase PROC_PIDREGIONINFO:",
        "\t\tsize = PROC_PIDREGIONINFO_SIZE;",
        "\t\tbreak;",
        "\tcase PROC_PIDREGIONPATHINFO:",
        "\t\tsize = PROC_PIDREGIONPATHINFO_SIZE;",
        "\t\tbreak;"
      ]
    },
    {
      "from": 2182,
      "to": 2237,
      "lines": [
        "\tif (buffersize < size) {",
        "\t\treturn ENOMEM;",
        "\t}",
        "",
        "\tif ((flavor == PROC_PIDPATHINFO) && (buffersize > PROC_PIDPATHINFO_MAXSIZE)) {",
        "\t\treturn EOVERFLOW;",
        "\t}",
        "",
        "\t/* Check if we need to look for zombies */",
        "\tif ((flavor == PROC_PIDTBSDINFO) || (flavor == PROC_PIDT_SHORTBSDINFO) || (flavor == PROC_PIDT_BSDINFOWITHUNIQID)",
        "\t    || (flavor == PROC_PIDUNIQIDENTIFIERINFO)) {",
        "\t\tif (arg) {",
        "\t\t\tfindzomb = 1;",
        "\t\t}",
        "\t}",
        "",
        "\tif ((p = proc_find(pid)) == PROC_NULL) {",
        "\t\tif (findzomb) {",
        "\t\t\tp = proc_find_zombref(pid);",
        "\t\t}",
        "\t\tif (p == PROC_NULL) {",
        "\t\t\terror = ESRCH;",
        "\t\t\tgoto out;",
        "\t\t}",
        "\t\tzombie = 1;",
        "\t} else {",
        "\t\tgotref = 1;",
        "\t}",
        "",
        "\tif ((flags & PIF_COMPARE_IDVERSION) && (ext_id != proc_pidversion(p))) {",
        "\t\terror = ESRCH;",
        "\t\tgoto out;",
        "\t}",
        "\tif ((flags & PIF_COMPARE_UNIQUEID) && (ext_id != proc_uniqueid(p))) {",
        "\t\terror = ESRCH;",
        "\t\tgoto out;",
        "\t}",
        "",
        "\t/* Certain operations don't require privileges */",
        "\tswitch (flavor) {",
        "\tcase PROC_PIDT_SHORTBSDINFO:",
        "\tcase PROC_PIDUNIQIDENTIFIERINFO:",
        "\tcase PROC_PIDPATHINFO:",
        "\tcase PROC_PIDCOALITIONINFO:",
        "\tcase PROC_PIDPLATFORMINFO:",
        "\t\tcheck_same_user = NO_CHECK_SAME_USER;",
        "\t\tbreak;",
        "\tdefault:",
        "\t\tcheck_same_user = CHECK_SAME_USER;",
        "\t\tbreak;",
        "\t}",
        "",
        "\t/* Do we have permission to look into this? */",
        "\tif ((error = proc_security_policy(p, PROC_INFO_CALL_PIDINFO, flavor, check_same_user))) {",
        "\t\tgoto out;",
        "\t}"
      ]
    },
    {
      "from": 2359,
      "to": 2368,
      "lines": [
        "\tcase PROC_PIDREGIONINFO:{",
        "\t\terror =  proc_pidregioninfo(p, arg, buffer, buffersize, retval);",
        "\t}",
        "\tbreak;",
        "",
        "",
        "\tcase PROC_PIDREGIONPATHINFO:{",
        "\t\terror =  proc_pidregionpathinfo(p, arg, buffer, buffersize, retval);",
        "\t}",
        "\tbreak;"
      ]
    },
    {
      "from": 2680,
      "to": 2713,
      "lines": [
        "int",
        "fill_vnodeinfo(vnode_t vp, struct vnode_info *vinfo, __unused boolean_t check_fsgetpath)",
        "{",
        "\tvfs_context_t context;",
        "\tstruct stat64 sb;",
        "\tint error = 0;",
        "",
        "\tbzero(&sb, sizeof(struct stat64));",
        "\tcontext = vfs_context_create((vfs_context_t)0);",
        "#if CONFIG_MACF",
        "\t/* Called when vnode info is used by the caller to get vnode's path */",
        "\tif (check_fsgetpath) {",
        "\t\terror = mac_vnode_check_fsgetpath(context, vp);",
        "\t}",
        "#endif",
        "\tif (!error) {",
        "\t\terror = vn_stat(vp, &sb, NULL, 1, 0, context);",
        "\t\tmunge_vinfo_stat(&sb, &vinfo->vi_stat);",
        "\t}",
        "\t(void)vfs_context_rele(context);",
        "\tif (error != 0) {",
        "\t\tgoto out;",
        "\t}",
        "",
        "\tif (vp->v_mount != dead_mountp) {",
        "\t\tvinfo->vi_fsid = vp->v_mount->mnt_vfsstat.f_fsid;",
        "\t} else {",
        "\t\tvinfo->vi_fsid.val[0] = 0;",
        "\t\tvinfo->vi_fsid.val[1] = 0;",
        "\t}",
        "\tvinfo->vi_type = vp->v_type;",
        "out:",
        "\treturn error;",
        "}"
      ]
    },
    {
      "from": 3184,
      "to": 3227,
      "lines": [
        "int",
        "proc_security_policy(proc_t targetp, __unused int callnum, __unused int flavor, boolean_t check_same_user)",
        "{",
        "#if CONFIG_MACF",
        "\tint error = 0;",
        "",
        "\tif ((error = mac_proc_check_proc_info(current_proc(), targetp, callnum, flavor))) {",
        "\t\treturn error;",
        "\t}",
        "#endif",
        "",
        "\t/* The 'listpids' call doesn't have a target proc */",
        "\tif (targetp == PROC_NULL) {",
        "\t\tassert(callnum == PROC_INFO_CALL_LISTPIDS && check_same_user == NO_CHECK_SAME_USER);",
        "\t\treturn 0;",
        "\t}",
        "",
        "\t/*",
        "\t * Check for 'get information for processes owned by other users' privilege",
        "\t * root has this privilege by default",
        "\t */",
        "\tif (check_same_user) {",
        "\t\tkauth_cred_t my_cred = kauth_cred_get();",
        "\t\tkauth_cred_t tg_cred;",
        "",
        "\t\tsmr_proc_task_enter();",
        "\t\ttg_cred = proc_ucred_smr(targetp);",
        "\t\tif (kauth_cred_getuid(my_cred) != kauth_cred_getuid(tg_cred)) {",
        "\t\t\terror = EPERM;",
        "\t\t}",
        "\t\ttg_cred = NOCRED;",
        "\t\tsmr_proc_task_leave();",
        "",
        "\t\t/*",
        "\t\t * If uid doesn't match, check if the caller is specially entitled",
        "\t\t * to bypass the requirement.",
        "\t\t */",
        "\t\tif (error && priv_check_cred(my_cred, PRIV_GLOBAL_PROC_INFO, 0)) {",
        "\t\t\treturn EPERM;",
        "\t\t}",
        "\t}",
        "",
        "\treturn 0;",
        "}"
      ]
    }
  ],
