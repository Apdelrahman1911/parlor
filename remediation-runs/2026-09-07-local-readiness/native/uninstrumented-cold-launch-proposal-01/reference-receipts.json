        "kind": "declarations"
      },
      {
        "content": [
          {
            "anchor": "Discussion",
            "level": 2,
            "text": "Discussion",
            "type": "heading"
          },
          {
            "inlineContent": [
              {
                "text": "This call is synchronous. When it returns, the application launches and is ready to handle user events. The system reports any failure in the launch sequence as a test failure and halts the test at this point.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "inlineContent": [
              {
                "text": "If the application is already running, this call terminates the existing instance, to ensure a clean launch state for the newly launched instance.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          }
        ],
        "kind": "content"
      }
    ],
    "retained": "references/launch__.json.gz"
