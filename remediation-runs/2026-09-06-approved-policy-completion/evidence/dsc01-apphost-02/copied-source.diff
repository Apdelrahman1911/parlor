+                observer.endCommand(ordinal, "applied")
+            } catch (cancelled: kotlinx.coroutines.CancellationException) {
+                observer.endCommand(ordinal, "cancelled")
+                throw cancelled
+            } catch (_: com.parlor.storage.settings.SettingsPersistenceException) {
+                observer.endCommand(ordinal, "failed")
+            }
+        }
+    }
+
+    fun close() {
+        check(job?.isActive != true)
+        job = null
+        scope.coroutineContext[kotlinx.coroutines.Job]?.cancel()
+        com.parlor.designsystem.auditcopy.DSC01CopyOnlyObservation.release()
+    }
+}
+
+fun DSC01ActualCompositionObservation(): String {
+    check(platform.Foundation.NSThread.isMainThread)
+    return com.parlor.designsystem.auditcopy.DSC01CopyOnlyObservation.snapshot()
+}
+
+fun DSC01CaptureActualSession() {
+    check(platform.Foundation.NSThread.isMainThread)
+    com.parlor.designsystem.auditcopy.DSC01CopyOnlyObservation.capture()
+}
+
+fun DSC01SyntheticLanguage(language: String) = DSC01SyntheticSettingsInvocation.submit(language)
+
+fun DSC01ReleaseSyntheticObservation() = DSC01SyntheticSettingsInvocation.close()
