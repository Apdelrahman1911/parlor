    {
      "from": 975,
      "to": 1150,
      "lines": [
        "/*********************** proc_info implementation *************/",
        "",
        "#include <sys/bsdtask_info.h>",
        "",
        "static int fill_vnodeinfoforaddr( vm_map_entry_t entry, uintptr_t * vnodeaddr, uint32_t * vid, bool *is_map_shared);",
        "",
        "int",
        "fill_procregioninfo(task_t task, uint64_t arg, struct proc_regioninfo_internal *pinfo, uintptr_t *vnodeaddr, uint32_t  *vid)",
        "{",
        "\tvm_map_t map;",
        "\tvm_map_offset_t address = (vm_map_offset_t)arg;",
        "\tvm_map_entry_t          tmp_entry;",
        "\tvm_map_entry_t          entry;",
        "\tvm_map_offset_t         start;",
        "\tvm_region_extended_info_data_t extended;",
        "\tvm_region_top_info_data_t top;",
        "\tboolean_t do_region_footprint;",
        "\tint       effective_page_shift, effective_page_size;",
        "",
        "\tvmlp_api_start(FILL_PROCREGIONINFO);",
        "",
        "\ttask_lock(task);",
        "\tmap = task->map;",
        "\tif (map == VM_MAP_NULL) {",
        "\t\ttask_unlock(task);",
        "\t\tvmlp_api_end(FILL_PROCREGIONINFO, 0);",
        "\t\treturn 0;",
        "\t}",
        "",
        "\teffective_page_shift = vm_self_region_page_shift(map);",
        "\teffective_page_size = (1 << effective_page_shift);",
        "",
        "\tvm_map_reference(map);",
        "\ttask_unlock(task);",
        "",
        "\tdo_region_footprint = task_self_region_footprint();",
        "",
        "\tvm_map_lock_read(map);",
        "",
        "\tstart = address;",
        "",
        "\tif (!vm_map_lookup_entry(map, start, &tmp_entry)) {",
        "\t\tif ((entry = tmp_entry->vme_next) == vm_map_to_entry(map)) {",
        "\t\t\tif (do_region_footprint &&",
        "\t\t\t    address == tmp_entry->vme_end) {",
        "\t\t\t\tledger_amount_t ledger_resident;",
        "\t\t\t\tledger_amount_t ledger_compressed;",
        "",
        "\t\t\t\t/*",
        "\t\t\t\t * This request is right after the last valid",
        "\t\t\t\t * memory region;  instead of reporting the",
        "\t\t\t\t * end of the address space, report a fake",
        "\t\t\t\t * memory region to account for non-volatile",
        "\t\t\t\t * purgeable and/or ledger-tagged memory",
        "\t\t\t\t * owned by this task.",
        "\t\t\t\t */",
        "\t\t\t\ttask_ledgers_footprint(task->ledger,",
        "\t\t\t\t    &ledger_resident,",
        "\t\t\t\t    &ledger_compressed);",
        "\t\t\t\tif (ledger_resident + ledger_compressed == 0) {",
        "\t\t\t\t\t/* nothing to report */",
        "\t\t\t\t\tvm_map_unlock_read(map);",
        "\t\t\t\t\tvm_map_deallocate(map);",
        "\t\t\t\t\tvmlp_api_end(FILL_PROCREGIONINFO, 0);",
        "\t\t\t\t\treturn 0;",
        "\t\t\t\t}",
        "",
        "\t\t\t\t/* provide fake region for purgeable */",
        "\t\t\t\tpinfo->pri_offset = address;",
        "\t\t\t\tpinfo->pri_protection = VM_PROT_DEFAULT;",
        "\t\t\t\tpinfo->pri_max_protection = VM_PROT_DEFAULT;",
        "\t\t\t\tpinfo->pri_inheritance = VM_INHERIT_NONE;",
        "\t\t\t\tpinfo->pri_behavior = VM_BEHAVIOR_DEFAULT;",
        "\t\t\t\tpinfo->pri_user_wired_count = 0;",
        "\t\t\t\tpinfo->pri_user_tag = -1;",
        "\t\t\t\tpinfo->pri_pages_resident =",
        "\t\t\t\t    (uint32_t) (ledger_resident / effective_page_size);",
        "\t\t\t\tpinfo->pri_pages_shared_now_private = 0;",
        "\t\t\t\tpinfo->pri_pages_swapped_out =",
        "\t\t\t\t    (uint32_t) (ledger_compressed / effective_page_size);",
        "\t\t\t\tpinfo->pri_pages_dirtied =",
        "\t\t\t\t    (uint32_t) (ledger_resident / effective_page_size);",
        "\t\t\t\tpinfo->pri_ref_count = 1;",
        "\t\t\t\tpinfo->pri_shadow_depth = 0;",
        "\t\t\t\tpinfo->pri_share_mode = SM_PRIVATE;",
        "\t\t\t\tpinfo->pri_private_pages_resident =",
        "\t\t\t\t    (uint32_t) (ledger_resident / effective_page_size);",
        "\t\t\t\tpinfo->pri_shared_pages_resident = 0;",
        "\t\t\t\tpinfo->pri_obj_id = VM_OBJECT_ID_FAKE(map, task_ledgers.purgeable_nonvolatile);",
        "\t\t\t\tpinfo->pri_address = address;",
        "\t\t\t\tpinfo->pri_size =",
        "\t\t\t\t    (uint64_t) (ledger_resident + ledger_compressed);",
        "\t\t\t\tpinfo->pri_depth = 0;",
        "",
        "\t\t\t\tvm_map_unlock_read(map);",
        "\t\t\t\tvm_map_deallocate(map);",
        "\t\t\t\tvmlp_api_end(FILL_PROCREGIONINFO, 1);",
        "\t\t\t\treturn 1;",
        "\t\t\t}",
        "\t\t\tvm_map_unlock_read(map);",
        "\t\t\tvm_map_deallocate(map);",
        "\t\t\tvmlp_api_end(FILL_PROCREGIONINFO, 0);",
        "\t\t\treturn 0;",
        "\t\t}",
        "\t} else {",
        "\t\tentry = tmp_entry;",
        "\t}",
        "",
        "\tstart = entry->vme_start;",
        "\tvmlp_range_event_entry(map, entry);",
        "",
        "\tpinfo->pri_offset = VME_OFFSET(entry);",
        "\tpinfo->pri_protection = entry->protection;",
        "\tpinfo->pri_max_protection = entry->max_protection;",
        "\tpinfo->pri_inheritance = entry->inheritance;",
        "\tpinfo->pri_behavior = entry->behavior;",
        "\tpinfo->pri_user_wired_count = entry->user_wired_count;",
        "\tpinfo->pri_user_tag = VME_ALIAS(entry);",
        "",
        "\tif (entry->is_sub_map) {",
        "\t\tpinfo->pri_flags |= PROC_REGION_SUBMAP;",
        "\t} else {",
        "\t\tif (entry->is_shared) {",
        "\t\t\tpinfo->pri_flags |= PROC_REGION_SHARED;",
        "\t\t}",
        "\t}",
        "",
        "",
        "\textended.protection = entry->protection;",
        "\textended.user_tag = VME_ALIAS(entry);",
        "\textended.pages_resident = 0;",
        "\textended.pages_swapped_out = 0;",
        "\textended.pages_shared_now_private = 0;",
        "\textended.pages_dirtied = 0;",
        "\textended.external_pager = 0;",
        "\textended.shadow_depth = 0;",
        "",
        "\tvm_map_region_walk(map, start, entry, VME_OFFSET(entry), entry->vme_end - start, &extended, TRUE, VM_REGION_EXTENDED_INFO_COUNT);",
        "",
        "\ttop.private_pages_resident = 0;",
        "\ttop.shared_pages_resident = 0;",
        "\tvm_map_region_top_walk(entry, &top);",
        "",
        "",
        "\tpinfo->pri_pages_resident = extended.pages_resident;",
        "\tpinfo->pri_pages_shared_now_private = extended.pages_shared_now_private;",
        "\tpinfo->pri_pages_swapped_out = extended.pages_swapped_out;",
        "\tpinfo->pri_pages_dirtied = extended.pages_dirtied;",
        "\tpinfo->pri_ref_count = extended.ref_count;",
        "\tpinfo->pri_shadow_depth = extended.shadow_depth;",
        "\tpinfo->pri_share_mode = extended.share_mode;",
        "",
        "\tpinfo->pri_private_pages_resident = top.private_pages_resident;",
        "\tpinfo->pri_shared_pages_resident = top.shared_pages_resident;",
        "\tpinfo->pri_obj_id = top.obj_id;",
        "",
        "\tpinfo->pri_address = (uint64_t)start;",
        "\tpinfo->pri_size = (uint64_t)(entry->vme_end - start);",
        "\tpinfo->pri_depth = 0;",
        "",
        "\tif ((vnodeaddr != 0) && (entry->is_sub_map == 0)) {",
        "\t\t*vnodeaddr = (uintptr_t)0;",
        "",
        "\t\tif (fill_vnodeinfoforaddr(entry, vnodeaddr, vid, NULL) == 0) {",
        "\t\t\tvm_map_unlock_read(map);",
        "\t\t\tvm_map_deallocate(map);",
        "\t\t\tvmlp_api_end(FILL_PROCREGIONINFO, 1);",
        "\t\t\treturn 1;",
        "\t\t}",
        "\t}",
        "",
        "\tvm_map_unlock_read(map);",
        "\tvm_map_deallocate(map);",
        "\tvmlp_api_end(FILL_PROCREGIONINFO, 1);",
        "\treturn 1;",
        "}"
      ]
    },
    {
      "from": 1238,
      "to": 1416,
      "lines": [
        "int",
        "task_find_region_details(",
        "\ttask_t task,",
        "\tvm_map_offset_t offset,",
        "\tfind_region_details_options_t options,",
        "\tuintptr_t *vp_p,",
        "\tuint32_t *vid_p,",
        "\tbool *is_map_shared_p,",
        "\tuint64_t *start_p,",
        "\tuint64_t *len_p)",
        "{",
        "\tvm_map_t        map;",
        "\tvm_map_entry_t  entry;",
        "\tint             rc;",
        "",
        "\tvmlp_api_start(TASK_FIND_REGION_DETAILS);",
        "",
        "\trc = 0;",
        "\t*vp_p = 0;",
        "\t*vid_p = 0;",
        "\t*is_map_shared_p = false;",
        "\t*start_p = 0;",
        "\t*len_p = 0;",
        "\tif (options & ~FIND_REGION_DETAILS_OPTIONS_ALL) {",
        "\t\tvmlp_api_end(TASK_FIND_REGION_DETAILS, 0);",
        "\t\treturn 0;",
        "\t}",
        "",
        "\ttask_lock(task);",
        "\tmap = task->map;",
        "\tif (map == VM_MAP_NULL) {",
        "\t\ttask_unlock(task);",
        "\t\tvmlp_api_end(TASK_FIND_REGION_DETAILS, 0);",
        "\t\treturn 0;",
        "\t}",
        "\tvm_map_reference(map);",
        "\ttask_unlock(task);",
        "",
        "\tvm_map_lock_read(map);",
        "\tif (!vm_map_lookup_entry(map, offset, &entry)) {",
        "\t\tif (options & FIND_REGION_DETAILS_AT_OFFSET) {",
        "\t\t\t/* no mapping at this offset */",
        "\t\t\tgoto ret;",
        "\t\t}",
        "\t\t/* check next entry */",
        "\t\tentry = entry->vme_next;",
        "\t\tif (entry == vm_map_to_entry(map)) {",
        "\t\t\t/* no next entry */",
        "\t\t\tgoto ret;",
        "\t\t}",
        "\t}",
        "",
        "\tfor (;",
        "\t    entry != vm_map_to_entry(map);",
        "\t    entry = entry->vme_next) {",
        "\t\tvmlp_range_event_entry(map, entry);",
        "",
        "\t\tif (entry->is_sub_map) {",
        "\t\t\t/* fallthru to check next entry */",
        "\t\t} else if (fill_vnodeinfoforaddr(entry, vp_p, vid_p, is_map_shared_p)) {",
        "\t\t\tif ((options & FIND_REGION_DETAILS_GET_VNODE) &&",
        "\t\t\t    vnode_get((struct vnode *)*vp_p)) {",
        "\t\t\t\t/* tried but could not get an iocount */",
        "\t\t\t\t*vp_p = 0;",
        "\t\t\t\t*vid_p = 0;",
        "\t\t\t\tif (options & FIND_REGION_DETAILS_AT_OFFSET) {",
        "\t\t\t\t\t/* done */",
        "\t\t\t\t\tbreak;",
        "\t\t\t\t}",
        "\t\t\t\t/* check next entry */",
        "\t\t\t\tcontinue;",
        "\t\t\t}",
        "\t\t\t*start_p = entry->vme_start;",
        "\t\t\t*len_p = entry->vme_end - entry->vme_start;",
        "\t\t\trc = 1; /* success */",
        "\t\t\tbreak;",
        "\t\t}",
        "\t\tif (options & FIND_REGION_DETAILS_AT_OFFSET) {",
        "\t\t\t/* no file mapping at this offset: done */",
        "\t\t\tbreak;",
        "\t\t}",
        "\t\t/* check next entry */",
        "\t}",
        "",
        "ret:",
        "\tvm_map_unlock_read(map);",
        "\tvm_map_deallocate(map);",
        "\tvmlp_api_end(TASK_FIND_REGION_DETAILS, rc);",
        "\treturn rc;",
        "}",
        "",
        "static int",
        "fill_vnodeinfoforaddr(",
        "\tvm_map_entry_t                  entry,",
        "\tuintptr_t * vnodeaddr,",
        "\tuint32_t * vid,",
        "\tbool *is_map_shared)",
        "{",
        "\tvm_object_t     top_object, object;",
        "\tmemory_object_t memory_object;",
        "\tmemory_object_pager_ops_t pager_ops;",
        "\tkern_return_t   kr;",
        "\tint             shadow_depth;",
        "",
        "",
        "\tif (entry->is_sub_map) {",
        "\t\treturn 0;",
        "\t} else {",
        "\t\t/*",
        "\t\t * The last object in the shadow chain has the",
        "\t\t * relevant pager information.",
        "\t\t */",
        "\t\ttop_object = VME_OBJECT(entry);",
        "\t\tif (top_object == VM_OBJECT_NULL) {",
        "\t\t\tobject = VM_OBJECT_NULL;",
        "\t\t\tshadow_depth = 0;",
        "\t\t} else {",
        "\t\t\tvm_object_lock(top_object);",
        "\t\t\tfor (object = top_object, shadow_depth = 0;",
        "\t\t\t    object->shadow != VM_OBJECT_NULL;",
        "\t\t\t    object = object->shadow, shadow_depth++) {",
        "\t\t\t\tvm_object_lock(object->shadow);",
        "\t\t\t\tvm_object_unlock(object);",
        "\t\t\t}",
        "\t\t}",
        "\t}",
        "",
        "\tif (object == VM_OBJECT_NULL) {",
        "\t\treturn 0;",
        "\t} else if (object->internal) {",
        "\t\tvm_object_unlock(object);",
        "\t\treturn 0;",
        "\t} else if (!object->pager_ready ||",
        "\t    object->terminating ||",
        "\t    !object->alive ||",
        "\t    object->pager == NULL) {",
        "\t\tvm_object_unlock(object);",
        "\t\treturn 0;",
        "\t} else {",
        "\t\tmemory_object = object->pager;",
        "\t\tpager_ops = memory_object->mo_pager_ops;",
        "\t\tif (pager_ops == &vnode_pager_ops) {",
        "\t\t\tkr = vnode_pager_get_object_vnode(",
        "\t\t\t\tmemory_object,",
        "\t\t\t\tvnodeaddr, vid);",
        "\t\t\tif (kr != KERN_SUCCESS) {",
        "\t\t\t\tvm_object_unlock(object);",
        "\t\t\t\treturn 0;",
        "\t\t\t}",
        "\t\t} else {",
        "\t\t\tvm_object_unlock(object);",
        "\t\t\treturn 0;",
        "\t\t}",
        "\t}",
        "\tif (is_map_shared) {",
        "\t\t*is_map_shared = (shadow_depth == 0);",
        "\t}",
        "\tvm_object_unlock(object);",
        "\treturn 1;",
        "}",
        "",
        "kern_return_t",
        "vnode_pager_get_object_vnode(",
        "\tmemory_object_t         mem_obj,",
        "\tuintptr_t * vnodeaddr,",
        "\tuint32_t * vid)",
        "{",
        "\tvnode_pager_t   vnode_object;",
        "",
        "\tvnode_object = vnode_pager_lookup(mem_obj);",
        "\tif (vnode_object->vnode_handle) {",
        "\t\t*vnodeaddr = (uintptr_t)vnode_object->vnode_handle;",
        "\t\t*vid = (uint32_t)vnode_vid((void *)vnode_object->vnode_handle);",
        "",
        "\t\treturn KERN_SUCCESS;",
        "\t}",
        "",
        "\treturn KERN_FAILURE;",
        "}"
      ]
    }
  ]
}
