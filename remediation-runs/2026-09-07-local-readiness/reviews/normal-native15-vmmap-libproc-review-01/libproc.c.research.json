      "lines": [
        "int",
        "proc_pidinfo(int pid, int flavor, uint64_t arg, void *buffer, int buffersize)",
        "{",
        "\tint retval;",
        "",
        "\tif ((retval = __proc_info(PROC_INFO_CALL_PIDINFO, pid, flavor, arg, buffer, buffersize)) == -1) {",
        "\t\treturn 0;",
        "\t}",
        "",
        "\treturn retval;",
        "}"
      ]
    },
    {
      "from": 234,
      "to": 250,
      "lines": [
        "int",
        "proc_regionfilename(int pid, uint64_t address, void * buffer, uint32_t buffersize)",
        "{",
        "\tint retval;",
        "\tstruct proc_regionpath path;",
        "",
        "\tif (buffersize < MAXPATHLEN) {",
        "\t\terrno = ENOMEM;",
        "\t\treturn 0;",
        "\t}",
        "",
        "\tretval = proc_pidinfo(pid, PROC_PIDREGIONPATH, (uint64_t)address, &path, sizeof(struct proc_regionpath));",
        "\tif (retval != 0) {",
        "\t\treturn (int)(strlcpy(buffer, path.prpo_path, buffersize));",
        "\t}",
        "\treturn 0;",
        "}"
      ]
    }
