_simulator_lifecycle_integration.py': '93d88840fcef436dbf45cc20de071e784daa4c6bc0e7683b623da8df7197100c',\n 'scripts/verification/ios-readiness/test_toolchain_profiles.py': 'aee9e30948813929393acedfaad5767fee2a47eb896a7eddd81db96208f14672',\n 'scripts/verification/ios-readiness/toolchain_profiles.py': '8adacaf4c59ed823aa088ecb70ad5c6c1e3f76e7ca3520d8abf0563341591313',\n 'shared/design-system/src/iosMain/kotlin/com/parlor/designsystem/localization/LocalAppLocale.ios.kt': '0e0783ca3e38634bd3469760f5dbfa5ade8509b976d0ec676202f4513cd8e098'}\nEXTERNAL_REVIEW_OBLIGATIONS = ['On every outcome, root and a different reviewer reopen each attempted raw driver log and its retained SHA/size, '\n 'all child exit/error/shutdown records, both input manifests, and the enclosing lane source/runner/cleanup '\n 'receipt.',\n 'Enumerate every actual allocation and cleanup marker even when embedded after a unittest progress prefix. Pair '\n 'exact path/device/inode/uid; never assume line-start or exactly one pair, never prefix-delete or substitute '\n 'ordinary lane scratch cleanup.',\n 'Confirm all exact allocated parents/stand-in temporary paths are absent after the cycle using fresh no-adoption '\n 'inspection; unresolved absence, missing rows, ambiguity, cleanup FAIL, timeout, interruption or escalation '\n 'withholds clearance and requires owned follow-up evidence.',\n 'Reconcile composition RESULTS discovered IDs/count/failures/errors/skips/native_execution and its two exact '\n 'input-test hashes; verify all five distinct stand-in audit records, helper-owned exact-handle reaping, '\n 'fallback/error state and current temporary absence.',\n 'The packet and ordinary lane PASS are deliberately NOT process/external-allocation clearance. Additive '\n 'independent reconciliation must close this non-upgradeable REQUIRED state before source/inventory freeze and '\n 'native/final CI dispatch. Preserve original native-repair-control01 FAIL and its reconciliations byte-for-byte.']\nEXTERNAL_REVIEW_TARGETS = {'composition': {'allocation_marker': 'PARLOR_APP_FOUNDATION_CONTROL_ALLOCATION',\n                 'cleanup_marker': 'PARLOR_APP_FOUNDATION_CONTROL_CLEANUP',\n                 'expected_allocation_cleanup_pairs_from_current_source': 4,\n                 'expected_input_tests': [{'bytes': 34661,\n                                           'path': 'remediation-runs/2026-09-07-local-readiness/native/l08-app-foundation-draft-01/test_app_foundation.py',\n                                           'sha256': 'c04c7d4b1bb99207415beab77ae3b40bb3d5f59709970f7d844d5d14beab0fe5'},\n                                          {'bytes': 28101,\n                                           'path': 'remediation-runs/2026-09-07-local-readiness/native/l08-app-foundation-composition-01/test_composition.py',\n                                           'sha256': '1ee5d5889d50b94a11d3e3d2ce881899c2434eb97489e953f546a2b7d344afd5'}],\n                 'expected_results': {'errors': 0,\n                                      'failures': 0,\n                                      'native_execution': False,\n                                      'skipped': [],\n                                      'tests_run': 55},\n                 'kind': 'EXTERNAL_SYNTHETIC_FOUNDATION_COMPOSITION_FIXTURE_PARENTS',\n                 'pair_explanation': 'One outer parent plus three nested None/ValueError/KeyboardInterrupt '\n                                     'callback parents; synthetic callbacks are not OS signal tests. Reconcile '\n                                     'every actual row, not a startswith/exactly-one parser.',\n                 'required': ['Bind all actual allocation/cleanup pairs and exact custody, including mid-prefix '\n                              'nested output; require cleanup PASS,parent_removed=True,matching device/inode/uid '\n                              'and workers_started=0.',\n                              'Verify every exact external parent is absent. Reopen RESULTS for55 distinct '\n                              'discovered IDs, zero failures/errors, empty skips, native_execution=False and '\n                              'exact two current test-source hashes.'],\n                 'results_marker': 'PARLOR_APP_FOUNDATION_CONTROL_RESULTS'},\n 'foundation-profile': {'allocation_marker': 'PARLOR_APP_FOUNDATION_CONTROL_ALLOCATION',\n                        'cleanup_marker': 'PARLOR_APP_FOUNDATION_CONTROL_CLEANUP',\n                        'expected_allocation_cleanup_pairs_from_current_source': 1,\n                        'kind': 'EXTERNAL_SYNTHETIC_FOUNDATION_FIXTURE_PARENT',\n                        'required': ['Bind every actual exact parent/custody allocation-cleanup pair and require '\n                                     'PASS,parent_removed=True,matching device/inode/uid and workers_started=0.',\n                                     'Freshly verify each exact external parent is absent without '\n                                     'adoption/deletion; the ordinary lane scratch receipt alone is '\n                                     'insufficient.']},\n 'simulator-lifecycle': {'expected_marker_count': 5,\n                         'expected_test_ids': ['test_simulator_lifecycle.HarnessSubprocessControls.test_harness_real_success_drains_both_streams_and_reaps_exact_handle',\n                                               'test_simulator_lifecycle.HarnessSubprocessControls.test_harness_exit_zero_with_real_diagnostic_stderr_remains_failed',\n                                               'test_simulator_lifecycle.HarnessSubprocessControls.test_harness_real_stdout_flood_is_bounded_and_the_exact_writer_is_reaped',\n                                               'test_simulator_lifecycle.HarnessSubprocessControls.test_harness_injected_wait_deadline_retires_closed_pipe_sleeping_handle_without_long_wait',\n                                               'test_simulator_lifecycle.HarnessSubprocessControls.test_harness_injected_wait_cancellation_retires_closed_pipe_sleeping_handle_without_global_signal'],\n                         'kind': 'FIVE_LOCAL_PYTHON_STANDINS_NOT_APP_OR_NATIVE_RUNTIME',\n                         'marker': 'HARNESS_SUBPROCESS_CONTROL',\n                         'required': ['Reopen all five distinct source-bound marker records, including any '\n                                      'mid-line marker; bind fixed Python code through this reviewed source, not '\n                                      'the sanitized <fixed-stand-in> display as an actual full argv trace.',\n                                      'Confirm the original inventory request was asserted before fixed '\n                                      'sys.executable -B -c substitution; no simctl/native/build/app command was '\n                                      'launched.',\n                                      'Require helper_reaped=True, reaped=True, integer return_code (negative '\n                                      'expected failure-path exits may be valid), fallback_retirement=False, '\n                                      'cleanup_errors=[] and native_runtime_proof=False for clean clearance; '\n                                      'preserve and investigate every contrary/missing record.',\n                                      'Verify exact temporary paths are absent and enclosing worker/scratch '\n                                      'cleanup is safe; injected TimeoutExpired/KeyboardInterrupt are synthetic '\n                                      'triggers, not observed native timeout, OS signal delivery or cancellation '\n                                      'proof.'],\n                         'source': {'bytes': 75257,\n                                    'path': 'scripts/verification/ios-readiness/test_simulator_lifecycle.py',\n                                    'sha256': '2f7c957e47aa63804866a71e3b5a8566342c6f7deca2f80e57f0cd42af1a5a46'}}}\nPACKET = ROOT / 'remediation-runs/2026-09-08-continuation/reviews/native-lifecycle-control-command-01.json'\n\ndef require(value, reason):\n    if not value: raise RuntimeError(reason)\n\n\ndef read(path, limit=4 * 1024 * 1024):\n    require(path.is_absolute() and path.resolve(strict=True) == path, 'redirected input/evidence')\n    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), 'rb') as stream:\n        st = os.fstat(stream.fileno())\n        require(stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid() and st.st_size <= limit, 'invalid/bounded input/evidence')\n        raw = stream.read(limit + 1)\n        require(len(raw) == st.st_size and len(raw) <= limit, 'input changed during read')\n    return raw\n\n\ndef write_new(path, value):\n    with path.open('x') as stream:\n        json.dump(value, stream, indent=2)\n        stream.write('\\n')\n\n\ndestination = ROOT / 'remediation-runs/2026-09-07-local-readiness/evidence' / CYCLE\ntemporary = Path(os.environ['TMPDIR'])\nrequire(sys.platform == 'linux' and sys.dont_write_bytecode and sys.argv == ['-c'], 'fixed Linux -B invocation required')\nrequire(temporary.is_absolute() and temporary == destination / 'scratch/tmp', 'exact coordinated lane required')\nfor path in (temporary, temporary.parent, destination):\n    st = path.lstat()\n    require(path.resolve(strict=True) == path and stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid(), 'lane custody required')\npacket, receipt = json.loads(read(PACKET)), json.loads(read(destination / 'receipt.json'))\nrequire(packet['schema_version'] == 1 and packet['outer_cycle'] == CYCLE and receipt.get('cycle') == CYCLE and\n        receipt.get('status') == 'RUNNING' and packet['command'] == receipt.get('command') == sys.orig_argv,\n        'whole reviewed invocation must appear in the running outer receipt')\nrequire(hashlib.sha256(read(ROOT / HELPER)).hexdigest() == BOUND_PINS[HELPER], 'reviewed helper bytes differ')\nspec = importlib.util.spec_from_file_location('reviewed_continuation_control_helpers', ROOT / HELPER)\nhelpers = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(helpers)\nrequire(helpers.ROOT == ROOT, 'helper source root differs')\n# Only manifest/run_command are reused. Never main(), owned_destination(), native/build entry points or a selector.\n\n\ndef manifest():\n    inherited = helpers.manifest()\n    entries = {row['path']: row['sha256'] for row in inherited}\n    require(len(entries) == len(inherited), 'duplicate inherited inputs')\n    for relative in (*EXTRA_INPUTS, str(PACKET.relative_to(ROOT))):\n        path = Path(relative)\n        require(not path.is_absolute() and '..' not in path.parts and str(path) == relative, 'nonexact extra input')\n        digest = hashlib.sha256(read(ROOT / path)).hexdigest()\n        require(relative not in entries or entries[relative] == digest, 'input changed during manifest')\n        entries[relative] = digest\n    return [dict(path=path, sha256=entries[path]) for path in sorted(entries)]\n\n\ndef interrupted(number, _frame):\n    if helpers.FINALIZING or helpers.STOPPING_CHILD: helpers.DEFERRED_SIGNALS.append(number)\n    elif helpers.LAUNCHING: helpers.PENDING_SIGNALS.append(number)\n    else: raise KeyboardInterrupt('signal ' + str(number))\n\n\nsignal.signal(signal.SIGINT, interrupted)\nsignal.signal(signal.SIGTERM, interrupted)\nrows, errors, summaries, logs = [], [], {}, {}\nbefore = after = None\npins_match = False\nEXTERNAL_REVIEW_NAMES = ('simulator-lifecycle', 'foundation-profile', 'composition')\n\n\ndef attempt(stage, operation):\n    try: return operation()\n    except BaseException as error:\n        errors.append(dict(stage=stage, type=type(error).__name__, message=str(error)[:800]))\n        return None\n\n\ndef evidence_identity(path, raw):\n    return dict(path=str(path.relative_to(ROOT)), sha256=hashlib.sha256(raw).hexdigest(), bytes=len(raw))\n\n\ntry:\n    before = manifest()\n    write_new(destination / 'native-lifecycle-inputs-before.json', before)\n    hashes = {row['path']: row['sha256'] for row in before}\n    mismatches = [path for path, sha in BOUND_PINS.items() if hashes.get(path) != sha]\n    require(not mismatches, 'frozen expected input bytes differ: ' + ', '.join(mismatches))\n    pins_match = True\n    for name, arguments, _ in COMMANDS:\n        helpers.run_command(destination, name, arguments, rows)\nexcept BaseException as error:\n    errors.append(dict(stage='execution', type=type(error).__name__, message=str(error)[:800]))\nfinally:\n    helpers.FINALIZING = True\n    for row in rows:\n        if row['name'] in EXTERNAL_REVIEW_NAMES:\n            # Required on success as well as timeout/interruption/escalation.\n            # No marker parser or exit-zero inference grants process/allocation clearance.\n            row['external_cleanup_requires_independent_inspection'] = True\n    # Preserve every attempted child's original exit/error/shutdown fields first.\n    attempt('retain-command-exits', lambda: write_new(destination / 'native-lifecycle-command-exits.json', rows))\n    after = attempt('postflight-manifest', manifest)\n    if after is not None:\n        attempt('retain-postflight', lambda: write_new(destination / 'native-lifecycle-inputs-after.json', after))\n    for name, _, count in COMMANDS:\n        selected = next((row for row in rows if row['name'] == name), None)\n        if selected is None: continue\n        def observe_log(row=selected):\n            path = destination / row['log']\n            raw = read(path, 16 * 1024 * 1024)\n            logs[row['name']] = evidence_identity(path, raw)\n            return raw.decode('utf-8')\n        output = attempt('retain-log-identity:' + name, observe_log)\n        if output is None: continue\n        def summarize(row=selected, expected=count, text=output):\n            counts = re.findall(r'^Ran ([0-9]+) tests? in [^\\r\\n]+$', text, re.MULTILINE)\n            unskipped = len(re.findall(r'^OK$', text, re.MULTILINE)) == 1 and not re.search(r'^OK \\(|^FAILED', t