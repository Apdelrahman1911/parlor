{"abstract":[{"text":"Update your apps to use new features, and test your apps against API changes.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.ios-ipados-release-notes\/documentation\/ios-ipados-release-notes"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.ios-ipados-release-notes\/documentation\/iOS-iPadOS-Release-Notes\/ios-ipados-26_2-release-notes"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"role":"article","roleHeading":"Article","title":"iOS & iPadOS 26.2 Release Notes"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The iOS & iPadOS 26.2 SDK provides support to develop apps for iPhone and iPad running iOS & iPadOS 26.2. The SDK comes bundled with Xcode 26.2, available from the Mac App Store. For information on the compatibility requirements for Xcode 26.2, see ","type":"text"},{"identifier":"\/documentation\/Xcode-Release-Notes\/xcode-26_2-release-notes","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"AirDrop","level":3,"text":"AirDrop","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: Devices set to “Everyone” on 26.2 beta 1 are not discoverable by devices on 26.2 beta 2.  (163636875)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"DeclaredAgeRange-API","level":3,"text":"DeclaredAgeRange API","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: Usage of the following symbols within the DeclaredAgeRange framework will cause a runtime crash. You must recompile your app against the 26.2 SDK to receive this fix. ","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"AgeRangeService.isEligibleForAgeFeatures","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AgeRangeService.AgeRangeDeclaration.checkedByOtherMethod","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AgeRangeService.AgeRangeDeclaration.guardianCheckedByOtherMethod","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AgeRangeService.AgeRangeDeclaration.governmentIDChecked","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AgeRangeService.AgeRangeDeclaration.guardianGovernmentIDChecked","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AgeRangeService.AgeRangeDeclaration.paymentChecked","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AgeRangeService.AgeRangeDeclaration.guardianPaymentChecked","type":"codeVoice"},{"text":"  (165248390) (FB21121092)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"type":"unorderedList"},{"anchor":"HealthKit","level":3,"text":"HealthKit","type":"heading"},{"anchor":"New-Features","level":4,"text":"New Features","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Hypertension notifications are now available for reading with a new API. Your app can now request authorization for ","type":"text"},{"code":"HKCategoryTypeIdentifierHypertensionEvent","type":"codeVoice"},{"text":" to read notifications resulting from the Hypertension Notifications Feature on Apple Watch.  (153344834)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Instruments","level":3,"text":"Instruments","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: The Allocations instrument sometimes fails to report reference counting operations for native Swift types.  (163080666)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"PermissionKit-API","level":3,"text":"PermissionKit API","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: PermissionKit Significant App Update API is not testable in sandbox.  (163601229)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"StoreKit","level":3,"text":"StoreKit","type":"heading"},{"anchor":"New-Features","level":4,"text":"New Features","type":"heading"},{"items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/developer.apple.com\/documentation\/storekit\/appstore\/ageratingcode","isActive":true,"type":"reference"},{"text":" API provides the current age rating code for your app. Use this property to fetch the age rating and compare it with the last known rating to check for changes.  (160960740)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: An issue prevents the purchase of a subscription using a win-back offer when testing with StoreKit Testing in Xcode.  (162357552) (FB20604848)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Fixed: ","type":"text"},{"code":"SubscriptionStatus.all","type":"codeVoice"},{"text":" returning old ","type":"text"},{"code":"SubscriptionStatus","type":"codeVoice"},{"text":" after a subscription change.  (163505178)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"TLS","level":3,"text":"TLS","type":"heading"},{"anchor":"Known-Issues","level":4,"text":"Known Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"The default TLS Client Hello has been modified. If your app or website communicates with servers configured with strict bot-detection or security policies that only allow traffic with known TLS fingerprints, then users might be unable to login or perform other actions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"TLS Client Hellos are expected to change across releases as Apple works to offer the most secure TLS options. Servers should adopt resilient and adaptable bot-detection policies that can handle changes in TLS Client Hellos. Overly restrictive policies can cause difficult to triage disruptions to user experience.  (163151032)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Watch-Face-Gallery","level":3,"text":"Watch Face Gallery","type":"heading"},{"anchor":"Resolved-Issues","level":4,"text":"Resolved Issues","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Fixed: Watch Face Gallery text is in English only.  (164187878)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"iOS--iPadOS-26","generated":true,"identifiers":["doc:\/\/com.apple.ios-ipados-release-notes\/documentation\/iOS-iPadOS-Release-Notes\/ios-ipados-26_6-release-notes","doc:\/\/com.apple.ios-ipados-release-notes\/documentation\/iOS-iPadOS-Release-Notes\/ios-ipados-26_5-release-notes","doc:\/\/com.apple.ios-ipados-release-notes\/documentation\/iOS-iPadOS-Release-Notes\/ios-ipados-26_4-release-notes","doc:\/\/com.apple.ios-ipados-release-notes\/documentation\/iOS-iPadOS-Release-Notes\/ios-ipados-26_3-release-notes","doc:\/\/com.apple.ios-ipados-release-notes\/documentation\/iOS-iPadOS-Release-Notes\/ios-ipados-26_1-release-notes","doc:\/\/com.apple.ios-ipados-release-notes\/documentation\/iOS-iPadOS-Release-Notes\/ios-ipados-26-release-notes"],"title":"iOS & iPadOS 26"}],"references":{"/documentation/Xcode-Release-Notes/xcode-26_2-r