+            "beforeMain": try JSONSerialization.jsonObject(with: JSONEncoder().encode(beforeMain)),
+            "now": try JSONSerialization.jsonObject(with: JSONEncoder().encode(now)),
+            "nativeDirection": direction, "controllerCreations": controllerCreations,
+            "composition": try JSONSerialization.jsonObject(with: Data(composition.utf8)),
+            "scenario": scenario, "osDisposition": osDisposition,
+        ]
