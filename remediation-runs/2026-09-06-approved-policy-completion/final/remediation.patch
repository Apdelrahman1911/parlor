+    @classmethod
+    def sign(cls, bundle, key, *, algorithm="SHA256withRSA", digest="SHA-256", sigfile="UPLOAD"):
+        cls.tool([
+            "jarsigner", "-keystore", str(key), "-storepass", cls.password,
