\n 'remediation-runs/2026-09-07-local-readiness/reviews/l08-native14-followup-01/draft-freeze.json': '1a803df85b6acab0ad4ca38fa9d43a5be0b47d95bd42bd77970f57b5c26c401c',\n 'remediation-runs/2026-09-07-local-readiness/run_gradle_cycle.py': '1b9e882514bfe5386785d5a71ae32fdc2bc3aa4cc1dd24532709899fbf4f41bc',\n 'remediation-runs/2026-09-08-continuation/controls/run_continuation_controls.py': '1896d5a309e8802b691bfc9a37db2c0ac92dcfb6173d4cee564e5dcfcc234627',\n 'remediation-runs/2026-09-08-continuation/reviews/direct-lifecycle-author-count-addendum-01.json': '6c34261e6903cf7f4d27fbd2ccaa1e44de9ce4c3981a625ee0cc66d89ebe003b',\n 'remediation-runs/2026-09-08-continuation/reviews/direct-lifecycle-author-count-independent-01.json': '30a6cc2bceb26fb1d70b68a5cc6d30351802212df76c2d90b8e7720df8c8044f',\n 'remediation-runs/2026-09-08-continuation/reviews/direct-lifecycle-author-source-02.json': '0e3ef86e9e66708be391630e864f01bfeb9f03bbfa183a0a027bec4a12f951ec',\n 'remediation-runs/2026-09-08-continuation/reviews/direct-lifecycle-draft-freeze-01.json': '4a18e36224c895581515d538f995e6f8a1bd7016a3cf6eba3328712e5535bd08',\n 'remediation-runs/2026-09-08-continuation/reviews/direct-owned-simulator-lifecycle-implementation-independent-01.json': '44239859c10b762b6447234eddbc993ac1e9e65982a0e149250e943941194bdf',\n 'remediation-runs/2026-09-08-continuation/reviews/direct-owned-simulator-lifecycle-persistence-policy-independent-01.json': '756a549e40145cb659c7ac2829974413f179bdd588c5a9f5a41d599531a02f0e',\n 'remediation-runs/2026-09-08-continuation/reviews/direct-simulator-integration-author-01.json': 'a457352a93dd8875ff1f306797a8f56cceed7b063142acc404f54d8bc2a729ae',\n 'remediation-runs/2026-09-08-continuation/reviews/direct-simulator-lifecycle-controls-independent-01.json': '719427b07d3cad552bf638e3c424f09c3e1f334c8aaea855b98e1559913791f7',\n 'remediation-runs/2026-09-08-continuation/reviews/native-metadata-error-preservation-independent-01.json': 'e8dd16bbd4a2f062bde7a8bdd81b6ea3742f4affe0