+    @MainActor private func collectPassiveWindow(_ app: XCUIApplication,
+                                                context: String = "foreground") throws -> [[String: Any]] {
+        XCTAssertTrue(["foreground", "landscape", "portrait"].contains(context))
+        let previous = try dictionary(try readDisplayedObservation(app), "sampling")
+        let ordinal = try XCTUnwrap(previous["ordinal"] as? Int)
+        let button = context == "foreground" ? "parlor-dsc01-window" : "parlor-dsc01-window-" + context
+        app.buttons[button].tap()
+        let state = app.staticTexts["parlor-dsc01-state"]
+        let finished = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
+            guard let data = (state.value as? String)?.data(using: .utf8), data.count <= 8192,
+                  let value = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any] else { return false }
+            if value["harnessError"] != nil { return true } // Fail explicitly below, never wait into a false PASS.
+            guard let window = value["sampling"] as? [String: Any] else { return false }
+            return window["ordinal"] as? Int == ordinal + 1 && window["status"] as? String == "complete" &&
+                   window["context"] as? String == context
+        }, object: nil)
+        XCTAssertEqual(XCTWaiter.wait(for: [finished], timeout: 15), .completed)
+        let final = try readDisplayedObservation(app) // Read only: no Observe tap inside the passive window.
