+def assert_host_language_ack_contract(candidate, original):
+    """Exact source-only correction; no claim of executing Swift queue/lifecycle behavior."""
+    acknowledgement = section(candidate, 'private final class L08HostCallbackClaim {',
+                              'extension DSC01Probe {')
+    waiter = section(candidate, '    private func l08HostPending(',
+                     '    func nextL08HostCommand() {')
+    command_start, command_end = '    func nextL08HostCommand() {', '\nprivate struct L08HostControls: View {'
+    command = section(candidate, command_start, command_end)
+    # Bind complete reviewed additions, not a bag of potentially dead guard strings.
+    # Ownership is read-only and exact, including previous-value presence and System restoration.
+    require(hashlib.sha256(acknowledgement.encode()).hexdigest() ==
+            'e86acac315b31bee505c8afd9a1655208606bd61279f91bc6c9098aeced6b81a',
+            'Host acknowledgement must preserve exact real language ownership')
+    # One pending main-queue chain, boot/index/completion binding, count and monotonic deadline.
+    require(hashlib.sha256(waiter.encode()).hexdigest() ==
+            'fc7e74b8b3ca67010f64d5f0daa885ddcee8339277e566b0dce185104d2e8c70',
+            'Host acknowledgement must remain bounded read-only pending work')
+    # One actual command/callback/sample; a PASS language wait precedes the fresh bound
+    # row and rechecks THAT row, while original FAIL and write-once receipts remain intact.
+    require(hashlib.sha256(command.encode()).hexdigest() ==
+            '20ff81ef6b318bb7884cdfbab1576fd8ff5150bda2820b98dcaca71a1b522ac9',
+            'Host command must preserve single invocation and fresh exact receipt binding')
+    restored = strict.once(candidate, acknowledgement, '')
+    restored = strict.once(restored, waiter, '')
+    restored = strict.once(restored, command, section(original, command_start, command_end))
+    require(restored == original,
+            'Host plan and public controls outside the acknowledgement correction must remain exact')
 
 
