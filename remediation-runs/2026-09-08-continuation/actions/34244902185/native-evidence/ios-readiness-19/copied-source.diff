+         "overlayCountCapped16": min(overlayCount, 16), "overlay": dsc01CatalogRectFields(overlay),
+         "tabCountsCapped16": tabCounts.map { min($0, 16) }, "tabs": tabs.map { dsc01CatalogRectFields($0) },
+         "successorCountCapped16": min(successorCount, 16), "foreground": foreground,
+         "alertPresent": alertPresent, "keyboardPresent": keyboardPresent]
