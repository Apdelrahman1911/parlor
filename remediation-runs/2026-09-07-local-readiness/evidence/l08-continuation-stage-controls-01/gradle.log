on)\n        put("complete_comparisons", JsonArray(completeComparisons.toList()))\n        put("physical_or_store_evidence", false)\n    }.toString()\n\n}\n\ninternal fun requireContext(token: String, scenario: String) {\n    val environment = NSProcessInfo.processInfo.environment\n    check(NSBundle.mainBundle.bundleIdentifier == "com.parlor.app.debug")\n    check(Regex("[A-Fa-f0-9]{8}(-[A-Fa-f0-9]{4}){3}-[A-Fa-f0-9]{12}").matches(token))\n    check(environment["PARLOR_DSC01_SCENARIO"] == scenario)\n    check(environment["SIMULATOR_UDID"] == environment["PARLOR_DSC01_EXPECTED_UDID"])\n    check(environment["SIMULATOR_UDID"] is String)\n}\n\n/** Exact app-container/token paths only; no directory enumeration or broad deletion. */\nprivate class OwnedSnapshotPaths(\n    private val token: String,\n    private val enterStage: (String) -> String,\n    private val recordProtectionComparison: (JsonObject) -> Unit,\n) {\n    private val files = NSFileManager.defaultManager\n    private val home = canonical(NSHomeDirectory())\n    private val legacy: String\n    private val protected: String\n    init {\n        val udid = NSProcessInfo.processInfo.environment["SIMULATOR_UDID"] as String\n        check(home.contains("/CoreSimulator/Devices/$udid/data/Containers/Data/Application/"))\n        legacy = directory(NSDocumentDirectory, "snapshots")\n        protected = directory(NSApplicationSupportDirectory, "Parlor/snapshots")\n    }\n    fun id(alias: String): SessionId {\n        check(alias in setOf("wc", "we", "mon", "moff", "legacy", "damaged", "dual"))\n        return SessionId("l08-${token.lowercase()}-$alias")\n    }\n    private fun name(alias: String) = id(alias).raw + FileBackedSnapshotStore.SUFFIX\n    private fun directory(kind: ULong, tail: String): String {\n        val base = checkNotNull(files.URLForDirectory(kind, NSUserDomainMask, null, false, null)?.path)\n        check(base.startsWith(NSHomeDirectory() + "/"))\n        val path = home + base.removePrefix(NSHomeDirectory()) + "/" + tail\n        requireDirectoryIfPresent(path)\n        return path\n    }\n    private fun requireDirectoryIfPresent(path: String) {\n        check(path.startsWith(home + "/"))\n        var current = home\n        path.removePrefix(home + "/").split(\'/\').forEach { part ->\n            check(part.isNotEmpty() && part != "." && part != ".." && !part.contains(\'\\\\\'))\n            current += "/$part"\n            if (files.fileExistsAtPath(current)) {\n                check(canonical(current) == current)\n                check(files.attributesOfItemAtPath(current, null)?.get(NSFileType) == NSFileTypeDirectory)\n            }\n        }\n    }\n    private fun file(directory: String, alias: String): String {\n        requireDirectoryIfPresent(directory)\n        val result = directory + "/" + name(alias)\n        if (files.fileExistsAtPath(result)) {\n            check(canonical(result) == result)\n            check(files.attributesOfItemAtPath(result, null)?.get(NSFileType) == NSFileTypeRegular)\n        }\n        return result\n    }\n    fun seedLegacy(alias: String, bytes: ByteArray) = seedLegacyInternal(alias, bytes, false)\n    private fun seedLegacyInternal(alias: String, bytes: ByteArray, allowOwnedDual: Boolean) {\n        check(bytes.isNotEmpty() && bytes.size <= 256 * 1024)\n        // Only this explicit synthetic legacy seeding operation creates a\n        // directory. Reads/metadata observers cannot repair production output.\n        requireDirectoryIfPresent(legacy)\n        if (!files.fileExistsAtPath(legacy)) {\n            check(files.createDirectoryAtPath(legacy, false, null, null))\n        }\n        requireDirectoryIfPresent(legacy)\n        val path = file(legacy, alias)\n        check(!files.fileExistsAtPath(path))\n        if (allowOwnedDual) {\n            check(alias == "dual")\n            protectedMetadata(alias, "dual-before-legacy-seed")\n        } else check(!files.fileExistsAtPath(file(protected, alias)))\n        val data = bytes.usePinned { NSData.create(bytes = it.addressOf(0), length = bytes.size.toULong()) }\n        check(files.createFileAtPath(path, data, null))\n        val actual = readBoundedSnapshotBytes(path, 256 * 1024)\n        try { check(actual.contentEquals(bytes)) } finally { actual.fill(0) }\n    }\n    fun seedDualCopyAndDamageTag(legacyBytes: ByteArray) {\n        seedLegacyInternal("dual", legacyBytes, true)\n        val path = file(protected, "dual")\n        val before = readBoundedSnapshotBytes(path, 256 * 1024 + 128)\n        try {\n            check(before.size > 7 + 2 + 16 + 16 + 32)\n            check(before.copyOfRange(0, 9).contentEquals("PARSNAP".encodeToByteArray() + byteArrayOf(1, 16)))\n            val changed = byteArrayOf((before.last().toInt() xor 1).toByte())\n            try {\n                val handle = checkNotNull(NSFileHandle.fileHandleForWritingAtPath(path))\n                try {\n                    handle.seekToFileOffset((before.size - 1).toULong())\n                    val data = changed.usePinned { NSData.create(bytes = it.addressOf(0), length = 1uL) }\n                    handle.writeData(data)\n                    handle.synchronizeFile()\n                } finally { handle.closeFile() }\n                val after = readBoundedSnapshotBytes(path, 256 * 1024 + 128)\n                try {\n                    check(after.size == before.size && after.last() == changed[0])\n                    check((0 until after.lastIndex).all { after[it] == before[it] })\n                } finally { after.fill(0) }\n            } finally { changed.fill(0) }\n        } finally { before.fill(0) }\n        // Observe, never repair, original native metadata after the in-place\n        // synthetic tag mutation. No plaintext fallback/read is performed.\n        protectedMetadata("dual", "dual-after-tag-damage")\n        assertLegacyPresent("dual")\n    }\n    fun assertLegacyPresent(alias: String) { check(files.fileExistsAtPath(file(legacy, alias))) }\n    fun assertLegacyMatches(alias: String, expected: GameSnapshot, json: Json) {\n        val bytes = readBoundedSnapshotBytes(file(legacy, alias), 256 * 1024)\n        try {\n            val decoded = json.decodeFromString(GameSnapshot.serializer(), bytes.decodeToString())\n            try { check(decoded == expected) } finally { decoded.payload.fill(0) }\n        } finally { bytes.fill(0) }\n    }\n    fun assertLegacyAbsent(alias: String) { check(!files.fileExistsAtPath(file(legacy, alias))) }\n    fun assertProtectedAbsent(alias: String) { check(!files.fileExistsAtPath(file(protected, alias))) }\n    fun assertAbsent(alias: String) { assertLegacyAbsent(alias); assertProtectedAbsent(alias) }\n    fun legacyExcluded() { check(excluded(legacy)) }\n    fun protectedMetadata(alias: String, site: String) {\n        val previous = enterStage("metadata-path")\n        val path = file(protected, alias)\n        enterStage("metadata-existence")\n        check(files.fileExistsAtPath(path))\n        enterStage("metadata-directory-backup")\n        check(excluded(protected))\n        enterStage("metadata-file-backup")\n        check(excluded(path))\n        enterStage("metadata-protection-constants")\n        val key = checkNotNull(NSFileProtectionKey)\n        val protection = checkNotNull(NSFileProtectionComplete)\n        enterStage("metadata-directory-protection")\n        val directory = protectionAttributes(protected, key, protection)\n        recordComparison(site, alias, "directory", directory)\n        enterStage("metadata-file-protection")\n        val file = protectionAttributes(path, key, protection)\n        recordComparison(site, alias, "file", file)\n        // Ciphertext header only; never retain or report any stored payload bytes.\n        enterStage("metadata-encrypted-read")\n        val bytes = readBoundedSnapshotBytes(path, 256 * 1024 + 128)\n        try {\n            enterStage("metadata-encrypted-header")\n            check(bytes.take(7).toByteArray().contentEquals("PARSNAP".encodeToByteArray()))\n        } finally { bytes.fill(0) }\n        // Do not restore in finally: a failure must retain the exact failed boundary.\n        enterStage(previous)\n    }\n    private class ProtectionRead(val complete: Boolean, val observation: JsonObject)\n\n    // Exactly one original getter per required check; the equality itself is unchanged.\n    private fun protectionAttributes(path: String, key: String, protection: String): ProtectionRead = memScoped {\n        val error = alloc<ObjCObjectVar<NSError?>>()\n        error.value = null\n        val values = files.attributesOfItemAtPath(path, error.ptr)\n        val value = values?.get(key)\n        ProtectionRead(value == protection, metadataRead(values != null, values?.containsKey(key) == true,\n            when {\n                values == null -> "unavailable"\n                !values.containsKey(key) -> "missing"\n                else -> protectionValue(value)\n            }, error.value))\n    }\n\n    private fun protectionValue(value: Any?): String = when {\n        value == null -> "null"\n        value == NSFileProtectionComplete -> "complete"\n        value == NSFileProtectionNone -> "none"\n        value == NSFileProtectionCompleteUnlessOpen -> "unless-open"\n        value == NSFileProtectionCompleteUntilFirstUserAuthentication -> "until-first-authentication"\n        // The fifth public enum is iOS17+; do not touch its symbol on iOS16.\n        NSProcessInfo.processInfo.isOperatingSystemAtLeastVersion(cValue<NSOperatingSystemVersion> {\n            majorVersion = 17; minorVersion = 0; patchVersion = 0\n        }) && value == NSFileProtectionCompleteWhenUserInactive -> "when-user-inactive"\n        value is String -> "other-string"\n        else -> "non-string"\n    }\n\n    private fun recordComparison(site: String, alias: String, target: String, reading: ProtectionRead) {\n        recordProtectionComparison(buildJsonObject {\n            put("site", site); put("alias", alias); put("target", target)\n            put("attributes", reading.observation)\n            put("comparison", if (reading.complete) "PASS" else "FAIL")\n        })\n    }\n\n    private fun metadataRead(dictionary: Boolean, key: Boolean, value: String, error: NSError?) = buildJsonObject {\n        put("query", "returned"); put("dictionary_present", dictionary); put("key_present", key); put("value", value)\n        put("native_error", buildJsonObject {\n            put("present", error != null)\n            put("domain", when (error?.domain) {\n                null -> "none"\n                NSCocoaErrorDomain -> "cocoa"\n                NSPOSIXErrorDomain -> "posix"\n                else -> "other"\n            })\n            put("code", error?.code ?: 0L)\n        })\n    }\n\n    private fun excluded(path: String): Boolean {\n        val key = checkNotNull(NSURLIsExcludedFromBackupKey)\n        val values = checkNotNull(NSURL.fileURLWithPath(path).resourceValuesForKeys(listOf(key), null))\n        return checkNotNull(values[key] as? NSNumber).boolValue\n    }\n    private fun canonical(path: String): String = memScoped {\n        val buffer = allocArray<ByteVar>(PATH_MAX)\n        checkNotNull(realpath(path, buffer)).toKString()\n    }\n}\n'

