    <string name="setup_intro_continue">Continue</string>
    <string name="setup_intro_continue_description">Advance from the public intro to the rules briefing.</string>

    <!-- Setup: rules briefing -->
    <string name="setup_briefing_eyebrow">HOW TO PLAY</string>
    <string name="setup_briefing_card_1">One of you is the killer. Even you don't know who, until you see your character.</string>
    <string name="setup_briefing_card_2">You may lie. You should lie. Especially if you're guilty.</string>
    <string name="setup_briefing_card_3">Each round, the app reveals a new clue. Discuss. Accuse. Suspect.</string>
    <string name="setup_briefing_card_4">Vote according to your chosen mode. Get it wrong, the killer wins.</string>
    <string name="setup_briefing_continue">Continue</string>
    <string name="setup_briefing_begin">Begin the Investigation</string>
    <string name="setup_briefing_continue_description">Advance to the next briefing card.</string>
    <string name="setup_briefing_begin_description">Begin the investigation.</string>

    <!-- Character reveal -->
    <string name="reveal_handoff_title_format">Pass to %1$s.</string>
    <string name="reveal_handoff_subtitle">When you're alone with the phone, tap to continue.</string>
    <string name="reveal_waiting_eyebrow">Hold tight</string>
    <string name="reveal_waiting_title_format">%1$s is reading their dossier.</string>
    <string name="reveal_waiting_subtitle">When they're done, the room moves on. You'll see your own dossier when it's your turn.</string>

    <!-- Peer-side gating: host controls progression; peer sees these. -->
    <string name="peer_waiting_eyebrow">Round in progress</string>
