// Copied XCTest only. Public Apple Support109358 flow on the exact NEW runner-
// owned simulator: Settings > General > Language & Region > Add Language.
// This is a bounded experiment, not a documented guarantee that any particular
// iOS26.5 Settings selector/per-app language row must exist after two languages.
private enum DSC01OSPrerequisiteStage: String {
    case ownership, settingsRoot, general, languageRegion, initialEnglishPrimary
    case addLanguage, searchArabic, selectArabic, retainEnglishPrimary, finalPreferredLanguages
}

private enum DSC01OSInitialDisposition: String {
    case alreadySatisfied = "already-satisfied"
    case requiresArabic = "requires-arabic"
    case blocked
}

private enum DSC01OSPrerequisiteControl: String {
    case general, languageRegion, addLanguage, arabic

    var labels: [String] {
        switch self {
        case .general: return ["General"]
        case .languageRegion: return ["Language & Region"]
        case .addLanguage: return ["Add Language…", "Add Language...", "Add Language"]
        case .arabic: return ["Arabic", "العربية", "Arabic, العربية", "العربية, Arabic"]
        }
    }
}

@MainActor private final class DSC01OSPrerequisiteDiagnostics {
    private var ordinal = 0
    private var bytes = 0

    func append(stage: DSC01OSPrerequisiteStage, status: String, fields: [String: Any]) throws {
        guard ["observe", "before-activation", "after-activation", "PASS", "BLOCKED"].contains(status),
              ordinal < 96 else { throw NSError(domain: "DSC01OSPrerequisiteDiagnosticBudget", code: 1) }
        ordinal += 1
        let row: [String: Any] = ["schemaVersion": 1, "ordinal": ordinal, "stage": stage.rawValue,
            "status": status, "fields": fields]
        let encoded = try JSONSerialization.data(withJSONObject: row, options: [.sortedKeys])
        bytes += encoded.count
        guard encoded.count <= 8192, bytes <= 196608,
              let text = String(data: encoded, encoding: .utf8) else {
            throw NSError(domain: "DSC01OSPrerequisiteDiagnosticBudget", code: 2)
        }
        print("DSC01_OS_PREREQUISITE " + text)
    }
}

extension IOSAppLaunchUITests {
    @MainActor private func osPrerequisiteQueries(_ settings: XCUIApplication,
        control: DSC01OSPrerequisiteControl) -> [(String, XCUIElementQuery)] {
        let predicate = NSPredicate(format: "label IN %@", control.labels)
        // Exact whitelisted semantic row only. UITableView and SwiftUI can
        // expose the same PUBLIC row as a cell/button/text. A unique cell is
        // preferred, then a unique button, then a unique exact visible text.
        // An ambiguous nonempty class fails; it never falls through to another.
        return [("cell-containing-known-text", settings.cells.containing(predicate)),
                ("known-button", settings.buttons.matching(predicate)),
                ("known-text", settings.staticTexts.matching(predicate))]
    }

    @MainActor private func osPrerequisiteMetadata(_ settings: XCUIApplication,
        control: DSC01OSPrerequisiteControl? = nil) -> [String: Any] {
        var value: [String: Any] = ["foreground": settings.state == .runningForeground,
            "viewport": dsc01CatalogRectFields(settings.frame),
            "alertCountCapped16": min(settings.alerts.count, 16),
            "sheetCountCapped16": min(settings.sheets.count, 16),
            "keyboardPresent": settings.keyboards.firstMatch.exists]
        let titles = ["Settings", "General", "Language & Region", "Add Language", "iPhone Language"]
        value["knownNavigationTitles"] = titles.map { title -> [String: Any] in
            ["knownTitle": title, "countCapped16": min(settings.navigationBars.matching(identifier: title).count, 16)]
        }
        if let control {
            value["knownControl"] = control.rawValue
            value["selectorClasses"] = osPrerequisiteQueries(settings, control: control).map { kind, query in
                let count = query.count
                let samples = count < 16 ? Array(query.allElementsBoundByIndex.prefix(2)) : []
                return ["kind": kind, "countCapped16": min(count, 16), "atMostTwo": samples.map { item in
                    ["hittable": item.isHittable, "enabled": item.isEnabled, "frame": dsc01CatalogRectFields(item.frame)]
                }] as [String: Any]
            }
        }
        return value
    }

    @MainActor private func osPrimaryChoiceMetadata(_ settings: XCUIApplication) -> [String: Any] {
        var fields = osPrerequisiteMetadata(settings)
        let knownChoice = NSPredicate(format: "label IN %@", ["Use English", "Keep English", "Use English (US)"])
        // Independent public counts only: no unknown labels, hierarchy dump or
        // required-element property access while a modal may be transitioning.
        fields["primaryChoiceModalCounts"] = [("alert", settings.alerts), ("sheet", settings.sheets)].map { kind, query in
            ["representation": kind, "countCapped16": min(query.count, 16),
             "buttonCountCapped16": min(query.buttons.count, 16),
             "englishPrimaryChoiceCountCapped16": min(query.buttons.matching(knownChoice).count, 16)] as [String: Any]
        }
        return fields
    }

    @MainActor private func osPrerequisiteBlock(_ stage: DSC01OSPrerequisiteStage,
        diagnostics: DSC01OSPrerequisiteDiagnostics, fields: [String: Any]) throws -> Never {
        try diagnostics.append(stage: stage, status: "BLOCKED", fields: fields)
        XCTFail("Actual OS multilingual prerequisite BLOCKED at public stage: " + stage.rawValue)
        throw NSError(domain: "DSC01OSPrerequisiteBlocked." + stage.rawValue, code: 1)
    }

    @MainActor private func osPrerequisiteTitle(_ settings: XCUIApplication, title: String,
        stage: DSC01OSPrerequisiteStage, diagnostics: DSC01OSPrerequisiteDiagnostics) throws {
        try diagnostics.append(stage: stage, status: "observe", fields: osPrerequisiteMetadata(settings))
        let query = settings.navigationBars.matching(identifier: title)
        let appeared = query.firstMatch.waitForExistence(timeout: 15)
        let fields = osPrerequisiteMetadata(settings)
        guard appeared, query.count == 1, settings.state == .runningForeground, settings.alerts.count == 0 else {
            try osPrerequisiteBlock(stage, diagnostics: diagnostics, fields: fields)
        }
        try diagnostics.append(stage: stage, status: "PASS", fields: fields)
    }

    @MainActor private func osPrerequisiteTapRow(_ settings: XCUIApplication,
        control: DSC01OSPrerequisiteControl, stage: DSC01OSPrerequisiteStage,
        diagnostics: DSC01OSPrerequisiteDiagnostics, allowScroll: Bool = true) throws {
        var selected: XCUIElement?
        for attempt in 1...6 {
            var fields = osPrerequisiteMetadata(settings, control: control)
            fields["attempt"] = attempt
            try diagnostics.append(stage: stage, status: "observe", fields: fields)
            guard settings.state == .runningForeground, settings.alerts.count == 0 else {
                try osPrerequisiteBlock(stage, diagnostics: diagnostics, fields: fields)
            }
            for (_, query) in osPrerequisiteQueries(settings, control: control) {
                let count = query.count
                if count == 0 { continue }
                guard count == 1 else { try osPrerequisiteBlock(stage, diagnostics: diagnostics, fields: fields) }
                let target = query.firstMatch
                if target.isHittable && target.isEnabled && dsc01CatalogFinite(target.frame) {
                    selected = target
                }
                break
            }
            if selected != nil { break }
            if attempt < 6 {
                if allowScroll && !settings.keyboards.firstMatch.exists { settings.swipeUp(velocity: .slow) }
                try catalogSamplingInterval()
            }
        }
        guard let selected else {
            try osPrerequisiteBlock(stage, diagnostics: diagnostics, fields: osPrerequisiteMetadata(settings, control: control))
        }
        // One activation of this semantic OS step, never retried on missing successor.
        try diagnostics.append(stage: stage, status: "before-activation",
            fields: osPrerequisiteMetadata(settings, control: control))
        guard selected.isHittable, selected.isEnabled, settings.state == .runningForeground,
              settings.alerts.count == 0 else {
            try osPrerequisiteBlock(stage, diagnostics: diagnostics, fields: osPrerequisiteMetadata(settings, control: control))
        }
        selected.tap()
        try diagnostics.append(stage: stage, status: "after-activation",
            fields: osPrerequisiteMetadata(settings, control: control))
    }

    @MainActor private func osPreferredLanguagesMetadata(_ settings: XCUIApplication) -> [String: Any] {
        let englishCells = settings.cells.containing(NSPredicate(format: "label == %@", "English"))
            .containing(NSPredicate(format: "label == %@", "iPhone Language"))
        let mergedEnglish = settings.descendants(matching: .any)
            .matching(NSPredicate(format: "label == %@", "English, iPhone Language"))
        let arabicCells = settings.cells.containing(NSPredicate(format: "label IN %@", ["Arabic", "العربية"]))
        let arabicTexts = settings.staticTexts.matching(NSPredicate(format: "label IN %@", ["Arabic", "العربية"]))
        let titles = settings.navigationBars.matching(identifier: "Language & Region")
        let english = englishCells.count == 1 ? englishCells.firstMatch :
            (mergedEnglish.count == 1 ? mergedEnglish.firstMatch : nil)
        let arabic = arabicCells.count == 1 ? arabicCells.firstMatch : nil
        var addLanguage: XCUIElement?
        for (_, query) in osPrerequisiteQueries(settings, control: .addLanguage) {
            let count = query.count
            if count == 0 { continue }
            if count == 1 { addLanguage = query.firstMatch }
            break
        }
        let englishFrame = english?.frame
        let arabicFrame = arabic?.frame
        let addFrame = addLanguage?.frame
        var orderedPreferredRows = false
        if let englishFrame, let arabicFrame, let addFrame,
           [englishFrame, arabicFrame, addFrame].allSatisfy(dsc01CatalogFinite) {
            orderedPreferredRows = englishFrame.maxY <= arabicFrame.minY + 1 && arabicFrame.maxY <= addFrame.minY + 1
        }
        var fields = osPrerequisiteMetadata(settings, control: .addLanguage)
        fields["englishPrimaryCellCountCapped16"] = min(englishCells.count, 16)
        fields["mergedEnglishPrimaryCountCapped16"] = min(mergedEnglish.count, 16)
        fields["arabicCellCountCapped16"] = min(arabicCells.count, 16)
        fields["arabicTextCountCapped16"] = min(arabicTexts.count, 16)
        fields["englishPrimaryObserved"] = englishCells.count == 1 || mergedEnglish.count == 1
        fields["arabicObserved"] = arabicCells.count == 1 || (1...2).contains(arabicTexts.count)
        fields["languageRegionTitleObserved"] = titles.count == 1
        fields["languageRegionTitleHittable"] = titles.count == 1 && titles.firstMatch.isHittable
        fields["searchFieldCountCapped16"] = min(settings.searchFields.count, 16)
        fields["englishPrimaryHittable"] = english?.isHittable ?? false
        fields["addLanguageSuccessorHittableEnabled"] = (addLanguage?.isHittable ?? false) && (addLanguage?.isEnabled ?? false)
        fields["arabicPreferredRowObserved"] = arabic != nil && (arabic?.isHittable ?? false) && orderedPreferredRows
        fields["englishPrimaryFrame"] = dsc01CatalogRectFields(englishFrame)
        fields["arabicPreferredRowFrame"] = dsc01CatalogRectFields(arabicFrame)
        fields["addLanguageSuccessorFrame"] = dsc01CatalogRectFields(addFrame)
        return fields
    }

    private func osObservedFrame(_ observed: [String: Any], key: String) -> CGRect? {
        guard let value = observed[key] as? [String: Any], value["present"] as? Bool == true,
              value["validFiniteRectangle"] as? Bool == true,
              let numbers = value["rectangle"] as? [CGFloat], numbers.count == 4 else { return nil }
        let frame = CGRect(x: numbers[0], y: numbers[1], width: numbers[2], height: numbers[3])
        return dsc01CatalogFinite(frame) ? frame : nil
    }

    private func osEnglishPrimaryListIsUncovered(_ observed: [String: Any]) -> Bool {
        guard observed["foreground"] as? Bool == true, observed["alertCountCapped16"] as? Int == 0,
              observed["keyboardPresent"] as? Bool == false, observed["searchFieldCountCapped16"] as? Int == 0,
              ["languageRegionTitleObserved", "languageRegionTitleHittable", "englishPrimaryObserved",
               "englishPrimaryHittable", "addLanguageSuccessorHittableEnabled"]
                .allSatisfy({ observed[$0] as? Bool == true }),
              let cells = observed["englishPrimaryCellCountCapped16"] as? Int,
              let merged = observed["mergedEnglishPrimaryCountCapped16"] as? Int,
              (0...1).contains(cells), (0...1).contains(merged), cells + merged >= 1,
              let viewport = osObservedFrame(observed, key: "viewport"),
              let english = osObservedFrame(observed, key: "englishPrimaryFrame"),
              let add = osObservedFrame(observed, key: "addLanguageSuccessorFrame") else { return false }
        return viewport.contains(english) && viewport.contains(add) && english.maxY <= add.minY + 1
    }

    private func osPreferredListIsUncovered(_ observed: [String: Any]) -> Bool {
        // A presented picker can leave underlying labels in the AX tree. The
        // actual preferred list must be exposed, ordered and interactable after
        // English-primary selection; a global Arabic search result is not proof.
        guard osEnglishPrimaryListIsUncovered(observed),
              observed["arabicCellCountCapped16"] as? Int == 1,
              let viewport = osObservedFrame(observed, key: "viewport"),
              let english = osObservedFrame(observed, key: "englishPrimaryFrame"),
              let arabic = osObservedFrame(observed, key: "arabicPreferredRowFrame"),
              let add = osObservedFrame(observed, key: "addLanguageSuccessorFrame"),
              viewport.contains(arabic), english.maxY <= arabic.minY + 1,
              arabic.maxY <= add.minY + 1 else { return false }
        return observed["foreground"] as? Bool == true && observed["alertCountCapped16"] as? Int == 0 &&
            observed["keyboardPresent"] as? Bool == false && observed["searchFieldCountCapped16"] as? Int == 0 &&
            ["languageRegionTitleObserved", "languageRegionTitleHittable", "englishPrimaryObserved",
             "englishPrimaryHittable", "arabicObserved", "arabicPreferredRowObserved", "addLanguageSuccessorHittableEnabled"]
            .allSatisfy { observed[$0] as? Bool == true }
    }

    private func osInitialDisposition(_ observed: [String: Any]) -> DSC01OSInitialDisposition {
        if osPreferredListIsUncovered(observed) { return .alreadySatisfied }
        guard osEnglishPrimaryListIsUncovered(observed), observed["arabicObserved"] as? Bool == false,
              observed["arabicCellCountCapped16"] as? Int == 0,
              observed["arabicTextCountCapped16"] as? Int == 0 else { return .blocked }
        return .requiresArabic
    }

    private func verifyOSPrerequisiteDecisionContract() throws {
        let present: [String: Any] = ["foreground": true, "alertCountCapped16": 0,
            "keyboardPresent": false, "searchFieldCountCapped16": 0,
            "languageRegionTitleObserved": true, "languageRegionTitleHittable": true,
            "englishPrimaryObserved": true, "englishPrimaryHittable": true,
            "addLanguageSuccessorHittableEnabled": true, "englishPrimaryCellCountCapped16": 1,
            "mergedEnglishPrimaryCountCapped16": 0, "arabicObserved": true,
            "arabicCellCountCapped16": 1, "arabicTextCountCapped16": 2, "arabicPreferredRowObserved": true,
            "viewport": dsc01CatalogRectFields(CGRect(x: 0, y: 0, width: 402, height: 874)),
            "englishPrimaryFrame": dsc01CatalogRectFields(CGRect(x: 20, y: 171, width: 362, height: 68)),
            "arabicPreferredRowFrame": dsc01CatalogRectFields(CGRect(x: 20, y: 239, width: 362, height: 68)),
            "addLanguageSuccessorFrame": dsc01CatalogRectFields(CGRect(x: 20, y: 307, width: 362, height: 55))]
        var absent = present
        absent["arabicObserved"] = false; absent["arabicCellCountCapped16"] = 0
        absent["arabicTextCountCapped16"] = 0; absent["arabicPreferredRowObserved"] = false
        absent["arabicPreferredRowFrame"] = dsc01CatalogRectFields(nil)
        var cases: [(String, [String: Any], DSC01OSInitialDisposition)] = [
            ("already-satisfied", present, .alreadySatisfied), ("missing-Arabic", absent, .requiresArabic)]
        for (name, key, value) in [
            ("background", "foreground", false), ("covered-picker", "searchFieldCountCapped16", 1),
            ("keyboard", "keyboardPresent", true), ("alert", "alertCountCapped16", 1),
            ("wrong-primary", "englishPrimaryObserved", false), ("hidden-primary", "englishPrimaryHittable", false),
            ("hidden-title", "languageRegionTitleHittable", false), ("missing-title", "languageRegionTitleObserved", false),
            ("disabled-successor", "addLanguageSuccessorHittableEnabled", false),
            ("ambiguous-primary", "englishPrimaryCellCountCapped16", 2),
            ("ambiguous-merged-primary", "mergedEnglishPrimaryCountCapped16", 2),
            ("ambiguous-Arabic", "arabicCellCountCapped16", 2),
            ("nonpreferred-Arabic", "arabicPreferredRowObserved", false)
        ] as [(String, String, Any)] {
            var changed = present; changed[key] = value; cases.append((name, changed, .blocked))
        }
        for (name, key, frame) in [
            ("Arabic-before-English", "arabicPreferredRowFrame", CGRect(x: 20, y: 100, width: 362, height: 68)),
            ("Arabic-after-Add", "arabicPreferredRowFrame", CGRect(x: 20, y: 380, width: 362, height: 68)),
            ("English-after-Add", "englishPrimaryFrame", CGRect(x: 20, y: 380, width: 362, height: 68)),
            ("offscreen-Arabic", "arabicPreferredRowFrame", CGRect(x: -500, y: 239, width: 362, height: 68)),
            ("nonfinite-English", "englishPrimaryFrame", CGRect(x: CGFloat.nan, y: 171, width: 362, height: 68))
        ] {
            var changed = present; changed[key] = dsc01CatalogRectFields(frame)
            cases.append((name, changed, .blocked))
        }
        var coveredAbsent = absent; coveredAbsent["searchFieldCountCapped16"] = 1
        cases.append(("missing-Arabic-covered-picker", coveredAbsent, .blocked))
        var ambiguousAbsent = absent; ambiguousAbsent["arabicTextCountCapped16"] = 1
        cases.append(("inconsistent-Arabic-absence", ambiguousAbsent, .blocked))
        var missingFrame = present; missingFrame["englishPrimaryFrame"] = dsc01CatalogRectFields(nil)
        cases.append(("missing-English-frame", missingFrame, .blocked))
        var mergedOnly = present; mergedOnly["englishPrimaryCellCountCapped16"] = 0
        mergedOnly["mergedEnglishPrimaryCountCapped16"] = 1
        cases.append(("unique-merged-English-primary", mergedOnly, .alreadySatisfied))
        XCTAssertEqual(cases.count, 24)
        for (name, observed, expected) in cases {
            XCTAssertEqual(osInitialDisposition(observed), expected, "Pure public OS prerequisite: " + name)
        }
        print("DSC01_OS_PREREQUISITE_DECISION_CONTRACT {\"schemaVersion\":1,\"cases\":24,\"passed\":true}")
    }

    @MainActor private func prepareActualOSMultilingualPrerequisite(_ app: XCUIApplication,
        expectedSimulator: String) throws {
        try verifyOSPrerequisiteDecisionContract()
        let diagnostics = DSC01OSPrerequisiteDiagnostics()
        #if DEBUG && targetEnvironment(simulator)
        let environment = ProcessInfo.processInfo.environment
        let sameSimulator = environment["SIMULATOR_UDID"] == expectedSimulator && UUID(uuidString: expectedSimulator) != nil
        // The source-copy renderer binds the exact fresh allocation, not merely
        // a prefix that could identify a different campaign's simulator.
        let ownedName = environment["SIMULATOR_DEVICE_NAME"] == __PARLOR_EXPECTED_SIMULATOR_NAME__
        let ownership: [String: Any] = ["sameExpectedSimulator": sameSimulator, "ownedSyntheticDeviceName": ownedName,
            "debugSimulatorBuild": true]
        guard sameSimulator, ownedName else { try osPrerequisiteBlock(.ownership, diagnostics: diagnostics, fields: ownership) }
        try diagnostics.append(stage: .ownership, status: "PASS", fields: ownership)
        #else
        try osPrerequisiteBlock(.ownership, diagnostics: diagnostics, fields: ["debugSimulatorBuild": false])
        #endif
        // Both complete local-game receipts precede this. Do not mutate a user
        // phone/profile, another task's simulator, or a retained active session.
        app.terminate()
        guard app.wait(for: .notRunning, timeout: 15) else {
            try osPrerequisiteBlock(.ownership, diagnostics: diagnostics, fields: ["testAppTerminated": false])
        }
        let settings = XCUIApplication(bundleIdentifier: "com.apple.Preferences")
        settings.launchArguments = [] // Never inject AppleLanguages/AppleLocale.
        defer { settings.terminate() }
        settings.launch()
        try osPrerequisiteTitle(settings, title: "Settings", stage: .settingsRoot, diagnostics: diagnostics)
        try osPrerequisiteTapRow(settings, control: .general, stage: .general, diagnostics: diagnostics)
        try osPrerequisiteTitle(settings, title: "General", stage: .general, diagnostics: diagnostics)
        try osPrerequisiteTapRow(settings, control: .languageRegion, stage: .languageRegion, diagnostics: diagnostics)
        try osPrerequisiteTitle(settings, title: "Language & Region", stage: .languageRegion, diagnostics: diagnostics)
        var initial = osPreferredLanguagesMetadata(settings)
        let disposition = osInitialDisposition(initial)
        initial["prerequisiteDisposition"] = disposition.rawValue
        try diagnostics.append(stage: .initialEnglishPrimary, status: "observe", fields: initial)
        guard disposition != .blocked, initial["sheetCountCapped16"] as? Int == 0 else {
            try osPrerequisiteBlock(.initialEnglishPrimary, diagnostics: diagnostics, fields: initial)
        }
        try diagnostics.append(stage: .initialEnglishPrimary, status: "PASS", fields: initial)
        if disposition == .alreadySatisfied {
            // A new simulator identity does not prove a monolingual default.
            // Reobserve the actual exposed preferred list; no language is added
            // or reordered, and its origin is deliberately not inferred.
            var final = osPreferredLanguagesMetadata(settings)
            guard osPreferredListIsUncovered(final), final["sheetCountCapped16"] as? Int == 0 else {
                try osPrerequisiteBlock(.finalPreferredLanguages, diagnostics: diagnostics, fields: final)
            }
            final["prerequisiteDisposition"] = "already-satisfied"
            final["arabicAddedByThisPrerequisite"] = false
            try diagnostics.append(stage: .finalPreferredLanguages, status: "PASS", fields: final)
            return // Original per-app Settings/System/restart still runs next.
        }
        try osPrerequisiteTapRow(settings, control: .addLanguage, stage: .addLanguage, diagnostics: diagnostics)
        try diagnostics.append(stage: .searchArabic, status: "observe", fields: osPrerequisiteMetadata(settings, control: .arabic))
        let search = settings.searchFields
        guard search.firstMatch.waitForExistence(timeout: 15), search.count == 1,
              search.firstMatch.isHittable, search.firstMatch.isEnabled, settings.alerts.count == 0 else {
            try osPrerequisiteBlock(.searchArabic, diagnostics: diagnostics, fields: osPrerequisiteMetadata(settings, control: .arabic))
        }
        try diagnostics.append(stage: .searchArabic, status: "before-activation",
            fields: ["uniqueSearchField": true, "frame": dsc01CatalogRectFields(search.firstMatch.frame)])
        search.firstMatch.tap()
        search.firstMatch.typeText("Arabic") // Real public Settings search, once; no backing preference write.
        try diagnostics.append(stage: .searchArabic, status: "after-activation", fields: osPrerequisiteMetadata(settings, control: .arabic))
        try osPrerequisiteTapRow(settings, control: .arabic, stage: .selectArabic, diagnostics: diagnostics, allowScroll: false)
        try diagnostics.append(stage: .retainEnglishPrimary, status: "observe", fields: osPrimaryChoiceMetadata(settings))
        let appeared = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
            settings.alerts.count > 0 || settings.sheets.count > 0
        }, object: nil)
        let modalOutcome = XCTWaiter.wait(for: [appeared], timeout: 15)
        let alertCount = settings.alerts.count
        let sheetCount = settings.sheets.count
        // Public Settings may expose the choice as an Alert OR a Sheet. Never
        // guess which is active when neither, both, or multiple containers exist.
        let modal = alertCount == 1 && sheetCount == 0 ? settings.alerts.firstMatch :
            (alertCount == 0 && sheetCount == 1 ? settings.sheets.firstMatch : nil)
        guard modalOutcome == .completed, let modal, settings.state == .runningForeground else {
            try osPrerequisiteBlock(.retainEnglishPrimary, diagnostics: diagnostics, fields: osPrimaryChoiceMetadata(settings))
        }
        // These exact English-primary action labels are bounded candidate UI
        // selectors, not a claim that Apple guarantees them on every version.
        // No generic OK/Continue/Cancel or unknown alert is ever dismissed.
        let keepEnglish = modal.buttons.matching(NSPredicate(format: "label IN %@", ["Use English", "Keep English", "Use English (US)"]))
        var keepFields = osPrimaryChoiceMetadata(settings)
        keepFields["primaryChoiceRepresentation"] = alertCount == 1 ? "alert" : "sheet"
        keepFields["englishPrimaryChoiceCountCapped16"] = min(keepEnglish.count, 16)
        keepFields["primaryChoiceButtonCountCapped16"] = min(modal.buttons.count, 16)
        try diagnostics.append(stage: .retainEnglishPrimary, status: "before-activation", fields: keepFields)
        guard settings.alerts.count == alertCount, settings.sheets.count == sheetCount,
              settings.state == .runningForeground,
              keepEnglish.count == 1, (1...4).contains(modal.buttons.count),
              keepEnglish.firstMatch.isHittable, keepEnglish.firstMatch.isEnabled else {
            try osPrerequisiteBlock(.retainEnglishPrimary, diagnostics: diagnostics, fields: keepFields)
        }
        keepEnglish.firstMatch.tap() // Exactly once; final actual preferred list must prove the result.
        try diagnostics.append(stage: .retainEnglishPrimary, status: "after-activation", fields: osPrimaryChoiceMetadata(settings))
        let settled = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
            let observed = self.osPreferredLanguagesMetadata(settings)
            return self.osPreferredListIsUncovered(observed) && observed["sheetCountCapped16"] as? Int == 0
        }, object: nil)
        let outcome = XCTWaiter.wait(for: [settled], timeout: 20)
        var final = osPreferredLanguagesMetadata(settings)
        guard outcome == .completed, osPreferredListIsUncovered(final), final["sheetCountCapped16"] as? Int == 0 else {
            try osPrerequisiteBlock(.finalPreferredLanguages, diagnostics: diagnostics, fields: final)
        }
        final["prerequisiteDisposition"] = "arabic-added"
        final["arabicAddedByThisPrerequisite"] = true
        try diagnostics.append(stage: .finalPreferredLanguages, status: "PASS", fields: final)
        // This only establishes the actual global UI prerequisite. The original
        // per-app Settings selection/AR→System/restart proof runs independently.
    }
}
