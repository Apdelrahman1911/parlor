// Copy-only app-host entry. No direct SecItem query and no second DI graph.
import MachO
import CryptoKit
import Darwin

private let nativeReadinessSigningMode = __PARLOR_NATIVE_SIGNING_MODE__
private let nativeReadinessTaskRoot = __PARLOR_NATIVE_TASK_ROOT__
private let nativeReadinessProductRoot = __PARLOR_NATIVE_PRODUCT_ROOT__

extension DSC01Probe {
    // V12's synthetic prior-language fixture intentionally writes this one
    // app-domain value. Undo ONLY that attested test write before investigating
    // a real OS-created preference. This is not production migration logic.
    func restoreOwnedSyntheticSettingsSeed(token: String) throws {
        precondition(Thread.isMainThread && scenario == "readiness" && !prepared)
        let url = FileManager.default.temporaryDirectory.appendingPathComponent("parlor-dsc01-settings-result.json")
        let bytes = try FileManager.default.attributesOfItem(atPath: url.path)[.size] as? NSNumber
        guard let bytes, (1...262144).contains(bytes.intValue),
              !FileManager.default.fileExists(atPath: resultURL.path) else { throw fixtureError() }
        let cleanupURL = FileManager.default.temporaryDirectory.appendingPathComponent(
            "parlor-native-synthetic-seed-cleanup.json")
        guard !FileManager.default.fileExists(atPath: cleanupURL.path) else { throw fixtureError() }
        let settings = try JSONDecoder().decode(DSC01Report.self, from: Data(contentsOf: url))
        let completions = settings.observations.filter { $0.phase == "complete" }
        guard settings.schemaVersion == 6, settings.runToken == token, settings.scenario == "settings", settings.completed,
              (3...256).contains(settings.observations.count), completions.count == 1,
              let completed = completions.first,
              let first = settings.observations.first, let last = settings.observations.last,
              first.phase == "before_main", first.fixture == "fresh",
              first.preferences.setting == "system", !first.preferences.hasAppOverride,
              !first.preferences.ownerPresent, first.preferences.appLanguages == [],
              completed.preferences == last.preferences, completed.boot == last.boot,
              last.preferences.setting == "system", !last.preferences.ownerPresent,
              last.preferences.appLanguages == ["ar-EG", "en"],
              settings.observations.enumerated().allSatisfy({ $0.element.ordinal == $0.offset + 1 }),
              settings.observations.filter({ $0.ordinal > completed.ordinal }).allSatisfy({
                  $0.phase == "sample" && $0.boot == completed.boot && $0.preferences == completed.preferences
              }),
              settings.observations.contains(where: {
                  $0.phase == "before_main" && $0.fixture == "previous-ar" &&
                      $0.ordinal < completed.ordinal &&
                      $0.preferences.appLanguages == ["ar-EG", "en"] && !$0.preferences.ownerPresent
              }), settings.observations.allSatisfy({ $0.osDisposition == "not-investigated" }),
              try preferences() == last.preferences else { throw fixtureError() }
        UserDefaults.standard.removeObject(forKey: "AppleLanguages")
        let restored = try preferences()
        guard restored.setting == "system", !restored.hasAppOverride, !restored.ownerPresent else { throw fixtureError() }
        let record: [String: Any] = ["schema_version": 2, "run_token": token, "process_boot": boot,
            "original_present": false, "synthetic_previous": ["ar-EG", "en"], "restored_present": false,
            "source": "completed-token-bound-owned-settings-fixture-only"]
        let encoded = try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys])
        guard encoded.count <= 1024 else { throw fixtureError() }
        // App stdout is not an XCTest stdout transport. Preserve an exclusive,
        // token/boot-bound result in this owned sandbox for host extraction.
        // Foundation forbids combining .withoutOverwriting with .atomic.
        // Partial/interrupted records fail closed; no prior record is replaced.
        try encoded.write(to: cleanupURL, options: [.withoutOverwriting])
    }

    func startNativeReadiness() {
        precondition(Thread.isMainThread && scenario == "readiness" && nativeReadinessDisplay == "pending")
        guard let value = ProcessInfo.processInfo.environment["PARLOR_READINESS_BOOT"],
              let ordinal = Int(value), (1...8).contains(ordinal) else {
            nativeReadinessDisplay = "invalid-context"; return
        }
        nativeReadinessDisplay = "running"
        MainViewControllerKt.NativeReadinessStart(boot: Int32(ordinal)) { [weak self] json in
            DispatchQueue.main.async {
                guard let self else { return }
                var stage = "observation-decode"
                do {
                    let data = Data(json.utf8)
                    guard data.count <= 32768,
                          let observed = try JSONSerialization.jsonObject(with: data) as? [String: Any] else {
                        throw self.fixtureError()
                    }
                    stage = "image-observation"
                    let images = try nativeReadinessLoadedImages()
                    stage = "loader-environment"
                    let loaderEnvironment = try nativeReadinessLoaderEnvironment()
                    let report: [String: Any] = ["schema_version": 2, "boot_ordinal": ordinal,
                        "signing_mode": nativeReadinessSigningMode,
                        "process_boot": self.boot, "process_id": ProcessInfo.processInfo.processIdentifier,
                        "run_token": ProcessInfo.processInfo.environment["PARLOR_DSC01_RUN_TOKEN"] ?? "",
                        "loaded_app_images": images.app, "loaded_compose_framework": images.framework,
                        "loader_environment": loaderEnvironment, "observation": observed]
                    stage = "receipt-encode"
                    let encoded = try JSONSerialization.data(withJSONObject: report, options: [.sortedKeys])
                    guard encoded.count <= 49152 else { throw self.fixtureError() }
                    stage = "receipt-destination"
                    let url = FileManager.default.temporaryDirectory.appendingPathComponent(
                        "parlor-native-readiness-boot-\(ordinal).json")
                    guard !FileManager.default.fileExists(atPath: url.path) else { throw self.fixtureError() }
                    stage = "receipt-write"
                    try encoded.write(to: url, options: [.withoutOverwriting])
                    self.nativeReadinessDisplay = String(decoding: encoded, as: UTF8.self)
                } catch {
                    // Retain only a fixed stage and allowlisted numeric error
                    // metadata. Never retain error descriptions/userInfo, raw
                    // loader paths/environment, or unvalidated observations.
                    do {
                        let encoded = try nativeReadinessFailureData(stage: stage, error: error,
                            ordinal: ordinal, boot: self.boot,
                            token: ProcessInfo.processInfo.environment["PARLOR_DSC01_RUN_TOKEN"] ?? "",
                            signingMode: nativeReadinessSigningMode)
                        let url = FileManager.default.temporaryDirectory.appendingPathComponent(
                            "parlor-native-readiness-failure-\(ordinal).json")
                        try encoded.write(to: url, options: [.withoutOverwriting])
                        self.nativeReadinessDisplay = String(decoding: encoded, as: UTF8.self)
                    } catch {
                        self.nativeReadinessDisplay = "failure-receipt-unavailable"
                    }
                }
            }
        }
    }
}

// BEGIN BOUNDED FAILURE ENCODER (also executed with Foundation in host controls).
private func nativeReadinessFailureData(stage: String, error: Error, ordinal: Int,
                                       boot: String, token: String, signingMode: String) throws -> Data {
    let stages = ["observation-decode", "image-observation", "loader-environment",
                  "receipt-encode", "receipt-destination", "receipt-write"]
    guard stages.contains(stage), (1...8).contains(ordinal),
          boot.utf8.count == 36, token.utf8.count == 36,
          UUID(uuidString: boot) != nil, UUID(uuidString: token) != nil,
          ["disabled", "adhoc"].contains(signingMode) else {
        throw NSError(domain: "NativeReadinessFailureEncoder", code: 1)
    }
    let failure = error as NSError
    let domains = [NSCocoaErrorDomain: 1, NSPOSIXErrorDomain: 2,
                   "NativeReadinessOwnedImage": 3, "DSC01SyntheticHarness": 4]
    let domain = domains[failure.domain] ?? 0
    let codeVisible = domain != 0 && failure.code >= Int(Int32.min) && failure.code <= Int(Int32.max)
    let record: [String: Any] = ["schema_version": 1, "kind": "diagnostic_failure",
        "boot_ordinal": ordinal, "process_boot": boot, "run_token": token, "signing_mode": signingMode,
        "stage": stage, "error_domain_id": domain, "error_code": codeVisible ? failure.code : 0,
        "error_code_redacted": !codeVisible]
    let encoded = try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys])
    guard encoded.count <= 1024 else { throw NSError(domain: "NativeReadinessFailureEncoder", code: 2) }
    return encoded
}
// END BOUNDED FAILURE ENCODER.

// BEGIN OWNED PATH HELPERS (also executed with Foundation in host controls).
private func nativeReadinessImageError(_ code: Int) -> NSError {
    NSError(domain: "NativeReadinessOwnedImage", code: code)
}

private func nativeReadinessCanonicalPath(_ path: String) throws -> String? {
    guard path.hasPrefix("/"), path.utf8.count <= 4096,
          !path.unicodeScalars.contains(where: { $0.value < 32 || $0.value == 127 || $0.value == 92 }) else {
        throw nativeReadinessImageError(20)
    }
    // Foundation can strip /private from an existing Darwin path. Python's
    // literal owned roots use POSIX realpath, so use that same representation.
    // A dyld shared-cache image need not exist as a separate filesystem file.
    var buffer = [CChar](repeating: 0, count: Int(PATH_MAX))
    return try path.withCString { input in
        try buffer.withUnsafeMutableBufferPointer { output in
            guard let address = output.baseAddress, realpath(input, address) != nil else { return nil }
            let length = strnlen(address, output.count)
            guard length > 0, length < output.count, length <= 4096,
                  let canonical = String(bytes: UnsafeRawBufferPointer(start: address, count: length), encoding: .utf8),
                  canonical.hasPrefix("/"),
                  !canonical.unicodeScalars.contains(where: { $0.value < 32 || $0.value == 127 || $0.value == 92 }) else {
                throw nativeReadinessImageError(22)
            }
            return canonical
        }
    }
}

private func nativeReadinessCanonicalOwnedRoot(_ literal: String) throws -> String {
    guard let canonical = try nativeReadinessCanonicalPath(literal), canonical == literal else {
        // Do not broaden ownership by following a substituted task/product root.
        throw nativeReadinessImageError(23)
    }
    return canonical
}

private func nativeReadinessCanonicalDyldPath(_ raw: String) throws -> String? {
    let canonical = try nativeReadinessCanonicalPath(raw)
    if canonical == nil && URL(fileURLWithPath: raw).lastPathComponent == "ComposeApp" {
        throw nativeReadinessImageError(21)
    }
    return canonical
}

private func nativeReadinessRelative(_ path: String, root: String) throws -> String? {
    guard path.hasPrefix(root + "/") else { return nil }
    let relative = String(path.dropFirst(root.count + 1))
    guard !relative.isEmpty, relative.utf8.count <= 512,
          !relative.split(separator: "/", omittingEmptySubsequences: false).contains(where: {
              $0.isEmpty || $0 == "." || $0 == ".."
          }), !relative.unicodeScalars.contains(where: { $0.value < 32 || $0.value == 127 || $0.value == 92 }) else {
        throw nativeReadinessImageError(1)
    }
    return relative
}

private func nativeReadinessOwnedFrameworkRelative(_ path: String) -> Bool {
    let parts = path.split(separator: "/", omittingEmptySubsequences: false).map(String.init)
    guard parts.count == 5, parts[3].lowercased() == "composeapp.framework", parts[4] == "ComposeApp" else {
        return false
    }
    if Array(parts.prefix(3)) == ["bin", "iosSimulatorArm64", "debugFramework"] { return true }
    return parts[0] == "xcode-frameworks" && parts[1] == "Debug" &&
        parts[2].range(of: "^iphonesimulator[0-9]+(?:\\.[0-9]+)*$", options: .regularExpression) != nil
}

private func nativeReadinessInspectFramework(
    _ canonicalPath: String, appRoot: String, productRoot: String,
    fingerprint: (URL) throws -> (bytes: Int, sha256: String)
) throws -> (origin: String, path: String, bytes: Int, sha256: String) {
    let origin: String
    let path: String
    if let relative = try nativeReadinessRelative(canonicalPath, root: appRoot) {
        guard relative == "Frameworks/ComposeApp.framework/ComposeApp" else { throw nativeReadinessImageError(12) }
        origin = "installed-app-bundle"; path = relative
    } else if let relative = try nativeReadinessRelative(canonicalPath, root: productRoot) {
        guard nativeReadinessOwnedFrameworkRelative(relative) else { throw nativeReadinessImageError(24) }
        origin = "owned-copy-build"; path = relative
    } else {
        // Do not retain or read an unknown/unowned image, or substitute the
        // embedded image for a different library that actually executed.
        throw nativeReadinessImageError(13)
    }
    let observed = try fingerprint(URL(fileURLWithPath: canonicalPath))
    return (origin, path, observed.bytes, observed.sha256)
}
// END OWNED PATH HELPERS.

private func nativeReadinessFrameworkUUID(_ index: UInt32) throws -> String {
    guard let header = _dyld_get_image_header(index), header.pointee.magic == MH_MAGIC_64 else {
        throw nativeReadinessImageError(2)
    }
    let raw = UnsafeRawPointer(header)
    let loaded = raw.load(as: mach_header_64.self)
    let headerBytes = MemoryLayout<mach_header_64>.size
    guard loaded.filetype == MH_DYLIB, loaded.cputype == CPU_TYPE_ARM64,
          loaded.ncmds > 0, loaded.ncmds <= 4096, loaded.sizeofcmds <= 4 * 1024 * 1024,
          loaded.ncmds <= loaded.sizeofcmds / 8 else { throw nativeReadinessImageError(3) }
    var cursor = headerBytes
    let end = headerBytes + Int(loaded.sizeofcmds)
    var observed: String?
    for _ in 0..<loaded.ncmds {
        guard cursor + MemoryLayout<load_command>.size <= end else { throw nativeReadinessImageError(4) }
        let command = raw.advanced(by: cursor).load(as: load_command.self)
        let length = Int(command.cmdsize)
        guard length >= 8, length % 8 == 0, cursor + length <= end else { throw nativeReadinessImageError(5) }
        if command.cmd == LC_UUID {
            guard observed == nil, length == MemoryLayout<uuid_command>.size else { throw nativeReadinessImageError(6) }
            observed = UUID(uuid: raw.advanced(by: cursor).load(as: uuid_command.self).uuid).uuidString.lowercased()
        }
        cursor += length
    }
    guard cursor == end, let observed else { throw nativeReadinessImageError(7) }
    return observed
}

private func nativeReadinessLoadedImages() throws -> (app: [String], framework: [String: Any]) {
    guard let appRoot = try nativeReadinessCanonicalPath(Bundle.main.bundleURL.path) else {
        throw nativeReadinessImageError(21)
    }
    let taskRoot = try nativeReadinessCanonicalOwnedRoot(nativeReadinessTaskRoot)
    let productRoot = try nativeReadinessCanonicalOwnedRoot(nativeReadinessProductRoot)
    guard productRoot == taskRoot + "/copy/composeApp/build" else { throw nativeReadinessImageError(23) }
    let count = _dyld_image_count()
    guard count > 0, count <= 4096 else { throw nativeReadinessImageError(8) }
    var result = [String]()
    var framework: [String: Any]?
    for index in 0..<count {
        guard let pointer = _dyld_get_image_name(index) else { continue }
        let raw = String(cString: pointer)
        guard raw.utf8.count <= 4096 else { throw nativeReadinessImageError(9) }
        guard let canonicalPath = try nativeReadinessCanonicalDyldPath(raw) else { continue }
        let url = URL(fileURLWithPath: canonicalPath)
        let appRelative = try nativeReadinessRelative(canonicalPath, root: appRoot)
        if let appRelative {
            guard result.count < 128 else { throw nativeReadinessImageError(10) }
            result.append(appRelative)
        }
        guard url.lastPathComponent == "ComposeApp" else { continue }
        guard framework == nil, url.deletingLastPathComponent().lastPathComponent.lowercased() == "composeapp.framework" else {
            throw nativeReadinessImageError(11)
        }
        let observed = try nativeReadinessInspectFramework(canonicalPath, appRoot: appRoot, productRoot: productRoot,
                                                          fingerprint: nativeReadinessFrameworkFingerprint)
        framework = ["origin": observed.origin, "path": observed.path, "image_uuid": try nativeReadinessFrameworkUUID(index),
                     "file_bytes": observed.bytes, "file_sha256": observed.sha256]
    }
    guard let executable = Bundle.main.executableURL?.lastPathComponent, result.contains(executable),
          Set(result).count == result.count, let framework else { throw nativeReadinessImageError(14) }
    return (result.sorted(), framework)
}

private func nativeReadinessFrameworkFingerprint(_ url: URL) throws -> (bytes: Int, sha256: String) {
    // Only called after exact app/task-owned framework origin validation. Read
    // in bounded chunks; never inspect credentials, data files or other images.
    let handle = try FileHandle(forReadingFrom: url)
    defer { try? handle.close() }
    var digest = CryptoKit.SHA256()
    var bytes = 0
    while let data = try handle.read(upToCount: 1024 * 1024), !data.isEmpty {
        bytes += data.count
        guard bytes <= 512 * 1024 * 1024 else { throw nativeReadinessImageError(18) }
        digest.update(data: data)
    }
    guard bytes > 0 else { throw nativeReadinessImageError(19) }
    return (bytes, digest.finalize().map { String(format: "%02x", $0) }.joined())
}

// BEGIN OWNED LOADER ENVIRONMENT (also executed with Foundation in host controls).
private func nativeReadinessLoaderEnvironment(
    _ environment: [String: String] = ProcessInfo.processInfo.environment
) throws -> [String: Any] {
    let taskRoot = try nativeReadinessCanonicalOwnedRoot(nativeReadinessTaskRoot)
    var result = [String: Any]()
    for key in ["DYLD_FRAMEWORK_PATH", "DYLD_LIBRARY_PATH", "DYLD_FALLBACK_FRAMEWORK_PATH", "DYLD_FALLBACK_LIBRARY_PATH"] {
        let raw = environment[key]
        guard (raw?.utf8.count ?? 0) <= 16384 else { throw nativeReadinessImageError(15) }
        let entries = raw?.split(separator: ":", omittingEmptySubsequences: false).map(String.init) ?? []
        guard entries.count <= 32 else { throw nativeReadinessImageError(16) }
        var owned = [String]()
        var redacted = 0
        for entry in entries {
            guard entry.utf8.count <= 4096 else { throw nativeReadinessImageError(17) }
            if entry.hasPrefix("/"), let path = try nativeReadinessCanonicalPath(entry) {
                if let relative = try nativeReadinessRelative(path, root: taskRoot) {
                    owned.append(relative); continue
                }
            }
            redacted += 1 // No unrelated user/system path or raw environment is retained.
        }
        result[key] = ["present": raw != nil, "task_owned_paths": owned, "redacted_entry_count": redacted]
    }
    return result
}
// END OWNED LOADER ENVIRONMENT.
