          "content": [
            {
              "inlineContent": [
                {
                  "code": "Path",
                  "type": "codeVoice"
                },
                {
                  "text": ": The location of the executable on disk. macOS replaces user-identifable",
                  "type": "text"
                },
                {
                  "text": " ",
                  "type": "text"
                },
                {
                  "text": "path components with placeholder values to protect privacy.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ]
        },
        "primaryContentSections[0].content[41:50]": [
          {
            "anchor": "Binary-images",
            "level": 3,
            "text": "Binary images",
            "type": "heading"
          },
          {
            "inlineContent": [
              {
                "text": "The binary images section of a crash report lists all code loaded in the process",
                "type": "text"
              },
              {
                "text": " ",
                "type": "text"
              },
              {
                "text": "at the time that it crashes, such as the app executable and system frameworks. Each",
                "type": "text"
              },
              {
                "text": " ",
                "type": "text"
              },
              {
                "text": "line in the Binary Images section represents a single binary image. iOS, iPadOS, tvOS, visionOS, and watchOS use the following format:",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "code": [
              "Binary Images:",
              "0x102aec000 - 0x102b03fff TouchCanvas arm64  <fe7745ae12db30fa886c8baa1980437a> /var/containers/Bundle/Application/51346174-37EF-4F60-B72D-8DE5F01035F5/TouchCanvas.app/TouchCanvas",
              "..."
            ],
            "syntax": "other",
            "type": "codeListing"
          },
          {
            "inlineContent": [
              {
                "text": "This list contains the components from the preceding example:",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "items": [
              {
                "content": [
                  {
                    "inlineContent": [
                      {
                        "code": "0x102aec000 - 0x102b03fff",
                        "type": "codeVoice"
                      },
                      {
                        "text": ". The binary image’s address range within the process.",
                        "type": "text"
                      },
                      {
                        "text": " ",
                        "type": "text"
                      },
                      {
                        "text": "The first address is the binary’s load address. See ",
                        "type": "text"
                      },
                      {
                        "identifier": "doc://com.apple.Xcode/documentation/Xcode/adding-identifiable-symbol-names-to-a-crash-report#Symbolicate-the-crash-report-using-a-command-line-tool",
                        "isActive": true,
                        "type": "reference"
                      },
                      {
                        "text": " ",
                        "type": "text"
                      },
                      {
                        "text": "for how to use this value.",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ]
              },
              {
                "content": [
                  {
                    "inlineContent": [
                      {
                        "code": "TouchCanvas",
                        "type": "codeVoice"
                      },
                      {
                        "text": ". The binary name.",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ]
              },
              {
                "content": [
                  {
                    "inlineContent": [
                      {
                        "code": "arm64",
                        "type": "codeVoice"
                      },
                      {
                        "text": ". The CPU architecture from the binary image that the operating system loaded",
                        "type": "text"
                      },
                      {
                        "text": " ",
                        "type": "text"
                      },
                      {
                        "text": "into the process.",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ]
              },
              {
                "content": [
                  {
                    "inlineContent": [
                      {
                        "code": "fe7745ae12db30fa886c8baa1980437a",
                        "type": "codeVoice"
                      },
                      {
                        "text": ". A build UUID that uniquely identifies the binary",
                        "type": "text"
                      },
                      {
                        "text": " ",
                        "type": "text"
                      },
                      {
                        "text": "image. Use this value to locate the corresponding ",
                        "type": "text"
                      },
                      {
                        "code": "dSYM",
                        "type": "codeVoice"
                      },
                      {
                        "text": " file when symbolicating",
                        "type": "text"
                      },
                      {
                        "text": " ",
                        "type": "text"
                      },
                      {
                        "text": "the crash report. See ",
                        "type": "text"
                      },
                      {
                        "identifier": "doc://com.apple.Xcode/documentation/Xcode/building-your-app-to-include-debugging-information",
                        "isActive": true,
                        "type": "reference"
                      },
                      {
                        "text": " for",
                        "type": "text"
                      },
                      {
                        "text": " ",
                        "type": "text"
                      },
                      {
                        "text": "more information on build UUIDs.",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ]
              },
              {
                "content": [
                  {
                    "inlineContent": [
                      {
                        "code": "/var/containers/.../TouchCanvas.app/TouchCanvas",
                        "type": "codeVoice"
                      },
                      {
                        "text": ". The path to the binary on disk.",
                        "type": "text"
                      },
                      {
                        "text": " ",
                        "type": "text"
                      },
                      {
                        "text": "macOS replaces user-identifable path components with placeholder values to protect",
                        "type": "text"
                      },
                      {
                        "text": " ",
                        "type": "text"
                      },
                      {
                        "text": "privacy.",
                        "type": "text"
                      }
