+    func sample() {
+        precondition(Thread.isMainThread && prepared)
+        do {
+            guard samplingStatus != "running" else { throw fixtureError() }
+            try appendObservation(phase: "sample")
+        }
+        catch { display = "{\"harnessError\":\"bounded_observation_failed\"}" }
+    }
+
+    func beginStabilityWindow(context: String = "foreground") {
+        precondition(Thread.isMainThread && prepared && ["whodunit", "mafia"].contains(scenario))
+        guard samplingStatus != "running", samplingOrdinal < 12,
+              ["foreground", "landscape", "portrait"].contains(context) else {
+            display = "{\"harnessError\":\"sampling_window_precondition_failed\"}"; return
