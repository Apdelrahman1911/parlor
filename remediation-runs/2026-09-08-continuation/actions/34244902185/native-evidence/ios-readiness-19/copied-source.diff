+private struct DSC01NativeObservation: Codable {
+    let sameOuterController: Bool
+    let sameComposeController: Bool
+    let sameOuterView: Bool
+    let sameComposeView: Bool
+    let childParentIsOuter: Bool
+    let singleComposeChild: Bool
+    let directSubview: Bool
+    let sameWindow: Bool
+    let attachments: Int
+    let disposals: Int
+    let outerDirection: String
+    let geometry: DSC01Geometry?
+
+    static let unavailable = DSC01NativeObservation(
+        sameOuterController: false, sameComposeController: false,
+        sameOuterView: false, sameComposeView: false, childParentIsOuter: false,
+        singleComposeChild: false, directSubview: false, sameWindow: false,
+        attachments: 0, disposals: 0, outerDirection: "unavailable", geometry: nil)
+
+    // Compact keys keep ALL six samples below the original 8192-byte a11y cap.
+    // Full component booleans and numeric geometry live in each durable event.
+    var compact: [String: Any] {
+        ["o": sameOuterController, "c": sameComposeController,
+         "v": sameOuterView && sameComposeView,
+         "p": childParentIsOuter && singleComposeChild && directSubview,
+         "w": sameWindow, "a": attachments, "d": disposals,
+         "g": geometry?.valid ?? false, "i": geometry?.orientation ?? "unavailable"]
+    }
+}
+
+private func dsc01Rectangle(_ value: CGRect) -> [Double] {
+    [Double(value.origin.x), Double(value.origin.y), Double(value.size.width), Double(value.size.height)]
+}
+
+private func dsc01Insets(_ value: UIEdgeInsets) -> [Double] {
+    [Double(value.top), Double(value.left), Double(value.bottom), Double(value.right)]
+}
+
+private func dsc01Direction(_ view: UIView?) -> String {
+    guard let view else { return "unavailable" }
+    switch view.semanticContentAttribute {
+    case .forceLeftToRight: return "force_ltr"
+    case .forceRightToLeft: return "force_rtl"
+    case .unspecified: return "unspecified"
+    default: return "other"
+    }
+}
