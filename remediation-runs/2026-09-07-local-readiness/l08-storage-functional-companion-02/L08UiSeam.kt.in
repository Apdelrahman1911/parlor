// COPY-ONLY public-control identity/observation. Never calls navigation callbacks itself.
package com.parlor.app.readiness

import androidx.compose.runtime.Composable
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.testTag
import com.parlor.core.ids.SessionId

object L08UiSeam {
    private var expectedId by mutableStateOf<SessionId?>(null)
    private var label: String? = null
    var resumeTaps = 0
        private set
    var retryTaps = 0
        private set
    var discardTaps = 0
        private set
    var recoveryShows = 0
        private set
    var hostContent: (@Composable () -> Unit)? by mutableStateOf<(@Composable () -> Unit)?>(null)

    fun expect(id: SessionId, alias: String) {
        check(expectedId == null && id.raw.startsWith("l08-"))
        check(alias in setOf("wc", "we", "mon", "moff", "legacy", "damaged", "dual"))
        label = alias
        expectedId = id
    }

    @Composable
    fun homeModifier(id: SessionId): Modifier = if (id == expectedId) {
        Modifier.testTag("l08-home-" + checkNotNull(label))
    } else Modifier

    fun homeTapped(id: SessionId) {
        if (id == expectedId) {
            check(resumeTaps == 0)
            resumeTaps++
        }
    }

    fun retryTapped() {
        if (label in setOf("damaged", "dual")) {
            check(resumeTaps == 1 && retryTaps == 0 && discardTaps == 0)
            retryTaps++
        }
    }

    fun discardTapped() {
        if (label in setOf("damaged", "dual")) {
            check(resumeTaps == 1 && retryTaps == 1 && discardTaps == 0)
            discardTaps++
        }
    }

    fun recoveryShown(id: SessionId) {
        if (id == expectedId && label in setOf("damaged", "dual")) {
            check(resumeTaps == 1 && recoveryShows < 2)
            recoveryShows++
        }
    }

    @Composable
    fun renderHostIfActive(): Boolean {
        val content = hostContent ?: return false
        content()
        return true
    }
}
