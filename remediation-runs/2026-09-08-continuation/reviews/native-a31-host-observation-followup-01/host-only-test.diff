+            [framework_inventory()])['status'], 'PASS')
+        for record in (row for row in records if row['action'] == 'language-en'):
+            changed = copy.deepcopy(scenario)
+            sequence = record['observation_sequence']
+            bound = changed['observations'][sequence - 1]
+            following = changed['observations'][sequence]
+            self.assertEqual(following['ordinal'], sequence + 1)
+            self.assertEqual(following['boot'], bound['boot'])
+            self.assertEqual(following['preferences']['ownerInstalled'], 'en')
+            self.assertEqual(following['preferences']['appLanguages'], ['en'])
+            # A29-shaped premature System-EN -> explicit-EN ownership, not an
+            # edit to historical evidence. The next synthetic cycle row is owned.
+            bound['preferences'].update(setting='en', preferredLanguage='en', ownerInstalled='none',
+                ownerPresent=False, hasAppOverride=False, appLanguages=[],
+                ownerPreviousPresent=False, ownerPrevious=[])
+            self.assertEqual(bound['nativeDirection'], 'force_ltr')
+            self.assertEqual(record['observation']['host']['direction'], 'ltr')
+            with self.subTest(boot=record['boot_ordinal']), self.assertRaisesRegex(
+                    RuntimeError, '^Explicit host language stole System ownership$'):
+                host_receipts.verify_host(records, changed, TOKEN, log, 'disabled', {}, {}, [framework_inventory()])
+            self.assertEqual(record['observation_sequence'], sequence)
