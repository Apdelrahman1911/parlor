+def native_clone_probe(owned):
+    """Tiny real CoW isolation witness, exclusively inside the owned root."""
+    owned.attest()
+    directory = owned.path / "native-clone-probe"
+    directory.mkdir(mode=0o700)
+    source = directory / "source"
+    destination = directory / "clone"
+    source.write_bytes(b"parlor-owned-clone-probe")
+    source_fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
+    try:
