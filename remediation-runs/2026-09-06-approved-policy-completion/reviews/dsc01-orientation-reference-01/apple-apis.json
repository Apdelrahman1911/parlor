        "abstract": [
          {
            "text": "The interface orientations that the view controller supports.",
            "type": "text"
          }
        ],
        "primaryContentSections": [
          {
            "declarations": [
              {
                "languages": [
                  "swift"
                ],
                "platforms": [
                  "iOS",
                  "iPadOS",
                  "Mac Catalyst",
                  "visionOS"
                ],
                "tokens": [
                  {
                    "kind": "keyword",
                    "text": "var"
                  },
