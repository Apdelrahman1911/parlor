      "primary_content": [
        {
          "declarations": [
            {
              "languages": [
                "swift"
              ],
              "platforms": [
                "iOS",
                "iPadOS",
                "Mac Catalyst",
                "macOS",
                "tvOS",
                "visionOS",
                "watchOS"
              ],
              "tokens": [
                {
                  "kind": "attribute",
                  "text": "@"
                },
                {
                  "identifier": "doc://com.apple.documentation/documentation/Swift/MainActor",
                  "kind": "attribute",
                  "preciseIdentifier": "s:ScM",
                  "text": "MainActor"
                },
                {
                  "kind": "text",
                  "text": " "
                },
                {
                  "kind": "attribute",
