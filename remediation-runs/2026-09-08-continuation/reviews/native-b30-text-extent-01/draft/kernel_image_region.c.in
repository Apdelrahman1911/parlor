/* Host-only observer for one attested, sample-selected image. Never injected. */
#include <errno.h>
#include <fcntl.h>
#include <inttypes.h>
#include <libproc.h>
#include <limits.h>
#include <mach/vm_prot.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/proc_info.h>
#include <sys/stat.h>
#include <unistd.h>

static int number(const char *text, uint64_t *result) {
    if (!text || !*text || strnlen(text, 21) > 20) return 0;
    for (const char *p = text; *p; p++) if (*p < '0' || *p > '9') return 0;
    char *end = NULL;
    errno = 0;
    unsigned long long value = strtoull(text, &end, 10);
    if (errno || *end) return 0;
    *result = (uint64_t)value;
    return 1;
}

static int failed(const char *reason, int code) {
    /* reason is always a closed literal, never an OS description or path. */
    printf("{\"schema_version\":1,\"status\":\"FAIL\",\"reason\":\"%s\",\"native_error\":%d}\n", reason, code);
    return 1;
}

/* Fixed-width file decoding, not host struct packing or a caller-supplied size. */
struct text_layout {
    uint64_t vmaddr, vmsize, fileoff, filesize;
    uint32_t maxprot, initprot, nsects, flags;
    unsigned char uuid[16];
};

static uint32_t little32(const unsigned char *p) {
    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
}

static uint64_t little64(const unsigned char *p) {
    return (uint64_t)little32(p) | (uint64_t)little32(p + 4) << 32;
}

static int read_exact(int fd, unsigned char *data, size_t bytes, off_t offset) {
    size_t read_bytes = 0;
    while (read_bytes < bytes) {
        ssize_t result = pread(fd, data + read_bytes, bytes - read_bytes, offset + (off_t)read_bytes);
        if (result <= 0) return 0;
        read_bytes += (size_t)result;
    }
    return 1;
}

static int same_file(const struct stat *a, const struct stat *b) {
    if (a->st_dev != b->st_dev || a->st_ino != b->st_ino || a->st_size != b->st_size ||
        a->st_uid != b->st_uid || a->st_mode != b->st_mode) return 0;
#ifdef __APPLE__
    return a->st_mtimespec.tv_sec == b->st_mtimespec.tv_sec && a->st_mtimespec.tv_nsec == b->st_mtimespec.tv_nsec &&
           a->st_ctimespec.tv_sec == b->st_ctimespec.tv_sec && a->st_ctimespec.tv_nsec == b->st_ctimespec.tv_nsec;
#else
    return a->st_mtim.tv_sec == b->st_mtim.tv_sec && a->st_mtim.tv_nsec == b->st_mtim.tv_nsec &&
           a->st_ctim.tv_sec == b->st_ctim.tv_sec && a->st_ctim.tv_nsec == b->st_ctim.tv_nsec;
#endif
}

static int read_text(int fd, uint64_t file_bytes, struct text_layout *text) {
    unsigned char header[32];
    if (file_bytes < sizeof(header) || file_bytes > UINT64_C(536870912) ||
        !read_exact(fd, header, sizeof(header), 0) || little32(header) != UINT32_C(0xfeedfacf) ||
        little32(header + 4) != UINT32_C(0x0100000c) || little32(header + 8) != 0 ||
        (little32(header + 12) != 2 && little32(header + 12) != 6) || little32(header + 28) != 0) return 0;
    uint32_t count = little32(header + 16), bytes = little32(header + 20);
    if (count == 0 || count > 4096 || bytes < count * 8 || bytes > 1048576 || bytes % 8 ||
        bytes > file_bytes - sizeof(header)) return 0;
    unsigned char *commands = malloc(bytes);
    if (!commands) return 0;
    int valid = read_exact(fd, commands, bytes, (off_t)sizeof(header));
    size_t cursor = 0;
    int text_seen = 0, uuid_seen = 0;
    for (uint32_t index = 0; valid && index < count; index++) {
        if (bytes - cursor < 8) { valid = 0; break; }
        const unsigned char *command = commands + cursor;
        uint32_t kind = little32(command), size = little32(command + 4);
        if (size < 8 || size % 8 || size > bytes - cursor || kind == 1) { valid = 0; break; }
        if (kind == 0x19) {
            if (size < 72) { valid = 0; break; }
            uint64_t vmaddr = little64(command + 24), vmsize = little64(command + 32);
            uint64_t fileoff = little64(command + 40), filesize = little64(command + 48);
            uint32_t nsects = little32(command + 64);
            if (nsects > (size - 72) / 80 || size != 72 + nsects * 80 || vmaddr > UINT64_MAX - vmsize ||
                fileoff > file_bytes || filesize > file_bytes - fileoff) { valid = 0; break; }
            if (!memcmp(command + 8, "__TEXT\0", 7)) {
                static const unsigned char name[16] = "__TEXT";
                if (text_seen++ || memcmp(command + 8, name, sizeof(name))) { valid = 0; break; }
                text->vmaddr = vmaddr; text->vmsize = vmsize;
                text->fileoff = fileoff; text->filesize = filesize;
                text->maxprot = little32(command + 56); text->initprot = little32(command + 60);
                text->nsects = nsects; text->flags = little32(command + 68);
            }
        } else if (kind == 0x1b) {
            if (uuid_seen++ || size != 24) { valid = 0; break; }
            memcpy(text->uuid, command + 8, sizeof(text->uuid));
        }
        cursor += size;
    }
    free(commands);
    return valid && cursor == bytes && text_seen == 1 && uuid_seen == 1 && text->fileoff == 0 &&
           text->filesize >= sizeof(header) + bytes && text->filesize == text->vmsize && text->initprot == 5 &&
           (text->maxprot == 5 || text->maxprot == 7) && text->flags == 0;
}

static void uuid_text(const unsigned char *uuid, char *text) {
    static const char hex[] = "0123456789abcdef";
    size_t at = 0;
    for (size_t index = 0; index < 16; index++) {
        if (index == 4 || index == 6 || index == 8 || index == 10) text[at++] = '-';
        text[at++] = hex[uuid[index] >> 4]; text[at++] = hex[uuid[index] & 15];
    }
    text[at] = '\0';
}

static int failed_fd(int fd, const char *reason, int code) {
    close(fd);
    return failed(reason, code);
}

int main(int argc, char **argv) {
    uint64_t pid, start, end;
    if (argc != 5 || getuid() != geteuid() ||
        !number(argv[1], &pid) || pid <= 1 || pid > INT_MAX || pid == (uint64_t)getpid() ||
        !number(argv[2], &start) || !number(argv[3], &end) || start == 0 || end <= start ||
        argv[4][0] != '/' || strnlen(argv[4], MAXPATHLEN) >= MAXPATHLEN)
        return failed("invalid-request", 0);

    struct stat before, opened, after, final_fd;
    char canonical[MAXPATHLEN];
    if (lstat(argv[4], &before) || !S_ISREG(before.st_mode) || before.st_uid != getuid() ||
        !realpath(argv[4], canonical) || strcmp(canonical, argv[4]) || before.st_size <= 0)
        return failed("invalid-owned-artifact", 0);

    int fd = open(argv[4], O_RDONLY | O_NOFOLLOW | O_NONBLOCK);
    if (fd < 0) return failed("invalid-owned-artifact", 0);
    if (fstat(fd, &opened) || !same_file(&before, &opened))
        return failed_fd(fd, "invalid-owned-artifact", 0);
    struct text_layout text;
    memset(&text, 0, sizeof(text));
    if (!read_text(fd, (uint64_t)before.st_size, &text) || end - start > text.filesize ||
        start > UINT64_MAX - text.vmsize || fstat(fd, &after) || !same_file(&before, &after))
        return failed_fd(fd, "invalid-owned-text-layout", 0);
    if (lstat(argv[4], &after) || !same_file(&before, &after) ||
        !realpath(argv[4], canonical) || strcmp(canonical, argv[4]))
        return failed_fd(fd, "artifact-changed-before-query", 0);

    struct proc_regionwithpathinfo info;
    memset(&info, 0, sizeof(info));
    errno = 0;
    int returned = proc_pidinfo((int)pid, PROC_PIDREGIONPATHINFO, start, &info, (int)sizeof(info));
    int native_error = errno;
    if (returned != (int)sizeof(info)) return failed_fd(fd, "region-query-incomplete", native_error);
    const struct proc_regioninfo *region = &info.prp_prinfo;
    const struct vinfo_stat *file = &info.prp_vip.vip_vi.vi_stat;
    /* The kernel may advance over holes; never accept a subsequent region. */
    if (region->pri_address != start || region->pri_size == 0 ||
        (region->pri_size > end - start && region->pri_size != text.vmsize) ||
        region->pri_offset != 0 || (region->pri_flags & PROC_REGION_SUBMAP) != 0 ||
        region->pri_protection != (VM_PROT_READ | VM_PROT_EXECUTE)) {
        /* Uncorroborated failure snapshot, not path/vnode/lifetime evidence. */
        /* native_error retains its literal sentinel; query_errno is captured errno. */
        close(fd);
        printf("{\"schema_version\":1,\"status\":\"FAIL\",\"reason\":\"not-selected-executable-region\",\"native_error\":0"
            ",\"region_diagnostic\":{\"requested_start\":%" PRIu64 ",\"requested_end_exclusive\":%" PRIu64
            ",\"pri_address\":%" PRIu64 ",\"pri_size\":%" PRIu64 ",\"pri_offset\":%" PRIu64
            ",\"pri_protection\":%u,\"pri_max_protection\":%u,\"pri_flags\":%u"
            ",\"native_structure_bytes\":%zu,\"native_return_bytes\":%d,\"query_errno\":%d}}\n",
            start, end, region->pri_address, region->pri_size, region->pri_offset,
            region->pri_protection, region->pri_max_protection, region->pri_flags,
            sizeof(info), returned, native_error);
        return 1;
    }
    if (strnlen(info.prp_vip.vip_path, sizeof(info.prp_vip.vip_path)) == sizeof(info.prp_vip.vip_path) ||
        strcmp(info.prp_vip.vip_path, argv[4]) || file->vst_dev != (uint32_t)before.st_dev ||
        file->vst_ino != (uint64_t)before.st_ino || file->vst_size != before.st_size || file->vst_uid != (uint32_t)before.st_uid ||
        !S_ISREG(file->vst_mode) || lstat(argv[4], &after) || !S_ISREG(after.st_mode) ||
        !same_file(&before, &after) || fstat(fd, &final_fd) || !same_file(&before, &final_fd))
        return failed_fd(fd, "mapping-artifact-mismatch", 0);
    close(fd);
    char image_uuid[37];
    uuid_text(text.uuid, image_uuid);

    printf("{\"schema_version\":2,\"status\":\"PASS\",\"pid\":%" PRIu64
        ",\"requested_start\":%" PRIu64 ",\"requested_end_exclusive\":%" PRIu64
        ",\"region_start\":%" PRIu64 ",\"region_size\":%" PRIu64
        ",\"region_offset\":%" PRIu64 ",\"protection\":%u,\"max_protection\":%u"
        ",\"region_flags\":%u,\"native_structure_bytes\":%zu,\"native_return_bytes\":%d"
        ",\"path_exact\":true,\"vnode_identity_matches\":true,\"artifact_bytes\":%" PRId64
        ",\"artifact_device\":%" PRIu64 ",\"artifact_inode\":%" PRIu64 ",\"artifact_uid\":%" PRIu64
        ",\"extent_kind\":\"%s\",\"artifact_text\":{\"uuid\":\"%s\",\"text_segment\":{"
        "\"vmaddr\":%" PRIu64 ",\"vmsize\":%" PRIu64 ",\"fileoff\":%" PRIu64 ",\"filesize\":%" PRIu64
        ",\"maxprot\":%u,\"initprot\":%u,\"nsects\":%u,\"flags\":%u}}}\n",
        pid, start, end, region->pri_address, region->pri_size, region->pri_offset,
        region->pri_protection, region->pri_max_protection, region->pri_flags,
        sizeof(info), returned, (int64_t)before.st_size, (uint64_t)before.st_dev, (uint64_t)before.st_ino,
        (uint64_t)before.st_uid, region->pri_size <= end - start ? "sample-contained-prefix" : "exact-owned-text-extent",
        image_uuid, text.vmaddr, text.vmsize, text.fileoff, text.filesize, text.maxprot, text.initprot, text.nsects, text.flags);
    return 0;
}
