+    @MainActor private func l08PublicControlObservation(_ app: XCUIApplication,
+                                                       identifier: String, attempt: Int) throws {
+        let allowed = ["l08-home-wc", "l08-home-we", "l08-home-mon", "l08-home-moff",
+                       "l08-home-legacy", "l08-home-damaged", "l08-home-dual"]
+        guard allowed.contains(identifier) else { return }
+        XCTAssertTrue((0...8).contains(attempt))
+        func observation(_ key: String) -> [String: Any] {
+            let nodes = app.descendants(matching: .any).matching(identifier: key)
+            let count = nodes.count
+            var row: [String: Any] = ["count": count]
+            if count == 1 {
+                let node = nodes.firstMatch
+                row["exists"] = node.exists
+                row["enabled"] = node.isEnabled
+                row["hittable"] = node.isHittable
+                let frame = node.frame
+                if [frame.minX, frame.minY, frame.width, frame.height].allSatisfy({ $0.isFinite }) {
+                    row["frame"] = ["x": frame.minX, "y": frame.minY,
+                                    "width": frame.width, "height": frame.height]
+                }
+            }
+            return row
+        }
+        let row: [String: Any] = ["schema_version": 1, "identifier": identifier, "attempt": attempt,
+            "target": observation(identifier), "list": observation("l08-home-list"),
+            "overlay": observation("parlor-dsc01-overlay"), "proves_recovery": false]
+        let data = try JSONSerialization.data(withJSONObject: row, options: [.sortedKeys])
+        XCTAssertLessThanOrEqual(data.count, 2048)
+        print("PARLOR_L08_PUBLIC_CONTROL " + String(decoding: data, as: UTF8.self))
+    }
