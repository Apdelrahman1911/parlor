+extension IOSAppLaunchUITests {
+    @MainActor private func captureOSPreferenceBaseline(_ snapshot: [String: Any],
+        beforeChoice: [String: Any]) throws -> DSC01OSPreferenceBaseline {
+        let previous = try dictionary(beforeChoice, "now")
+        let previousSequence = try XCTUnwrap(beforeChoice["sequence"] as? Int)
+        let previousBoot = try string(beforeChoice, "boot")
+        let sequence = try XCTUnwrap(snapshot["sequence"] as? Int)
+        let boot = try string(snapshot, "boot")
+        let now = try dictionary(snapshot, "now")
+        let beforeMain = try dictionary(snapshot, "beforeMain")
+        guard previous["setting"] as? String == "system", previous["ownerPresent"] as? Bool == false,
+              (1...256).contains(previousSequence), sequence > previousSequence, sequence <= 256,
+              UUID(uuidString: previousBoot) != nil, UUID(uuidString: boot) != nil, boot != previousBoot,
+              let value = dsc01OSUnownedArabic(now), dsc01OSUnownedArabic(beforeMain) == value else {
+            throw NSError(domain: "DSC01OSPostChoiceBeforeAppBaseline", code: 1)
+        }
+        let baseline = DSC01OSPreferenceBaseline(value: value, beforeChoiceSequence: previousSequence,
+            beforeChoiceBoot: previousBoot, sequence: sequence, boot: boot)
+        try recordOSPreferenceStage("baseline", snapshot: snapshot, baseline: baseline)
+        return baseline
+    }
+
+    @MainActor private func recordOSPreferenceStage(_ stage: String, snapshot: [String: Any],
+        baseline: DSC01OSPreferenceBaseline) throws {
+        try assertNative(snapshot)
+        let sequence = try XCTUnwrap(snapshot["sequence"] as? Int)
+        let boot = try string(snapshot, "boot")
+        let preferences = try dictionary(snapshot, "now")
+        let composition = try dictionary(snapshot, "composition")
+        let beforeMain = try dictionary(snapshot, "beforeMain")
+        guard (1...256).contains(sequence), UUID(uuidString: boot) != nil else {
+            throw NSError(domain: "DSC01OSPreferenceStageIdentity", code: 1)
+        }
+        let valid: Bool
+        switch stage {
+        case "baseline":
+            valid = sequence == baseline.sequence && boot == baseline.boot &&
+                dsc01OSUnownedArabic(preferences) == baseline.value && snapshot["nativeDirection"] as? String == "force_rtl"
+        case "english":
+            valid = sequence > baseline.sequence && boot == baseline.boot &&
+                dsc01OSOwnedEnglishMatches(preferences, baseline.value) &&
+                snapshot["nativeDirection"] as? String == "force_ltr" &&
+                composition["settingsMounted"] as? Bool == true && composition["settingsDirection"] as? String == "ltr"
+        case "system", "restart":
+            valid = sequence > baseline.sequence &&
+                (stage == "restart" ? boot != baseline.boot : boot == baseline.boot) &&
+                dsc01OSUnownedArabic(preferences) == baseline.value &&
+                dsc01OSUnownedArabic(beforeMain) == baseline.value &&
+                snapshot["nativeDirection"] as? String == "force_rtl" &&
+                composition["settingsMounted"] as? Bool == true && composition["settingsDirection"] as? String == "rtl"
+        default: valid = false
+        }
+        guard valid else { throw NSError(domain: "DSC01OSExactPreferenceRestoration", code: 1) }
+        let record: [String: Any] = ["schemaVersion": 1, "stage": stage,
+            "beforeChoiceSequence": baseline.beforeChoiceSequence, "beforeChoiceBoot": baseline.beforeChoiceBoot,
+            "baselineSequence": baseline.sequence, "baselineBoot": baseline.boot, "sequence": sequence, "boot": boot,
+            "hasAppOverride": baseline.value.present, "appLanguages": baseline.value.languages]
+        let data = try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys])
+        guard data.count <= 2048, let text = String(data: data, encoding: .utf8) else {
+            throw NSError(domain: "DSC01OSPreferenceReceiptBudget", code: 1)
+        }
+        print("DSC01_OS_PREFERENCE_BASELINE " + text)
+    }
+
+    @MainActor private func verifyOSPreferenceBaselineDecisionContract() throws {
+        let absent: [String: Any] = ["setting": "system", "preferredLanguage": "ar", "hasAppOverride": false,
+            "appLanguages": [String](), "ownerPresent": false, "ownerInstalled": "none",
+            "ownerPreviousPresent": false, "ownerPrevious": [String]()]
+        var present = absent; present["hasAppOverride"] = true; present["appLanguages"] = ["ar-EG", "en"]
+        var cases: [([String: Any], Bool)] = [(absent, true), (present, true)]
+        let changes: [(String, Any)] = [("hasAppOverride", true), ("appLanguages", ["ar"]),
+            ("setting", "en"), ("preferredLanguage", "en"), ("ownerPresent", true),
+            ("ownerInstalled", "en"), ("ownerPreviousPresent", true), ("ownerPrevious", ["ar"])]
+        for (key, value) in changes { var changed = absent; changed[key] = value; cases.append((changed, false)) }
+        var missing = absent; missing.removeValue(forKey: "appLanguages"); cases.append((missing, false))
+        for languages in [["zz"], ["en", "ar"], Array(repeating: "ar", count: 9)] {
+            var changed = present; changed["appLanguages"] = languages; cases.append((changed, false))
+        }
+        XCTAssertEqual(cases.count, 14)
+        for (index, item) in cases.enumerated() {
+            XCTAssertEqual(dsc01OSUnownedArabic(item.0) != nil, item.1, "OS baseline shape case \(index)")
+        }
+        let absentValue = try XCTUnwrap(dsc01OSUnownedArabic(absent))
+        let presentValue = try XCTUnwrap(dsc01OSUnownedArabic(present))
+        let owned: (DSC01OSPreferenceValue) -> [String: Any] = { value in
+            ["setting": "en", "preferredLanguage": "en", "hasAppOverride": true, "appLanguages": ["en"],
+             "ownerPresent": true, "ownerInstalled": "en", "ownerPreviousPresent": value.present,
+             "ownerPrevious": value.languages]
+        }
+        var owners: [([String: Any], DSC01OSPreferenceValue, Bool)] = [
+            (owned(absentValue), absentValue, true), (owned(presentValue), presentValue, true)]
+        for (key, wrong) in [("ownerPreviousPresent", false as Any), ("ownerPrevious", ["ar"] as Any),
+                              ("appLanguages", ["ar"] as Any), ("ownerPresent", false as Any)] {
+            var changed = owned(presentValue); changed[key] = wrong; owners.append((changed, presentValue, false))
+        }
+        XCTAssertEqual(owners.count, 6)
+        for (index, item) in owners.enumerated() {
+            XCTAssertEqual(dsc01OSOwnedEnglishMatches(item.0, item.1), item.2, "Exact previous case \(index)")
+        }
+        let restores = [(absent, absentValue, true), (present, presentValue, true),
+                        (absent, presentValue, false), (present, absentValue, false)]
+        XCTAssertEqual(restores.count, 4)
+        for (index, item) in restores.enumerated() {
+            XCTAssertEqual(dsc01OSUnownedArabic(item.0) == item.1, item.2, "Exact restored case \(index)")
+        }
+        print("DSC01_OS_PREFERENCE_DECISION_CONTRACT {\"schemaVersion\":1,\"shapeCases\":14,\"ownershipCases\":6,\"restoreCases\":4,\"passed\":true}")
+    }
+}
