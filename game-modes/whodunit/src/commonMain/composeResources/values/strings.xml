<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Setup: mode selection -->
    <string name="setup_choose_mode_eyebrow">CHOOSE GAME MODE</string>
    <string name="setup_choose_mode_headline">How do you want to play?</string>
    <string name="setup_mode_classic_title">Classic Vote</string>
    <string name="setup_mode_classic_body">Investigate the full case. One vote at the end. Best for story and deduction.</string>
    <string name="setup_mode_classic_meta">25–35 min  ·  4–6 players</string>
    <string name="setup_mode_elimination_title">Elimination</string>
    <string name="setup_mode_elimination_body">Vote after every round. Find the killer before they survive. Best for fast, tense games.</string>
    <string name="setup_mode_elimination_meta">15–25 min  ·  5–6 players</string>
    <string name="setup_mode_choose_format">Choose %1$s</string>
    <string name="setup_mode_choose_description_format">Choose %1$s mode and proceed to player setup.</string>

    <!-- Setup: player count -->
    <string name="setup_player_count_eyebrow">HOW MANY PLAYERS</string>
    <string name="setup_player_count_headline">Tap a number.</string>
    <string name="setup_player_count_case_cap_format">This case supports up to %1$d players.</string>

    <!-- Setup: player entry -->
    <string name="setup_player_entry_eyebrow">ENTER YOUR NAMES</string>
    <string name="setup_player_entry_headline">Pass the phone. Each player types theirs.</string>
    <string name="setup_player_entry_field_format">Player %1$d</string>
    <string name="setup_player_entry_confirm">Begin</string>
    <string name="setup_player_entry_confirm_description">Confirm player names and continue to the case intro.</string>

    <!-- Setup: public intro -->
    <string name="setup_intro_read_aloud_eyebrow">READ ALOUD</string>
    <string name="setup_intro_what_is_true_eyebrow">WHAT IS TRUE</string>
    <string name="setup_intro_continue">Continue</string>
    <string name="setup_intro_continue_description">Advance from the public intro to the rules briefing.</string>

    <!-- Setup: rules briefing -->
    <string name="setup_briefing_eyebrow">HOW TO PLAY</string>
    <string name="setup_briefing_card_1">One of you is the killer. Even you don\'t know who, until you see your character.</string>
    <string name="setup_briefing_card_2">You may lie. You should lie. Especially if you\'re guilty.</string>
    <string name="setup_briefing_card_3">Each round, the app reveals a new clue. Discuss. Accuse. Suspect.</string>
    <string name="setup_briefing_card_4">Vote according to your chosen mode. Get it wrong, the killer wins.</string>
    <string name="setup_briefing_continue">Continue</string>
    <string name="setup_briefing_begin">Begin the Investigation</string>
    <string name="setup_briefing_continue_description">Advance to the next briefing card.</string>
    <string name="setup_briefing_begin_description">Begin the investigation.</string>

    <!-- Character reveal -->
    <string name="reveal_handoff_title_format">Pass to %1$s.</string>
    <string name="reveal_handoff_subtitle">When you\'re alone with the phone, tap to continue.</string>
    <string name="reveal_gate_headline_format">%1$s,</string>
    <string name="reveal_gate_instruction">find a quiet angle. Press and hold the seal.</string>
    <string name="reveal_gate_hold_hint">Hold for 1.5 seconds.</string>
    <string name="reveal_gate_reduce_motion_hint">Reduce motion is on. Tap the seal to reveal.</string>
    <string name="reveal_gate_a11y">Press and hold the wax seal to reveal your dossier.</string>
    <string name="reveal_hide_next_format">Hide the phone. Pass to %1$s when no one is watching.</string>
    <string name="reveal_hide_end">Hide the phone. Pass back to the table.</string>

    <!-- Dossier -->
    <string name="dossier_you_are_eyebrow">YOU ARE</string>
    <string name="dossier_secret_label">YOUR SECRET.</string>
    <string name="dossier_motive_label">YOUR MOTIVE.</string>
    <string name="dossier_alibi_label">YOUR ALIBI.</string>
    <string name="dossier_goal_label">YOUR GOAL.</string>
    <string name="dossier_freely_label">WHAT YOU CAN SAY FREELY.</string>
    <string name="dossier_must_hide_label">WHAT YOU MUST HIDE.</string>
    <string name="dossier_acting_tips_label">ACTING TIPS.</string>
    <string name="dossier_backstory_label">BACKSTORY.</string>
    <string name="dossier_feeling_label">HOW YOU FEEL UNDERNEATH.</string>
    <string name="dossier_suggested_label">SUGGESTED BEHAVIOR.</string>
    <string name="dossier_that_night_label">THAT NIGHT.</string>
    <string name="dossier_show_optional">More about your character</string>
    <string name="dossier_hide_optional">Hide details</string>
    <string name="dossier_show_optional_description">Show optional details about your character.</string>
    <string name="dossier_hide_optional_description">Hide optional details.</string>
    <string name="dossier_done">I\'m Done</string>
    <string name="dossier_done_description">Hide the dossier and pass the phone.</string>
    <string name="dossier_killer_goal_fallback">Stay hidden. Steer suspicion. Survive.</string>
    <string name="dossier_killer_must_hide_fallback">The truth.</string>

    <!-- Rounds -->
    <string name="round_eyebrow_format">ROUND %1$d</string>
    <string name="round_clue_eyebrow_format">ROUND %1$d  ·  CLUE</string>
    <string name="round_reveal_clue_button">Reveal the Clue</string>
    <string name="round_reveal_clue_description">Reveal this round\'s clue.</string>
    <string name="round_clue_eyebrow_label">NEW CLUE</string>
    <string name="round_begin_discussion">Begin Discussion</string>
    <string name="round_begin_discussion_description">Start the discussion timer.</string>
    <string name="round_discussion_eyebrow">DISCUSSION</string>
    <string name="round_discussion_timer_label">DISCUSSION</string>
    <string name="round_discussion_paused_label">PAUSED</string>
    <string name="round_known_so_far">What you know so far</string>
    <string name="round_move_on">Move On</string>
    <string name="round_move_on_description">Advance from discussion to the next round or the vote.</string>

    <!-- Round actions -->
    <string name="round_action_alibi_eyebrow">ALIBI ROUND</string>
    <string name="round_action_alibi_headline_format">%1$s,</string>
    <string name="round_action_alibi_body_format">tell us where you were when it happened. You have %1$d seconds.</string>
    <string name="round_action_alibi_done">Done — Next Player</string>
    <string name="round_action_questions_eyebrow">QUESTIONS</string>
    <string name="round_action_questions_headline">Ask the table.</string>
    <string name="round_action_questions_body">Each player asks one direct question. The asked player must answer (and may lie).</string>
    <string name="round_action_questions_done">Begin Discussion</string>
    <string name="round_action_silent_eyebrow">SILENT ACCUSATION</string>
    <string name="round_action_silent_headline">Point.</string>
    <string name="round_action_silent_body">On the count of three, point at the player you suspect most. No talking.</string>
    <string name="round_action_silent_done">Done</string>
    <string name="round_action_monologue_eyebrow">FINAL MONOLOGUE</string>
    <string name="round_action_monologue_headline_format">%1$s, your 30 seconds.</string>
    <string name="round_action_monologue_body_format">Defend yourself. Make your case. Accuse someone. Time remaining: %1$ds.</string>
    <string name="round_action_monologue_done">Done — Next Speaker</string>

    <!-- Voting -->
    <string name="vote_ballot_headline_format">%1$s, cast your vote.</string>
    <string name="vote_ballot_instruction">Tap the name of the person you accuse.</string>
    <string name="vote_ballot_abstain">Abstain</string>
    <string name="vote_ballot_abstain_description">Decline to vote.</string>
    <string name="vote_tied_eyebrow">TIED</string>
    <string name="vote_tied_body">60 seconds. Each tied suspect defends themselves. Then revote.</string>
    <string name="vote_tied_begin_revote">Begin the Revote</string>
    <string name="vote_tied_begin_revote_description">Open the revote between the tied suspects.</string>

    <!-- Reveal stage -->
    <string name="reveal_stage_eyebrow">THE REVEAL</string>
    <string name="reveal_stage_yes">YES.</string>
    <string name="reveal_stage_no">NO.</string>
    <string name="reveal_stage_players_win_subhead">The room has chosen correctly.</string>
    <string name="reveal_stage_killer_innocent_subhead">An innocent has been condemned.</string>
    <string name="reveal_stage_killer_tie_subhead">Indecision. The killer escapes.</string>
    <string name="reveal_stage_killer_finaltwo_subhead">The killer has survived to the final two.</string>
    <string name="reveal_stage_killer_was_label">THE KILLER WAS</string>
    <string name="reveal_stage_continue">Continue</string>
    <string name="reveal_stage_continue_description">Acknowledge the reveal and continue to post-game.</string>

    <!-- Post-game -->
    <string name="postgame_eyebrow">AFTER THE GAME</string>
    <string name="postgame_question">What\'s next?</string>
    <string name="postgame_replay">Play Again — New Killer</string>
    <string name="postgame_replay_description">Replay this case with a freshly randomized killer.</string>
    <string name="postgame_try_other_mode">Try the Other Mode</string>
    <string name="postgame_try_other_mode_description">Switch between Classic Vote and Elimination.</string>
    <string name="postgame_back_to_library">Back to the Library</string>
    <string name="postgame_back_to_library_description">Return to the games library.</string>

    <!-- Overlays: pause -->
    <string name="pause_title">Paused</string>
    <string name="pause_body">The room is paused. Timers will resume when you continue.</string>
    <string name="pause_resume">Resume</string>
    <string name="pause_resume_description">Resume the game.</string>
    <string name="pause_end_game">End Game</string>
    <string name="pause_end_game_description">End this game and return to the menu.</string>

    <!-- Overlays: end game dialog -->
    <string name="endgame_title">End this game?</string>
    <string name="endgame_body">The game cannot continue without all players. Choose how to close.</string>
    <string name="endgame_reveal_now">Reveal the Case Now</string>
    <string name="endgame_reveal_now_description">End the game and play the full reveal narrative.</string>
    <string name="endgame_quietly">End Without Reveal</string>
