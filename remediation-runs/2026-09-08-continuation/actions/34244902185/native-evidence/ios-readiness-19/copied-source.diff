+        check(value.seed == owned.hostSeed && current.hostOnly.randomSeed == owned.hostSeed)
+        check(value.scope.coroutineContext[Job]?.isActive == true)
+        check(value.startGate.value == HostStartGateState.Started && current.phase == WhodunitPhase.PublicIntro)
+    }
+
+    suspend fun suspendedAck() {
+        retained()
+        val value = checkNotNull(capturedRuntime)
+        val result = value.session.submit(WhodunitAction.AcknowledgeIntro(owned.room.selfPlayerId))
+        check(result == Result.Failure(SubmitError.SessionSuspended))
+        retained()
+    }
