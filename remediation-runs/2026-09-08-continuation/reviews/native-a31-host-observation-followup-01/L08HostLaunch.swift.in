// Appended to the same owned Debug simulator ContentView as the original probe.
private let l08HostPlan = ["prepare", "capture", "language-en", "cycle-1", "resume-1", "language-ar",
    "cycle-2", "resume-2", "remount", "language-system", "cycle-3", "resume-3", "active-ack", "leave"]

private final class L08HostCallbackClaim { var received = false }

// A matching layout direction can predate the requested settings/Compose effect.
// Read actual ownership; never install an override or select a later saved row.
private func l08HostLanguageAcknowledged(_ action: String, _ current: DSC01Preferences,
                                         _ original: DSC01Preferences) -> Bool {
    guard original.setting == "system", !original.ownerPresent, original.ownerInstalled == "none",
          !original.ownerPreviousPresent, original.ownerPrevious.isEmpty else { return false }
    if action == "language-system" { return current == original }
    let language: String
    switch action {
    case "language-en": language = "en"
    case "language-ar": language = "ar"
    default: return false
    }
    return current.setting == language && current.preferredLanguage == language &&
        current.ownerPresent && current.ownerInstalled == language &&
        current.hasAppOverride && current.appLanguages == [language] &&
        current.ownerPreviousPresent == original.hasAppOverride &&
        current.ownerPrevious == original.appLanguages
}

extension DSC01Probe {
    var isL08HostScenario: Bool { scenario == "l08-host" }

    private func l08HostPending(_ index: Int, _ expectedBoot: String) -> Bool {
        precondition(Thread.isMainThread)
        return isL08HostScenario && boot == expectedBoot && l08HostIndex == index &&
            l08HostDisplay == "running" && report?.completed == false
    }

    private func awaitL08HostLanguage(_ action: String, index: Int, expectedBoot: String,
                                     deadline: TimeInterval, remaining: Int,
                                     publish: @escaping () throws -> Void) {
        guard l08HostPending(index, expectedBoot) else { return } // Retire stale work, never touch a new command.
        do {
            guard remaining > 0, ProcessInfo.processInfo.systemUptime <= deadline,
                  let original = beforeMain else { throw fixtureError() }
            if !l08HostLanguageAcknowledged(action, try preferences(), original) {
                guard remaining > 1 else { throw fixtureError() }
                DispatchQueue.main.asyncAfter(deadline: .now() + .milliseconds(25)) { [weak self] in
                    self?.awaitL08HostLanguage(action, index: index, expectedBoot: expectedBoot,
                        deadline: deadline, remaining: remaining - 1, publish: publish)
                }
                return
            }
            try publish()
        } catch { l08HostDisplay = "bounded-receipt-failed" }
    }

    func nextL08HostCommand() {
        precondition(Thread.isMainThread && isL08HostScenario)
        // A busy or failed invocation cannot be retried while its callback/tick retires.
        guard !["running", "invalid-context", "duplicate-callback", "bounded-receipt-failed"]
            .contains(l08HostDisplay) else { return }
        let env = ProcessInfo.processInfo.environment
        guard let number = Int(env["PARLOR_L08_HOST_BOOT"] ?? ""), (1...3).contains(number),
              l08HostIndex < l08HostPlan.count, report?.completed == false else {
            l08HostDisplay = "invalid-context"; return
        }
        let index = l08HostIndex, expectedBoot = boot
        let callback = L08HostCallbackClaim()
        let action = l08HostPlan[l08HostIndex]
        l08HostDisplay = "running"
        MainViewControllerKt.L08HostCommand(action: action) { [weak self] json in
            DispatchQueue.main.async {
                guard let self, self.l08HostPending(index, expectedBoot) else { return }
                guard !callback.received else { self.l08HostDisplay = "duplicate-callback"; return }
                callback.received = true
                do {
                    let raw = Data(json.utf8)
                    guard raw.count <= 8192,
                          let observation = try JSONSerialization.jsonObject(with: raw) as? [String: Any] else {
                        throw self.fixtureError()
                    }
                    let needsAcknowledgement = observation["status"] as? String == "PASS" &&
                        ["language-en", "language-ar", "language-system"].contains(action)
                    let publish: () throws -> Void = { [weak self] in
                        guard let self, self.l08HostPending(index, expectedBoot) else { return }
                        // Exactly one fresh durable sample, after acknowledgement.
                        let beforeOrdinal = self.report?.observations.last?.ordinal ?? 0
                        self.sample()
                        guard let report = self.report, let last = report.observations.last,
                              last.ordinal == beforeOrdinal + 1,
                              last.boot == expectedBoot, last.phase == "sample" else { throw self.fixtureError() }
                        if needsAcknowledgement {
                            guard let original = self.beforeMain,
                                  l08HostLanguageAcknowledged(action, last.preferences, original) else {
                                throw self.fixtureError() // Never substitute another row after this sample.
                            }
                        }
                        let images = try nativeReadinessLoadedImages()
                        let record: [String: Any] = ["schema_version": 1, "scenario": "l08-host",
                            "signing_mode": nativeReadinessSigningMode, "run_token": env["PARLOR_DSC01_RUN_TOKEN"] ?? "",
                            "process_boot": self.boot, "boot_ordinal": number, "action": action,
                            "loaded_app_images": images.app, "loaded_compose_framework": images.framework,
                            "loader_environment": try nativeReadinessLoaderEnvironment(), "observation_sequence": last.ordinal,
                            "observation": observation]
                        let encoded = try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys])
                        guard encoded.count <= 24576 else { throw self.fixtureError() }
                        let url = FileManager.default.temporaryDirectory.appendingPathComponent(
                            "parlor-l08-host-\(number)-\(action).json")
                        guard !FileManager.default.fileExists(atPath: url.path) else { throw self.fixtureError() }
                        try encoded.write(to: url, options: [.withoutOverwriting])
                        self.l08HostIndex += 1
                        self.l08HostDisplay = String(decoding: encoded, as: UTF8.self)
                    }
                    if needsAcknowledgement {
                        self.awaitL08HostLanguage(action, index: index, expectedBoot: expectedBoot,
                            deadline: ProcessInfo.processInfo.systemUptime + 5, remaining: 200, publish: publish)
                    } else {
                        try publish() // Preserve a failed Kotlin result immediately, without an ownership wait.
                    }
                } catch {
                    self.l08HostDisplay = "bounded-receipt-failed"
                }
            }
        }
    }
}

private struct L08HostControls: View {
    @ObservedObject var probe: DSC01Probe
    var body: some View {
        HStack {
            Button("Next host fixture step") { probe.nextL08HostCommand() }
                .accessibilityIdentifier("l08-host-next")
            Text("L08 host result").accessibilityIdentifier("l08-host-result").accessibilityValue(probe.l08HostDisplay)
        }
    }
}
