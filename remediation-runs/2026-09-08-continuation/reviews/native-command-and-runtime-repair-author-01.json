  "findings": [
    {
      "id": "NATIVE_COMMAND_PRIMARY_MASKING",
      "source": "Actual normal Lane.command and mutable companion nested command",
      "evidence": "A17 build row omitted interruption/exit fields; B18 interruption/exit fields present. Both final errors were bounded ps timeouts; root cause and first failing phase are unresolved.",
      "correction": "Record interrupted_or_failed and bounded primary error before unchanged command-role stop. Capture stop or post-stop-poll secondary errors under a separate stage, then bare-raise the original exception instance.",
      "limits": "No ps timeout/backend/cadence changes, no cached process rows, no new signal authorization. Success/nonzero paths and finally timestamp/save unchanged. This corrects error reporting, not the OS root cause."
    },
    {
      "id": "FOUNDATION_PROFILE_GUARD_NOT_PROPAGATED",
      "source": "Source-only finding from /root/l08_fixture, independently confirmed by /root/portability_review",
      "evidence": "25b1 qualified runner selects SDK/runtime26.2 but unchanged template guard and complete-record parser required26.5.0. A17 aborted before Foundation runtime; no false executed success is alleged.",
      "correction": "One shared closed profile authority supplies exact integer26.5.0 or26.2.0. Owned-copy renderer substitutes exactly one native guard and records profile/triple in copy binding. Composed hook passes root-selected profile through preservation, direct parse and collection reparse; copy binding crosschecked against caller selection.",
      "limits": "Original native template/all16 operations/query rows and strict metadata semantics unchanged. Complete record must match one selected exact triple, not either. Original valid CONTROL_ERROR runtime shape retained for failed-observation preservation; incomplete collection never succeeds. No profile fallback in actual Hooks."
    }
  ],
