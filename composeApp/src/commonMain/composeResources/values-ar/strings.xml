    <!-- Runtime permission rationale -->
    <string name="permission_eyebrow">الأجهزة المجاورة</string>
    <string name="permission_denied_eyebrow">الإذن مطلوب</string>
    <string name="permission_permanently_denied_eyebrow">الإذن محجوب</string>
    <string name="permission_title">دع Parlor يعثر على الغرفة</string>
    <string name="permission_body">لاستضافة غرفة لعبة جماعية أو الانضمام إليها، يحتاج Parlor إلى صلاحية الوصول للأجهزة المجاورة على شبكة Wi-Fi لديك. لا يُستخدم موقعك؛ الصلاحية تتيح فقط للهواتف في الغرفة رؤية بعضها.</string>
    <string name="permission_denied_body">لا يزال Parlor عاجزًا عن رؤية الأجهزة المجاورة. امنح الصلاحية لاستضافة غرفة أو الانضمام إليها — يمكنك إلغاؤها في أي وقت.</string>
    <string name="permission_permanently_denied_body">رُفضت الصلاحية مع تفعيل \"لا تسألني مجددًا\". افتح إعدادات تطبيق Parlor، فعّل صلاحية الأجهزة المجاورة (أو الموقع)، ثم عُد إلى هذه الشاشة.</string>
    <string name="permission_grant">السماح بالوصول</string>
    <string name="permission_grant_description">افتح حوار النظام لطلب صلاحية الأجهزة المجاورة.</string>
    <string name="permission_open_settings">فتح إعدادات التطبيق</string>
    <string name="permission_open_settings_description">افتح صفحة الإعدادات الخاصة بـ Parlor لمنح صلاحية الأجهزة المجاورة.</string>
    <string name="permission_continue">منحتُها — تابع</string>
    <string name="permission_continue_description">أعِد فحص الصلاحية وتابع إن مُنحت.</string>
    <string name="permission_back">رجوع</string>
    <string name="permission_back_description">العودة إلى الشاشة الرئيسية دون منح الصلاحية.</string>

