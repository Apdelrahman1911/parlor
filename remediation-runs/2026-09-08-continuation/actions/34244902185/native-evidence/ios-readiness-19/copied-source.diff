+
+    private func scheduleStabilitySample() {
+        // Timed main-queue observations, not Thread.sleep or a busy/main-blocking
+        // loop. No display/@Published assignment occurs between these samples.
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.25) { [weak self] in
+            self?.stabilitySample()
+        }
+    }
+
+    private func stabilitySample() {
+        precondition(Thread.isMainThread && samplingStatus == "running")
+        do {
+            let elapsed = Int((ProcessInfo.processInfo.systemUptime - samplingStarted) * 1000)
+            guard elapsed >= 0 && elapsed <= 10000, samplingRows.count < 6 else { throw fixtureError() }
+            let observation = try appendObservation(phase: "window_sample", publish: false,
+                samplingWindow: samplingOrdinal, samplingIndex: samplingRows.count + 1,
+                samplingElapsedMilliseconds: elapsed, samplingContext: samplingContext)
+            samplingRows.append(observation)
+            if samplingRows.count == 6 {
+                samplingStatus = "complete"
+                // Publish once after all six durable samples. A second complete
+                // window is then collected by XCTest to expose recurring resets
+                // after this SwiftUI invalidation; neither window may be dropped.
+                try publishObservation(observation)
+            } else {
+                scheduleStabilitySample()
+            }
+        } catch {
+            samplingStatus = "failed"
+            display = "{\"harnessError\":\"bounded_sampling_window_failed\"}"
+        }
+    }
+
+    func complete() {
+        precondition(Thread.isMainThread && prepared)
+        do {
+            guard samplingStatus != "running" else { throw fixtureError() }
