.Fl scheme Ar schemename
.Op [ Fl destination Ar destinationspecifier ] No ...
.Op Fl destination-timeout Ar value
.Op Fl configuration Ar configurationname
.Op Fl sdk [ Ar sdkfullpath | Ar sdkname ]
.Op Ar action No ...
