+// Separate functional companion; required Complete failures remain recorded, never a strict L08 PASS.
+extension DSC01Probe {
+    var isL08StorageFunctionalScenario: Bool { scenario == "l08-storage-functional" }
+
+    func startL08StorageFunctional(_ action: String) {
+        precondition(Thread.isMainThread && isL08StorageFunctionalScenario)
+        let environment = ProcessInfo.processInfo.environment
+        guard let number = Int(environment["PARLOR_L08_STORAGE_FUNCTIONAL_BOOT"] ?? ""),
+              (1...13).contains(number),
+              ["save", "load", "continue", "legacy-seed", "legacy-load", "legacy-neighbor",
+               "dual-preserved", "discard-observed", "final-absence"].contains(action), l08Display != "running" else {
+            l08Display = "invalid-context"; return
+        }
+        l08Display = "running"
+        MainViewControllerKt.L08StorageFunctionalCommand(action: action) { [weak self] json in
+            DispatchQueue.main.async {
+                guard let self else { return }
+                do {
+                    let raw = Data(json.utf8)
+                    guard raw.count <= 4096,
+                          let observation = try JSONSerialization.jsonObject(with: raw) as? [String: Any] else {
+                        throw self.fixtureError()
+                    }
+                    let images = try nativeReadinessLoadedImages()
+                    let record: [String: Any] = ["schema_version": 1, "scenario": "l08-storage-functional",
+                        "signing_mode": nativeReadinessSigningMode, "run_token": environment["PARLOR_DSC01_RUN_TOKEN"] ?? "",
+                        "process_boot": self.boot, "boot_ordinal": number, "action": action,
+                        "loaded_app_images": images.app, "loaded_compose_framework": images.framework,
+                        "loader_environment": try nativeReadinessLoaderEnvironment(), "observation": observation]
+                    let encoded = try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys])
+                    guard encoded.count <= 16384 else { throw self.fixtureError() }
+                    let url = FileManager.default.temporaryDirectory.appendingPathComponent(
+                        "parlor-l08-storage-functional-\(number)-\(action).json")
+                    guard !FileManager.default.fileExists(atPath: url.path) else { throw self.fixtureError() }
+                    try encoded.write(to: url, options: [.withoutOverwriting])
+                    self.l08Display = String(decoding: encoded, as: UTF8.self)
+                } catch {
+                    self.l08Display = "bounded-receipt-failed"
+                }
+            }
+        }
+    }
+
+    func sampleL08Ui() { l08UiDisplay = MainViewControllerKt.L08UiObservation() }
+}
+
+private struct L08StorageFunctionalControls: View {
+    @ObservedObject var probe: DSC01Probe
+    var body: some View {
+        VStack(spacing: 4) {
+            HStack {
+                Button("Save fixture") { probe.startL08StorageFunctional("save") }.accessibilityIdentifier("l08-functional-action-save")
+                Button("Read checkpoint") { probe.startL08StorageFunctional("load") }.accessibilityIdentifier("l08-functional-action-load")
+                Button("Continue fixture") { probe.startL08StorageFunctional("continue") }.accessibilityIdentifier("l08-functional-action-continue")
+            }
+            HStack {
+                Button("Seed legacy") { probe.startL08StorageFunctional("legacy-seed") }.accessibilityIdentifier("l08-functional-action-legacy-seed")
+                Button("Migrate legacy") { probe.startL08StorageFunctional("legacy-load") }.accessibilityIdentifier("l08-functional-action-legacy-load")
+                Button("Read damaged") { probe.startL08StorageFunctional("legacy-neighbor") }.accessibilityIdentifier("l08-functional-action-legacy-neighbor")
+            }
+            HStack {
+                Button("Read retained") { probe.startL08StorageFunctional("dual-preserved") }.accessibilityIdentifier("l08-functional-action-dual-preserved")
+                Button("Check discard") { probe.startL08StorageFunctional("discard-observed") }.accessibilityIdentifier("l08-functional-action-discard-observed")
+                Button("Check absence") { probe.startL08StorageFunctional("final-absence") }.accessibilityIdentifier("l08-functional-action-final-absence")
+            }
+            Text("L08 result").accessibilityIdentifier("l08-storage-functional-result").accessibilityValue(probe.l08Display)
+            Button("Observe L08 UI") { probe.sampleL08Ui() }.accessibilityIdentifier("l08-ui-observe")
+            Text("L08 UI result").accessibilityIdentifier("l08-ui-result").accessibilityValue(probe.l08UiDisplay)
+        }
+    }
+}
