+private fun protectionIdentity(path: String, target: String): JsonObject = memScoped {
+    val value = alloc<stat>()
+    check(lstat(path, value.ptr) == 0)
+    val type = value.st_mode.toInt() and S_IFMT.toInt()
+    check(value.st_uid == getuid())
+    check(type == if (target == "directory") S_IFDIR.toInt() else S_IFREG.toInt())
+    check(target == "directory" || value.st_nlink.toLong() == 1L)
+    buildJsonObject {
+        put("device", value.st_dev.toLong())
+        put("inode", value.st_ino.toLong())
+        put("uid", value.st_uid.toLong())
+        put("file_type", type)
+        put("links", value.st_nlink.toLong())
+        put("bytes", value.st_size)
+    }
+}
