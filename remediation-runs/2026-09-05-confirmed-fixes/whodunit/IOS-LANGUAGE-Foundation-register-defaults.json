      "parameters": [
        {
          "content": [
            {
              "inlineContent": [
                {
                  "text": "The dictionary of key-value pairs that contain the",
                  "type": "text"
                },
                {
                  "text": " ",
                  "type": "text"
                },
                {
                  "text": "default values for your app\u2019s settings. Build this dictionary programmatically",
                  "type": "text"
                },
                {
                  "text": " ",
                  "type": "text"
                },
                {
                  "text": "or load it from a property list resource file in your app\u2019s bundle.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "registrationDictionary"
        }
      ]
    },
    {
      "kind": "mentions",
      "mentions": [
        "doc://com.apple.foundation/documentation/Foundation/accessing-settings-from-your-code"
      ]
    },
    {
      "content": [
        {
          "anchor": "discussion",
          "level": 2,
          "text": "Discussion",
          "type": "heading"
        },
        {
          "inlineContent": [
            {
              "text": "Call this method shortly after launch to specify the default values for your app\u2019s",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "settings. This method assigns the key-value pairs you provide to the registration",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "domain, which is typically the last domain in the search list. The registration domain",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "is volatile, so you must register the set of default values each time your app launches.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        }
      ],
      "kind": "content"
    }
  ],
