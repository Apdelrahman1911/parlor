    <!-- Runtime permission rationale -->
    <string name="permission_eyebrow">الشبكة المحلية</string>
    <string name="permission_denied_eyebrow">تحقّق من الشبكة المحلية</string>
    <string name="permission_permanently_denied_eyebrow">الشبكة المحلية محجوبة</string>
    <string name="permission_title">دع Parlor يعثر على الغرفة</string>
    <string name="permission_body">يستخدم Parlor شبكة Wi-Fi المحلية وBonjour لاستضافة غرف اللعب الجماعي أو العثور عليها. على iPhone قد يطلب النظام إذن الشبكة المحلية عند بدء خطوة الشبكة التالية. لا يستخدم Parlor موقعك.</string>
    <string name="permission_denied_body">تعذّر على Parlor استخدام الشبكة المحلية، لكن iOS لم يحدد إن كان الوصول مرفوضًا أم الشبكة غير متاحة. تحقّق من Wi-Fi وإعداد الشبكة المحلية لـ Parlor ثم أعد المحاولة.</string>
    <string name="permission_permanently_denied_body">الوصول إلى الشبكة المحلية محجوب. افتح إعدادات Parlor وفعّل الشبكة المحلية، ثم عُد وأعد المحاولة.</string>
    <string name="permission_open_settings">فتح إعدادات التطبيق</string>
    <string name="permission_open_settings_description">افتح صفحة إعدادات Parlor لمراجعة صلاحية الشبكة المحلية.</string>
    <string name="permission_continue">متابعة</string>
    <string name="permission_continue_description">تابع وأعد تنفيذ عملية الشبكة المحلية الفعلية.</string>
    <string name="permission_back">رجوع</string>
    <string name="permission_back_description">العودة إلى الشاشة الرئيسية دون بدء الاتصال بالشبكة.</string>
    <string name="network_recovery_help">تعذّر على Parlor تأكيد الوصول إلى الشبكة المحلية. تحقّق من Wi-Fi، وعلى iPhone تحقّق من إعداد الشبكة المحلية لـ Parlor. قد يكون السبب أيضًا التوجيه أو Bonjour أو عدم توفر المضيف.</string>
    <string name="network_retry">إعادة المحاولة</string>
