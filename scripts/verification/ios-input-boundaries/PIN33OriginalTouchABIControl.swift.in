    @objc(touchesBegan:withEvent:) dynamic func touchesBegan(_ input: AnyObject, withEvent event: AnyObject?) { PIN33Parent.parentTouchCalls += 1 }
    @objc(touchesMoved:withEvent:) dynamic func touchesMoved(_ input: AnyObject, withEvent event: AnyObject?) { }
    @objc(touchesEnded:withEvent:) dynamic func touchesEnded(_ input: AnyObject, withEvent event: AnyObject?) { }
    @objc(touchesCancelled:withEvent:) dynamic func touchesCancelled(_ input: AnyObject, withEvent event: AnyObject?) { }
