<resources>
    <string name="session_exit_affordance">مغادرة</string>
    <string name="session_exit_affordance_description">فتح خيارات مغادرة اللعبة.</string>
    <string name="session_exit_stay">البقاء في اللعبة</string>
    <string name="session_exit_stay_description">إغلاق خيارات المغادرة ومتابعة اللعب.</string>
    <string name="session_exit_local_title">العودة إلى الصفحة الرئيسية؟</string>
    <string name="session_exit_local_body">سنحفظ أحدث حالة للعبة قبل عودتك إلى الصفحة الرئيسية، ويمكنك استئنافها لاحقًا.</string>
    <string name="session_exit_local_confirm">الحفظ والعودة إلى الرئيسية</string>
    <string name="session_exit_local_confirm_description">حفظ هذه اللعبة والعودة إلى الشاشة الرئيسية.</string>
    <string name="session_exit_host_title">إنهاء الغرفة؟</string>
    <string name="session_exit_host_body">مغادرتك بصفتك المضيف تنهي هذه الغرفة للجميع، ولا يمكن استئناف جلسة اللعب الجماعي هذه.</string>
    <string name="session_exit_host_confirm">إنهاء الغرفة والمغادرة</string>
    <string name="session_exit_host_confirm_description">إنهاء غرفة اللعب الجماعي للجميع والعودة إلى الصفحة الرئيسية.</string>
    <string name="session_exit_peer_title">مغادرة هذه الغرفة؟</string>
    <string name="session_exit_peer_body">ستُحذف عضويتك وبيانات إعادة الانضمام نهائيًا، ولن تتمكن من العودة إلى هذه الجلسة بعد المغادرة.</string>
    <string name="session_exit_peer_confirm">مغادرة الغرفة</string>
    <string name="session_exit_peer_confirm_description">مغادرة غرفة اللعب الجماعي نهائيًا والعودة إلى الصفحة الرئيسية.</string>
</resources>
