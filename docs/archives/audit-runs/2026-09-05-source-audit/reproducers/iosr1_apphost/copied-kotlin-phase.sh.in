#!/bin/sh
# COPY-ONLY Xcode build phase. Not a production change or standalone runner.
# Root substitutes these three public paths and independently reviews the result.
set -u
cd "__PARLOR_SOURCE_ROOT__" || exit 1

./gradlew --no-daemon :composeApp:embedAndSignAppleFrameworkForXcode \
  --dependency-verification=strict --console=plain --no-configuration-cache \
  --no-parallel --max-workers=1 --no-build-cache \
  -I "__PARLOR_IOSR1_INIT_SCRIPT__"
build_status=$?
# Stop immediately while retaining the required framework for Swift link/runtime.
./gradlew --stop
stop_status=$?
if [ "$build_status" -ne 0 ]; then exit "$build_status"; fi
if [ "$stop_status" -ne 0 ]; then exit "$stop_status"; fi
"__PARLOR_SOURCE_ROOT__/scripts/release/normalize_embedded_apple_framework.sh" \
  "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}" ComposeApp
