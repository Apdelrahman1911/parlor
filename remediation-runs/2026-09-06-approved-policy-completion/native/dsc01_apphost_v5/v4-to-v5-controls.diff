+        let window = try dictionary(final, "sampling")
+        XCTAssertEqual(window["ordinal"] as? Int, ordinal + 1)
+        XCTAssertEqual(window["status"] as? String, "complete")
+        let snapshots = try XCTUnwrap(window["samples"] as? [[String: Any]])
+        XCTAssertEqual(snapshots.count, 6)
+        var previousElapsed = 0
+        for (index, snapshot) in snapshots.enumerated() {
+            XCTAssertEqual(snapshot["index"] as? Int, index + 1)
