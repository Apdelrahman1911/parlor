+private func nativeReadinessFrameworkUUID(_ index: UInt32) throws -> String {
+    guard let header = _dyld_get_image_header(index), header.pointee.magic == MH_MAGIC_64 else {
+        throw nativeReadinessImageError(2)
+    }
+    let raw = UnsafeRawPointer(header)
+    let loaded = raw.load(as: mach_header_64.self)
+    let headerBytes = MemoryLayout<mach_header_64>.size
+    guard loaded.filetype == MH_DYLIB, loaded.cputype == CPU_TYPE_ARM64,
+          loaded.ncmds > 0, loaded.ncmds <= 4096, loaded.sizeofcmds <= 4 * 1024 * 1024,
+          loaded.ncmds <= loaded.sizeofcmds / 8 else { throw nativeReadinessImageError(3) }
+    var cursor = headerBytes
+    let end = headerBytes + Int(loaded.sizeofcmds)
+    var observed: String?
+    for _ in 0..<loaded.ncmds {
+        guard cursor + MemoryLayout<load_command>.size <= end else { throw nativeReadinessImageError(4) }
+        let command = raw.advanced(by: cursor).load(as: load_command.self)
+        let length = Int(command.cmdsize)
+        guard length >= 8, length % 8 == 0, cursor + length <= end else { throw nativeReadinessImageError(5) }
+        if command.cmd == LC_UUID {
+            guard observed == nil, length == MemoryLayout<uuid_command>.size else { throw nativeReadinessImageError(6) }
+            observed = UUID(uuid: raw.advanced(by: cursor).load(as: uuid_command.self).uuid).uuidString.lowercased()
+        }
+        cursor += length
+    }
+    guard cursor == end, let observed else { throw nativeReadinessImageError(7) }
+    return observed
+}
