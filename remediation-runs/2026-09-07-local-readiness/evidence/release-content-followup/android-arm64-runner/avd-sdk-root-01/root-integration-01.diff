+    if sha256(source) != before or sha256(destination) == before:
+        raise RuntimeError("Native clone mutation changed its source")
+    return {"status": "PASS", "method": "real fclonefileat", "independent_inodes": True,
+            "clone_mutation_preserved_source": True, "source_sha256": before}
 
 
