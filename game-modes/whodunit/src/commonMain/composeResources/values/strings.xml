    <string name="setup_mode_classic_body">Investigate the full case. One vote at the end. Best for story and deduction.</string>
    <string name="setup_mode_classic_meta">25–35 min  ·  %1$d–%2$d players</string>
    <string name="setup_mode_elimination_title">Elimination</string>
    <string name="setup_mode_elimination_body">Vote after every round. Find the killer before they survive. Best for fast, tense games.</string>
    <string name="setup_mode_elimination_meta">15–25 min  ·  %1$d–%2$d players</string>
    <string name="setup_mode_choose_format">Choose %1$s</string>
    <string name="setup_mode_choose_description_format">Choose %1$s mode and proceed to player setup.</string>
    <string name="setup_back">Back</string>
    <string name="setup_back_description">Return to the previous setup step.</string>

    <!-- Setup: player count -->
    <string name="setup_player_count_eyebrow">HOW MANY PLAYERS</string>
    <string name="setup_player_count_headline">Tap a number.</string>
