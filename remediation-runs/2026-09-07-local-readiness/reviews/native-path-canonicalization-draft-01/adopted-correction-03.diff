+// Synthetic host-Foundation controls only. No dyld/runtime-app or device claim.
+// Python prepends the EXACT production-copy helpers and loader observer.
+private let fixtureRoot = __PARLOR_PATH_FIXTURE_ROOT__
+private let nativeReadinessTaskRoot = fixtureRoot + "/allocation"
+
+private let productRoot = nativeReadinessTaskRoot + "/copy/composeApp/build"
+private let appRoot = fixtureRoot + "/installed/Parlor.app"
+private let productRelative = "xcode-frameworks/Debug/iphonesimulator26.5/ComposeApp.framework/ComposeApp"
+private let productImage = productRoot + "/" + productRelative
+private let appRelative = "Frameworks/ComposeApp.framework/ComposeApp"
+private let appImage = appRoot + "/" + appRelative
+private var passed = [String]()
+private var currentCase = "context"
+private var fingerprintCalls = 0
+
+private func check(_ condition: Bool) throws {
+    guard condition else { throw NSError(domain: "NativePathControl", code: 1) }
+}
+
+private func runCase(_ name: String, _ action: () throws -> Void) throws {
+    currentCase = name
+    try check(!passed.contains(name))
+    try action()
+    passed.append(name)
+}
+
+private func ownedError(_ expected: Int, _ action: () throws -> Void) throws {
+    do {
+        try action()
+    } catch {
+        let value = error as NSError
+        try check(value.domain == "NativeReadinessOwnedImage" && value.code == expected)
+        return
+    }
+    throw NSError(domain: "NativePathControl", code: 2)
+}
+
+private func canonical(_ raw: String) throws -> String {
+    guard let path = try nativeReadinessCanonicalDyldPath(raw) else {
+        throw NSError(domain: "NativePathControl", code: 3)
+    }
+    return path
+}
+
+private func inspect(_ raw: String) throws -> (origin: String, path: String, bytes: Int, sha256: String) {
+    try nativeReadinessInspectFramework(canonical(raw), appRoot: appRoot, productRoot: productRoot) { url in
+        fingerprintCalls += 1
+        // The test callback deliberately never opens content. It proves the
+        // actual helper's ownership decision occurs BEFORE invoking a reader.
+        try check(url.path.hasPrefix(productRoot + "/") || url.path == appImage)
+        return (7, "synthetic-no-content-read")
+    }
+}
+
+private func withoutPrivate(_ path: String) throws -> String {
+    try check(path.hasPrefix("/private/var/"))
+    return String(path.dropFirst("/private".count))
+}
