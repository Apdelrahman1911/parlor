+private func nativeReadinessFrameworkFingerprint(_ url: URL) throws -> (bytes: Int, sha256: String) {
+    // Only called after exact app/task-owned framework origin validation. Read
+    // in bounded chunks; never inspect credentials, data files or other images.
+    let handle = try FileHandle(forReadingFrom: url)
+    defer { try? handle.close() }
+    var digest = CryptoKit.SHA256()
+    var bytes = 0
+    while let data = try handle.read(upToCount: 1024 * 1024), !data.isEmpty {
+        bytes += data.count
+        guard bytes <= 512 * 1024 * 1024 else { throw nativeReadinessImageError(18) }
+        digest.update(data: data)
+    }
+    guard bytes > 0 else { throw nativeReadinessImageError(19) }
+    return (bytes, digest.finalize().map { String(format: "%02x", $0) }.joined())
+}
